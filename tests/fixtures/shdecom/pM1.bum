<org.eventb.core.guard name="_niTOMQk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="@g3 nb ∈ dom(recvNbrFlg) ∧ recvNbrFlg(nb) = FALSE" org.eventb.core.label="MReceive_dest_receive_pkt_g2" org.eventb.core.predicate="nb ↦ pkt ∈ recvBuff"/>
