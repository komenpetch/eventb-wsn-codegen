<org.eventb.core.guard name="_niTOOgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_finish_tx_pkt_g1" org.eventb.core.predicate="x ∈ ND ∧ pkt ∈ PKT"/>
<org.eventb.core.guard name="_niTOOwk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_finish_tx_pkt_g2" org.eventb.core.predicate="{pkt} ◁ctlNeighbours = ∅"/>
<org.eventb.core.guard name="_niTOPAk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_finish_tx_pkt_g3" org.eventb.core.predicate="pkt ∈  ran(sentUp) ∧ pkt ∉ ran(sentDown)"/>
<org.eventb.core.guard name="_niTOPQk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_finish_tx_pkt_g4" org.eventb.core.predicate="x ∈ dom(sentUp)"/>
<org.eventb.core.guard name="_niTOPgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_finish_tx_pkt_g5" org.eventb.core.predicate="x ↦ pkt ∈ sentUp"/>
<org.eventb.core.guard name="_niTOPwk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MNDBuffer_is_In_Range_ndBuff_g1" org.eventb.core.predicate="pkt ∈ ran(ndBuff)"/>
<org.eventb.core.action name="_niTOQAk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="sentUp ≔ sentUp  ∖ {x↦pkt}" org.eventb.core.label="MSend_finish_tx_pkt_a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_niTOQQk_EeWZ6ayKi1-Bfw" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="final_tx_pkt">
