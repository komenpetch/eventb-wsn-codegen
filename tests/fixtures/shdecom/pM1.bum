<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1433264054467" org.eventb.texttools.text_representation="machine pM1 sees cM1&#10;&#10;variables&#10;          pktFwdr // fowarder attached in transmitted packet&#10;          pktData // (ctl) data attached in transmitted packet&#10;          createdPkts // created packets&#10;          ndBuff // nodes' recvBuff&#10;          sentDown // transmitted packet to channel&#10;          sentUp // transmitted packet up to channel&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          destBuff //destination's buffers&#10;          recvBuff&#10;          clrRecvBuffFlg&#10;&#10;&#10;invariants&#10;  @MPacket_inv_1 pktFwdr ∈ PKT ⇸  ND&#10;  @MPacket_inv_2 pktData ∈  PKT  ⇸ ℤ&#10;  @MPacket_inv_3 createdPkts ⊆ PKT&#10;  @MNDBuffer_inv_1 ndBuff ∈ ND ↔PKT&#10;  @MSend_inv_1 sentUp  ∈ ND ↔PKT&#10;  @MSend_inv_2 sentDown  ∈ ND ↔PKT&#10;  @MSend_inv_3 ctlNeighbours ∈ PKT ↔ ND&#10;  @MDestBuffer_inv_1 destBuff ∈ Dests ↔PKT&#10;  @MReceive_inv_1 recvBuff ∈ ND ↔PKT&#10;  @MReceive_inv_2 clrRecvBuffFlg ∈ ND ↔PKT&#10;&#10;events&#10;  event INITIALISATION&#10;    then&#10;       @MPacket_int_1 pktFwdr ≔ ∅&#10;       @MPacket_int_2 pktData ≔ ∅&#10;       @MPacket_int_3 createdPkts ≔ ∅&#10;      @MNDBuffer_int_1 ndBuff ≔ ∅&#10;      @MSend_int_1 sentUp≔ ∅&#10;      @MSend_int_2 sentDown≔ ∅&#10;      @MSend_int_3 ctlNeighbours ≔ ∅&#10;      @MDestBuffer_int_1 destBuff ≔ ∅&#10;      @MReceive_int_1 recvBuff ≔ ∅&#10;      @MReceive_int_2 clrRecvBuffFlg ≔ ∅&#10;  end&#10;&#10;&#10;  event creatingPkt&#10;    any x des pkt   data&#10;    where&#10;      @MPacket_creating_pkt_g1  x ∈ ND ∖Dests ∧ pkt ∈ PKT ∧ data ∈ ℤ&#10;      @MPacket_creating_pkt_g2 x = initialSrcAddr(pkt) ∧  des = ran({pkt} ◁ finalDestAddr)&#10;      @MPacket_creating_pkt_g3   pkt ∉ dom(pktFwdr)&#10;      @MPacket_creating_pkt_g4  pkt  ∉ dom(pktData)&#10;      @MNDbuffMgt_record_ndBuff_g1  x  ↦ pkt ∉ ndBuff&#10;    then&#10;      @MPacket_creating_pkt_a1  createdPkts≔ createdPkts ∪ {pkt}&#10;      @MPacket_creating_pkt_a2 pktFwdr ≔ pktFwdr ∪ {pkt ↦ x}&#10;      @MPacket_creating_pkt_a3 pktData ≔ pktData ∪ {pkt ↦ data}&#10;      @MNDbuffMgt_record_ndBuff_a1 ndBuff ≔ ndBuff  ∪ {x ↦ pkt}&#10;  end&#10;&#10;  event start_tx&#10;    any x pkt&#10;    where&#10;      @MSend_start_tx_g1 x ∈ ND ∧ pkt ∈ PKT&#10;      @MSend_start_tx_g2 x ↦ pkt ∉ sentDown // but has not tranmitted to WiMedium&#10;      @MSend_start_tx_g3 x ↦ pkt ∉ sentUp // but has not tranmitted to WiMedium&#10;      @MPacket_set_pktFwdr_g1 pkt ∈ dom(pktFwdr)&#10;      @MNDBuffer_remove_ndBuff_g1 x ↦ pkt ∈   ndBuff&#10;    then&#10;      @MISend_start_tx_a1 sentDown ≔ sentDown  ∪  {x ↦ pkt}&#10;      @MPacket_set_pktFwdr_a2 pktFwdr ≔pktFwdr  {pkt↦x}&#10;      @MNDBuffer_remove_ndBuff_a1 ndBuff ≔ ndBuff ∖{x↦pkt}&#10;  end&#10;&#10;  event send_down&#10;    any x pkt&#10;    where&#10;      @MSend_send_down_g1 x ∈ ND ∧ pkt ∈ PKT&#10;      @MSend_send_down_g2 x ↦ pkt ∈ sentDown&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;    any x pkt nbrs&#10;    where&#10;      @MSend_sent_up_g1 x ∈ ND ∧ pkt ∈ PKT&#10;      @MSend_sent_up_g2 x ↦ pkt  ∉ sentUp // ready to put current pkt from sentUp&#10;      @MSend_sent_up_g3 x ↦ pkt   ∈ sentDown&#10;      @MSend_sent_up_g4 pkt ∉ dom(ctlNeighbours)&#10;      @MSend_sent_up_g5 nbrs ∈ {n∣ n ∈ ℙ(ND)} ∧ nbrs ≠ ∅&#10;    then&#10;      @MSend_sent_up_a1 ctlNeighbours ≔ ctlNeighbours ∪({pkt}× nbrs)&#10;      @MSend_sent_up_a2 sentDown ≔ sentDown  ∖ {x ↦ pkt}&#10;      @MSend_sent_up_a3 sentUp ≔ sentUp ∪ {x↦ pkt  }&#10;  end&#10;&#10;event receive&#10;    any nb pkt&#10;    where&#10;      @MReceive_receive_g1 nb ∈ ND ∧ pkt ∈ PKT&#10;      @MReceive_receive_g2 nb ↦ pkt ∉  recvBuff&#10;      @MSend_remove_ctlNeighbour_g1 nb ↦ pkt ∉ sentUp&#10;      @MSend_remove_ctlNeighbour_g2  nb ↦ pkt ∉ sentDown&#10;    then&#10;      @MReceive_receive_a1 recvBuff ≔ recvBuff ∪ {nb ↦pkt}&#10;      @MSend_remove_ctlNeighbour_a1 ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}&#10;  end&#10;&#10;event clear_recvdBuff&#10;any nb pkt&#10;where&#10;    @MReceive_clear_recvdBuff_g1 nb ∈ ND ∧ pkt ∈ PKT&#10;    @MReceive_clear_recvdBuff_g2 nb ↦ pkt ∈  recvBuff&#10;    @MReceive_clear_recvdBuff_g3 nb ↦ pkt ∈ clrRecvBuffFlg&#10;then&#10;   @MReceive_clear_recvdBuff_a1 recvBuff ≔ recvBuff ∖ {nb ↦pkt}&#10;end&#10;&#10;&#10;event fwdr_receive_pkt&#10;    any nb pkt&#10;    where&#10;      @MReceive_fwdr_receive_pkt_g1 nb ∈ ND ∧ pkt ∈ PKT&#10;      @MReceive_fwdr_receive_pkt_g2 nb ↦ pkt ∈ recvBuff&#10;      @MReceive_fwdr_receive_pkt_g3 nb ↦ pkt ∉   clrRecvBuffFlg&#10;      @MReceive_fwdr_receive_pkt_g4 nb ∉ Dests&#10;      @MNDBuffer_record_ndBuff_g1 nb ↦ pkt ∉   ndBuff&#10;    then&#10;      @MReceive_fwdr_receive_pkt_a1 clrRecvBuffFlg ≔ clrRecvBuffFlg ∪ {nb ↦pkt}&#10;      @MNDBuffer_record_ndBuff_a1 ndBuff ≔ ndBuff ∪ {nb ↦pkt}&#10;  end&#10;&#10;event dest_recv_pkt&#10;    any nb pkt&#10;    where&#10;      @MReceive_dest_receive_pkt_g1 nb ∈ ND ∧ pkt ∈ PKT&#10;      @MReceive_dest_receive_pkt_g2 nb ↦ pkt ∈ recvBuff // @g3 nb ∈ dom(recvNbrFlg) ∧ recvNbrFlg(nb) = FALSE&#10;      @MReceive_dest_receive_pkt_g3 nb ∈ Dests&#10;      @MReceive_dest_receive_pkt_g4 nb ↦ pkt ∉   clrRecvBuffFlg&#10;      @MDestBuffer_record_destBuff_g1 nb ↦ pkt   ∉  destBuff&#10;    then&#10;      @MDestBuffer_ndBuff_a1 destBuff ≔ destBuff ∪ {nb ↦ pkt}&#10;     @MDestBuffer_record_destBuff_a1 clrRecvBuffFlg ≔ clrRecvBuffFlg ∪ {nb ↦pkt}&#10;  end&#10;&#10;event finish_tx_pkt&#10;    any x pkt&#10;    where&#10;      @MSend_finish_tx_pkt_g1 x ∈ ND ∧ pkt ∈ PKT&#10;      @MSend_finish_tx_pkt_g2 {pkt} ◁ctlNeighbours = ∅&#10;      @MSend_finish_tx_pkt_g3 pkt ∈  ran(sentUp) ∧ pkt ∉ ran(sentDown)&#10;      @MSend_finish_tx_pkt_g4 x ∈ dom(sentUp)&#10;      @MSend_finish_tx_pkt_g5 x ↦ pkt ∈ sentUp&#10;      @MNDBuffer_is_In_Range_ndBuff_g1 pkt ∈ ran(ndBuff)&#10;    then&#10;      @MSend_finish_tx_pkt_a1 sentUp ≔ sentUp  ∖ {x↦pkt}&#10;  end&#10;&#10;  event final_tx_pkt&#10;    any pkt&#10;    where&#10;      @MSend_final_tx_pkt_g1  pkt ∈ PKT&#10;      @MSend_final_tx_pkt_g2 {pkt} ◁ctlNeighbours = ∅&#10;      @MSend_final_tx_pkt_g3 pkt ∈  ran(sentUp) ∧ pkt ∉ ran(sentDown)&#10;      @MNDBuffer_isNot_In_Range_ndBuff_g1  pkt ∉ ran(ndBuff)&#10;    then&#10;      @MSend_final_tx_pkt_a1 sentUp ≔ sentUp  ⩥ {pkt}&#10;  end&#10;&#10;&#10;&#10;end&#10;" version="5">
<org.eventb.core.seesContext name="_niA6UAk_EeWZ6ayKi1-Bfw" org.eventb.core.target="cM1"/>
