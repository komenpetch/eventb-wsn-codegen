<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1445967365519" org.eventb.texttools.text_representation="machine M5 refines M4  sees T01&#10;&#10;variables sinkBuff // (ctl) a sink buffer&#10;          ndBuff // (ctl) nodes' waiting buffer&#10;          sensingNDs // (ctl) sensing nodes&#10;          sensedPkts // (ctl) sensed packets&#10;          senseBuff // (ctl) sense ndBuff&#10;          floodedPkts // (ctl) flooded packets&#10;          floodTbl // (ctl) historical received packet used for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // (ctl) record lost packet at each nodd&#10;          envSensedFlg // (env) sensing period&#10;          envData // (env) environmental/conditional data&#10;          ctlSensedFlg // (ctl)sensing period&#10;          sentDown // (ctl) transmitted packet to channel ------------------------- var of M2&#10;          sentUp // (ctl) transmitted packet up to channel&#10;          channel // (env) channel&#10;          envNeighbours // (env) neighbour list&#10;          wsnLinks // (env) dynamic WSN links&#10;          floodFlg // (ctl) flood flag&#10;          dataSeqNo // (ctl) local nodes' current data sequence number at application layer&#10;          floodSeqNo // (ctl) local nodes' current  broadcast sequence number at application layer&#10;          nbHops // (ctl) neighbour's hop count&#10;          crashedLinks // (env) cashed WSN Links&#10;          pktSrc // (ctl) src address attached in transmitted packet&#10;          pktSeqNo // (ctl) sequence number attached in transmitted packet&#10;          pktFwdr // (ctl) fowarder attached in transmitted packet&#10;          pktData // (ctl) data attached in transmitted packet&#10;          pktNbHops // (ctl) hop count attached in transmitted packet&#10;          vPktSeqNo // (env) virtual packet at channel&#10;          vPktSrc // (env) virtual packet at channel&#10;          vPktFwdr // (env) virtual packet at channel&#10;          vPktData // (env) virtual packet at channel&#10;          vPktNbHops // (env) virtual packet at chennel&#10;          totalSentBcon // (ctl) number of sent flood packets, used for cost-estimation ------------------------- var of M3&#10;          netSeqNo // (ctl) link sequence number in a packet, used for cost-estimation&#10;          linkSeqNo // (ctl) link sequence number of each node&#10;          updateNbrs // (ctl) for updating neighbours in the neighbour table&#10;          neighbourTbl // (ctl) neighbour table structure&#10;          missed // (ctl) neighbour table: field missed (number of lost packets)&#10;          received // (ctl) neighbour table: field received (number of received packets)&#10;          lastSeqno // (ctl) neighbour table: field lastSeqno in neighbour table&#10;          receiveEst // (ctl) neighbour table: field receiveEst (reception link quality)&#10;          estNDs // (ctl) estimation nodes&#10;          estNbrs // (ctl) estimation neighbours&#10;          bcastRouTimer // (ctl) broadcast route timer ------------------------- var of M4&#10;          bcastRouNodes // (ctl) route broadcast nodes&#10;          routeSeqNo // (ctl) sequence number for route packet at each node&#10;          sentEst // (ctl) neighbour table: field sentEst (transmission quality) in neighbour table&#10;          liveliness // (ctl) neighbour table: field liveliness in neighbour table&#10;          checkedLiveNbrs // (ctl) checked liveliness nodes&#10;          chooseParentTimer // (ctl) choose parent timer ------------------------- var of M5&#10;          nodes // (ctl) nodes in the route tree&#10;          completedRoute // (ctl) completed route flag&#10;          cpCost // (ctl) current parent cost&#10;          cRouteTree // (ctl) the current route tree&#10;          calPCostNDs // (ctl) for calculated cost nodes&#10;          calPCost // (ctl) calculated cost for finding min&#10;          pktDestAddr // (ctl) packet field destination addr for channel&#10;          vPktDestAddr // (env) packet field destination addr for channel&#10;          calPCostFlg // (ctl) calculated path cost&#10;          parent // (ctl) neighbour table: parent of neighbour&#10;          cost // (ctl) neighbour table: path cost&#10;          deadNbrs // (ctl) dead neighbours&#10;          chosenNDs // (ctl) chosen nodes for identifying a parent&#10;          Nbrs // (ctl) list of neighbours&#10;&#10;&#10;invariants&#10;  @inv5_1 chooseParentTimer ∈ BOOL&#10;  @inv5_21 nodes ⊆ ND&#10;  @inv5_22 cRouteTree ∈ (nodes ∖ {Sink})→ nodes&#10;  @inv5_3 Nbrs ⊆ ND&#10;  @inv5_4 completedRoute ∈ BOOL&#10;  @inv5_6 cpCost ∈ ND → (ℕ ∪ {INFINITY})&#10;  @inv5_7 calPCostNDs ∈ ND  ↔ ND&#10;  @inv5_8 calPCost ∈ calPCostNDs → ℕ&#10;  @inv5_9 vPktDestAddr ∈ PKT ⇸ (ND ∪  {BROADCAST})&#10;  @inv5_10 calPCostFlg ∈ BOOL&#10;  @inv5_11 pktDestAddr ∈  PKT ⇸ (ND ∪  {BROADCAST})&#10;  @inv5_12 parent ∈ neighbourTbl →  (ND ∪  {BROADCAST})&#10;  @inv5_13 cost ∈ neighbourTbl →ℕ&#10;  @inv5_14 deadNbrs ⊆ ND // @inv5_15 chooseParentFlg ∈ ND ∖ {Sink} → BOOL // @saf5_101 completedRoute = TRUE ⇒ dom(cRouteTree) = ND ∖ {Sink} // the route tree structure&#10;  @inv5_16 chosenNDs ⊆ ND ∖ {Sink}&#10;  /* @saf5_102 ∀S · S ⊆  cRouteTree∼[S] ⇒ S = ∅&#10;     @saf5_103 completedRoute = TRUE ⇒ nodes = ND&#10;     theorem @mth1 ∀T·(Sink∈T ∧ cRouteTree∼[T] ⊆ T ⇒   nodes ⊆ T) // help to prove @mth3&#10;     theorem @mth2 nodes ⊆ {Sink} ∪ (tcl(cRouteTree))∼[{Sink}] // help to prove @mth3&#10;     theorem @mth3 nodes ∖ {Sink} ⊆ (tcl(cRouteTree))∼[{Sink}] // reachability property */&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @int5_1 chooseParentTimer ≔ FALSE&#10;      @int5_21 nodes ≔ {Sink}&#10;      @int5_22 cRouteTree ≔ ∅&#10;      @int5_3 Nbrs≔ ∅&#10;      @int5_4 completedRoute ≔ FALSE&#10;      @int5_6 cpCost ≔ ((ND∖{Sink}) × {INFINITY}) ∪ {Sink ↦ 0}&#10;      @int5_8 calPCostNDs ≔ ∅&#10;      @int5_9 calPCost ≔ ∅&#10;      @int5_11 pktDestAddr ≔ ∅&#10;      @int5_12 vPktDestAddr ≔ ∅&#10;      @int5_16 calPCostFlg ≔ FALSE&#10;      @int5_19 deadNbrs ≔ ∅&#10;      @int5_23 parent ≔ ∅&#10;      @int5_24 cost ≔ ∅ // @int5_25 chooseParentFlg ≔((ND∖{Sink}) × {FALSE})&#10;      @int5_26 chosenNDs ≔ ∅&#10;  end&#10;&#10;  event add_link // (env) channel sets a topology&#10;  extends add_link&#10;  end&#10;&#10;  event disconnect_link // (env) disconnecting a link&#10;  extends disconnect_link&#10;  end&#10;&#10;  event recover_link // (env) recovering a link&#10;  extends recover_link&#10;  end&#10;&#10;  event start_sensing // (env) activating each node to sense data&#10;  extends start_sensing&#10;  end&#10;&#10;  event finish_sensing // (shd) finishing sensing data process&#10;  extends finish_sensing&#10;  end&#10;&#10;  event sensing // (shd) each node senses a data from environment&#10;  extends sensing&#10;  end&#10;&#10;  event create_dataPkt // (ctl)  create a data packet&#10;  extends create_dataPkt&#10;    where&#10;      @g17 pkt  ∉ dom(pktDestAddr)&#10;    then&#10;      @a13 pktDestAddr ≔ pktDestAddr ∪   {pkt ↦ BROADCAST}&#10;  end&#10;&#10;  event start_flooding // (ctl) starting flooding (used for a control packet)&#10;  extends start_flooding&#10;  end&#10;&#10;  event reset_flooding // (ctl) resetting flooding (used for a control packet)&#10;  extends reset_flooding&#10;  end&#10;&#10;  event create_bconPkt // (ctl)  create a beacon packet&#10;  extends create_bconPkt&#10;    where&#10;      @g18 pkt ∉ dom(pktDestAddr)&#10;    then&#10;      @a11 pktDestAddr ≔ pktDestAddr ∪   {pkt ↦ BROADCAST}&#10;  end&#10;&#10;  event bcastRou_due // (ctl) broadcast route time due&#10;  extends bcastRou_due&#10;  end&#10;&#10;  event reset_bcastRouTimer // (ctl) reseting broadcast route timer for the next round&#10;  extends reset_bcastRouTimer&#10;  end&#10;&#10;  event create_routePkt // (ctl) creating a route packet&#10;  extends create_routePkt&#10;    where&#10;      @g21 pkt ∉ dom(pktDestAddr)&#10;    then&#10;      @a11 pktDestAddr ≔ pktDestAddr ∪   {pkt ↦ BROADCAST}&#10;  end&#10;&#10;  event start_tx_dataPkt_bct // (ctl) starting broadcasting a data packet to a channel&#10;  extends start_tx_dataPkt&#10;    where&#10;      @g8 completedRoute = FALSE&#10;  end&#10;&#10;  event start_tx_dataPkt_fwd // (ctl) starting unicasting a data packet to a channel via route&#10;  extends start_tx_dataPkt&#10;    any y&#10;    where&#10;      @g8 completedRoute = TRUE&#10;      @g9 x ∈ dom( cRouteTree)&#10;      @g10 y =  cRouteTree(x)&#10;      @g11 pkt ∈ dom(pktDestAddr)&#10;    then&#10;      @a6 pktDestAddr ≔ pktDestAddr   {pkt ↦ y}&#10;  end&#10;&#10;  event start_tx_bconPkt // (ctl) starting transmiting a beacon packet to a channel&#10;  extends start_tx_bconPkt&#10;  end&#10;&#10;  event start_tx_routePkt // (ctl) starting transmiting a route packet to a channel&#10;  extends start_tx_routePkt&#10;  end&#10;&#10;  event send_down // (ctl) sending a packet down to a channel&#10;  extends send_down&#10;    any dest&#10;    where&#10;      @g13 pkt ∈ dom(pktDestAddr) ∧ dest=pktDestAddr(pkt)&#10;      @g14 pkt ∉ dom(vPktDestAddr) ∧ dest ∈ ND ∪ {BROADCAST}&#10;    then&#10;      @a14 pktDestAddr ≔  {pkt} ⩤ pktDestAddr&#10;      @a15 vPktDestAddr ≔ vPktDestAddr ∪ {pkt ↦ dest}&#10;  end&#10;&#10;  event find_neighbours // (env) channel finds the neighbour list of the forwarder&#10;  extends find_neighbours&#10;    any dest&#10;    where&#10;      @g7 pkt ∈ dom(vPktDestAddr) ∧ dest=vPktDestAddr(pkt)&#10;      @g8 dest = BROADCAST&#10;  end&#10;&#10;  event assign_forwarder // (env) channel assigns specific forwarder&#10;  extends assign_forwarder&#10;    any dest&#10;    where&#10;      @g7 pkt ∈ dom(vPktDestAddr) ∧ dest=vPktDestAddr(pkt)&#10;      @g8 dest ≠ BROADCAST&#10;      @g9 nb = dest&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  extends send_up&#10;    any dest&#10;    where&#10;      @g20 pkt ∈ dom(vPktDestAddr) ∧ dest = vPktDestAddr(pkt)&#10;      @g21 pkt ∉ dom(pktDestAddr)&#10;    then&#10;      @a16 vPktDestAddr ≔ vPktDestAddr ∖ {pkt↦dest }&#10;      @a17 pktDestAddr ≔ pktDestAddr  ∪ {pkt  ↦dest}&#10;  end&#10;&#10;  event receive_dataPkt // (ctl) each neighbour node receives a data pacekt from a channel&#10;  extends receive_dataPkt&#10;  end&#10;&#10;  event receive_dup_dataPkt // (ctl) each neighbour node receives a duplicated data packet from a channel&#10;  extends receive_dup_dataPkt&#10;  end&#10;&#10;  event receive_controlPkt // (ctl) each neighbour node receives a  control pacekt from a channel&#10;  extends receive_controlPkt&#10;  end&#10;&#10;  event receive_dup_controlPkt // (ctl) each neighbour node including sink receives a duplicated control packet from channel&#10;  extends receive_dup_controlPkt&#10;  end&#10;&#10;  event sink_recv_dataPkt // (ctl) each neighbour node receives a data pacekt from channel&#10;  extends sink_recv_dataPkt&#10;  end&#10;&#10;  event sink_recv_controlPkt // (ctl) sink receives a control packet&#10;  extends sink_recv_controlPkt&#10;  end&#10;&#10;  event add_newEntry // (ctl) add new entry into the neighbour table&#10;  extends add_newEntry&#10;    where&#10;      @g11 y ↦ x ↦ BROADCAST ∉ parent&#10;      @g12 (y ↦ x ↦ INFINITY ∉ cost) ∧ (x ≠ Sink)&#10;    then&#10;      @a8 parent ≔ parent  ∪  {y ↦ x ↦ BROADCAST}&#10;      @a9 cost ≔ cost ∪ {y↦x↦INFINITY}&#10;  end&#10;&#10;  event add_newEntry_sink // (ctl) add new entry into the neighbour table&#10;  extends add_newEntry&#10;    where&#10;      @g11 y ↦ x ↦ BROADCAST ∉ parent&#10;      @g12 (y ↦ x ↦ 0 ∉ cost) ∧ (x = Sink)&#10;    then&#10;      @a8 parent ≔ parent  ∪  {y ↦ x ↦ BROADCAST}&#10;      @a9 cost ≔ cost ∪ {y↦x↦0}&#10;  end&#10;&#10;  event update_nbr // (ctl) update receiving information into the neighbour table&#10;  extends update_nbr&#10;  end&#10;&#10;  event update_route_1 // (ctl) updating information from route packet into the neighbour table (for sensor nodes)&#10;  extends update_route&#10;    any par cst&#10;    where&#10;      @g10 x ∈ dom(cRouteTree) ∧ par = cRouteTree(x)&#10;      @g11 x ∈ dom(cpCost) ∧ cst = cpCost(x) ∧ cst ≠ INFINITY&#10;      @g12 y ↦ x ∈ dom(parent) ∧ y ↦ x ↦par ∉ parent&#10;      @g13 y ↦ x ∈ dom(cost) ∧ y ↦ x ↦cst ∉ cost&#10;    then&#10;      @a4 parent ≔  parent    {y ↦ x ↦par}&#10;      @a5 cost ≔  cost    {y ↦ x ↦cst}&#10;  end&#10;&#10;  event update_route_2 // (ctl) updating information from route packet into the neighbour table (for a sink)&#10;  extends update_route&#10;    where&#10;      @g10 x ∉ dom(cRouteTree)&#10;  end&#10;&#10;  event decrease_liveliness // (ctl) decreasing liveliness of each neighbour in neighbour table&#10;  extends decrease_liveliness&#10;  end&#10;&#10;  event exclude_deadNbr // (ctl) excluding dead neighbour from  neighbour table&#10;  extends exclude_deadNbr&#10;  end&#10;&#10;  event est_due // (ctl) the link quality estimation timer due&#10;  extends est_due&#10;  end&#10;&#10;  event update_est // (cal) calculate and update reception ratio in case no lost packets or lose packets in the middle of transmission&#10;  extends update_est&#10;  end&#10;&#10;  event update_est_nothing // (ctl) for case the dead neighbour node affecting sentEst become zero&#10;  extends update_est_nothing&#10;  end&#10;&#10;  event finish_tx_pkt // (ctl) finishing packet transmission&#10;  extends finish_tx_pkt&#10;  end&#10;&#10;  event final_tx_controlPkt // (ctl) the transmitted packet is removed from middleware indicating completion of transmission mechanism&#10;  extends final_tx_controlPkt&#10;  end&#10;&#10;  event chooseParent_due // (ctl) choosing a parent period due&#10;  extends reset_bcastRouTimer&#10;    where&#10;      @g3 chooseParentTimer = FALSE&#10;    then&#10;      @a3 chooseParentTimer ≔ TRUE&#10;      @t501 deadNbrs ≔ ∅&#10;  end&#10;&#10;  event choose_node // (ctl) choosing a node who has not chosen its parent yet&#10;    any x nb&#10;    where&#10;      @g1 chooseParentTimer = TRUE&#10;      @g2 x ∈ ND ∖ {Sink} // @g3 x ∈ dom(neighbourTbl ▷ nodes) ∪ ran( nodes ◁ neighbourTbl)&#10;      @g3 x ∉ chosenNDs // x ∉ (Q ∪ deadNbrs1)&#10;      @g4 nb = ran({x} ◁  neighbourTbl) ∧ nb  ≠ ∅ // @g7 nb = ran({x} ◁ nbTbl ▷ nodes) ∧ nb  ≠ ∅ // listing the neighbours of node x whose the link quality is gerater that threshold&#10;      @g5 Nbrs= ∅&#10;      @g6 completedRoute = FALSE&#10;      @g7 calPCostFlg = FALSE // @g12 x ∈ dom(chooseParentFlg) ∧ chooseParentFlg(x) = FALSE&#10;    then&#10;      @a1 chosenNDs ≔ chosenNDs ∪ {x}&#10;      @a2 Nbrs ≔ nb&#10;  end&#10;&#10;  event cal_PCost_gt // (ctl) calculating path cost&#10;    any x nb pCost Nbrs1 rEst sEst lnkQty th&#10;    where&#10;      @g1 x ∈ chosenNDs ∖ dom(cRouteTree) ∧ nb ∈ Nbrs&#10;      @g2 th ∈ QThreshold&#10;      @g3 th &gt; 0 ∧ th = Qlow&#10;      @g4 x ↦nb   ∈ neighbourTbl&#10;      @g5 x ↦nb  ∈ dom(receiveEst) ∧  receiveEst(x ↦nb) ≥ th&#10;      @g6 rEst ∈ ℕ ∧ rEst = receiveEst(x ↦ nb)&#10;      @g7 x ↦nb ∈ dom(sentEst) ∧  sentEst(x ↦nb) ≥ th&#10;      @g8 sEst ∈ ℕ  ∧ sEst = sentEst(x ↦ nb)&#10;      @g9 lnkQty ∈ ℕ ∧ lnkQty = ((120−rEst) ∗ (120−sEst))&#10;      @g10 Nbrs1 = ran({x} ◁ neighbourTbl) ∧ Nbrs1 ≠ ∅&#10;      @g11 pCost∈ ℕ&#10;      @g12 cpCost(nb) = pCost  ∧ pCost ≠ INFINITY&#10;      @g13 x ↦ nb ∉ calPCostNDs&#10;      @g14 pCost + lnkQty ≥ 0&#10;    then&#10;      @a1 calPCostNDs ≔  calPCostNDs ∪  {x↦nb}&#10;      @a2 calPCost ≔ calPCost  ∪  {x ↦ nb↦ (pCost + lnkQty)}&#10;      @a3 Nbrs ≔ Nbrs ∖ {nb}&#10;      @a4 calPCostFlg ≔ TRUE&#10;  end&#10;&#10;  event cal_PCost_gt_skip // (ctl) skipping calculating path cost for the case that the node is further far away from the sink&#10;    any x nb m Nbrs1 pREst pSEst pCost th&#10;    where&#10;      @g1 x  ∈ chosenNDs ∖ dom(cRouteTree)&#10;      @g2 th ∈ QThreshold&#10;      @g3 th &gt; 0 ∧ th = Qlow&#10;      @g4 nb ∈ Nbrs&#10;      @g5 x ↦nb   ∈ neighbourTbl&#10;      @g6 x ↦nb  ∈ dom(receiveEst) ∧  receiveEst(x ↦nb) ≥ th&#10;      @g7 pREst ∈ ℕ ∧ pREst = receiveEst(x ↦ nb)&#10;      @g8 x ↦nb ∈ dom(sentEst) ∧  sentEst(x ↦nb) ≥ th&#10;      @g9 pSEst ∈ ℕ  ∧ pSEst = sentEst(x ↦ nb)&#10;      @g10 pCost ∈ ℕ ∧ pCost = ((120−pREst) ∗ (120−pSEst))&#10;      @g11 Nbrs1 = ran({x} ◁ neighbourTbl) ∧ Nbrs1 ≠ ∅&#10;      @g12 m ∈ ℕ&#10;      @g13 cpCost(nb) = m  ∧ m = INFINITY&#10;      @g14 x ↦ nb ∉ calPCostNDs&#10;      @g15 m + pCost ≥ 0&#10;    then&#10;      @a1 Nbrs ≔ Nbrs  ∖ {nb}&#10;      @a2 calPCostFlg ≔ TRUE&#10;  end&#10;&#10;  event cal_PCost_le // (ctl) skipping calculating path cost for the case that the neighbour node has the link quality less than the threshold&#10;    any x nb pREst th&#10;    where&#10;      @g1 x ∈ chosenNDs ∖ dom(cRouteTree)&#10;      @g2 th ∈ QThreshold&#10;      @g3 th &gt; 0 ∧ th = Qlow&#10;      @g4 nb ∈ Nbrs&#10;      @g5 x ↦nb   ∈ neighbourTbl&#10;      @g6 x ↦nb  ∈ dom(receiveEst) ∧  x ↦nb ∈ dom(sentEst)&#10;      @g7 pREst ∈ ℕ ∧ pREst = receiveEst(x ↦ nb)&#10;      @g8 receiveEst(x ↦nb) &lt; th ∨ sentEst(x ↦nb) &lt; th&#10;    then&#10;      @a1 Nbrs ≔ Nbrs  ∖ {nb}&#10;      @a42 calPCostFlg ≔ TRUE&#10;  end&#10;&#10;  event choose_parent // (ctl) choosing a parent&#10;    any x p m des&#10;    where&#10;      @g1 x  ∈  ND ∖ {Sink}&#10;      @g2 x ∉ dom(cRouteTree)&#10;      @g3 completedRoute = FALSE&#10;      @g4 x ∉ nodes&#10;      @g5 Nbrs = ∅&#10;      @g6 ran(calPCost) ≠ ∅&#10;      @g7 m = min(ran(calPCost))&#10;      @g8 p ∈ ran(dom(calPCost ▷ {m}))&#10;      @g9 x ↦ p ∈ calPCostNDs&#10;      @g10 calPCostFlg = TRUE // @g12 ∀ S · S⊆(cRouteTree∪{x ↦p })∼[S] ⇒    S=∅&#10;      @g11 x ≠ p&#10;      @g12 des ⊆ nodes&#10;      @g13 p ∈ nodes ∧ p ∉ des ∪ {x}&#10;    then&#10;      @a1 cRouteTree  ≔ cRouteTree ∪ {x ↦ p}&#10;      @a2 nodes ≔ nodes  ∪  {x}&#10;      @a4 cpCost(x) ≔ m&#10;      @a6 calPCostNDs ≔ ∅&#10;      @a5 calPCost ≔ ∅&#10;      @a7 calPCostFlg ≔ FALSE&#10;  end&#10;&#10;  event choose_parent_skip // (ctl) skipping choosing parent for the case that all links have link quality lower than the quality threshold&#10;    any x p m&#10;    where&#10;      @typing_p p ∈ ℤ&#10;      @typing_m m ∈ ℤ&#10;      @typing_x x ∈ ℤ&#10;      @g1 x = x&#10;      @g2 p ∈ nodes&#10;      @g3 x  ∈  ND ∖ {Sink}&#10;      @g4 x ∉ dom(cRouteTree)&#10;      @g5 completedRoute = FALSE&#10;      @g6 Nbrs = ∅&#10;      @g7 calPCostNDs = ∅&#10;      @g8 calPCostFlg = TRUE&#10;      @g9 x ∉ deadNbrs&#10;    then&#10;      @a1 calPCostFlg ≔ FALSE&#10;  end&#10;&#10;  event report_routeCompletion // (ctl) reporting the route completion&#10;    any r&#10;    where&#10;      @typing_r r ∈ ℙ(ℤ × ℤ)&#10;      @g1 completedRoute = FALSE&#10;      @g2 r = cRouteTree&#10;      @g4 Nbrs = ∅ // nodes =  ND&#10;    then&#10;      @a1 completedRoute ≔ TRUE&#10;  end&#10;&#10;  event reset_routeTimer&#10;    where&#10;      @g1 chooseParentTimer = TRUE&#10;      @g4 chosenNDs ≠ ∅&#10;    then&#10;      @a2 chooseParentTimer ≔ FALSE&#10;      @a4 chosenNDs ≔ ∅&#10;  end&#10;&#10;  event reset_route // (ctl) resetting the route tree&#10;    where&#10;      @g1 completedRoute = TRUE&#10;      @g3 dom(cRouteTree) =  ND  ∖ {Sink}&#10;    then&#10;      @a1 completedRoute ≔ FALSE&#10;      @a2 cRouteTree ≔ ∅&#10;      @a3 nodes ≔ {Sink}&#10;  end&#10;&#10;  event lose_all_neighbours // (env) channel loes all neighbours&#10;  extends lose_all_neighbours&#10;  end&#10;&#10;  event lose_pkt // (ctl) each node records a lost packet&#10;  extends lose_pkt&#10;  end&#10;&#10;  event final_tx_pkt extends final_tx_pkt&#10;  end&#10;end&#10;" version="5">
<org.eventb.core.refinesMachine name="'" org.eventb.core.target="M4"/>
<org.eventb.core.seesContext name="_a98EoXvQEeWAP_VoIyV-ZA" org.eventb.core.target="T01"/>
<org.eventb.core.variable name="_K9GyZZZfEeSDW82aTOSJOQ" org.eventb.core.comment="(ctl) a sink buffer" org.eventb.core.identifier="sinkBuff"/>
<org.eventb.core.variable name="_rjoVcCGEEeWBBdN5RKBVAg" org.eventb.core.comment="(ctl) nodes' waiting buffer" org.eventb.core.identifier="ndBuff"/>
<org.eventb.core.variable name="_JrKrlJZuEeSDW82aTOSJOQ" org.eventb.core.comment="(ctl) sensing nodes" org.eventb.core.identifier="sensingNDs"/>
<org.eventb.core.variable name="_JrKrlZZuEeSDW82aTOSJOQ" org.eventb.core.comment="(ctl) sensed packets" org.eventb.core.identifier="sensedPkts"/>
<org.eventb.core.variable name="_4RlM4JdaEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) sense ndBuff" org.eventb.core.identifier="senseBuff"/>
<org.eventb.core.variable name="_JrKrl5ZuEeSDW82aTOSJOQ" org.eventb.core.comment="(ctl) flooded packets" org.eventb.core.identifier="floodedPkts"/>
<org.eventb.core.variable name="_8v9XkJaoEeSDW82aTOSJOQ" org.eventb.core.comment="(ctl) historical received packet used for detect duplicated packets" org.eventb.core.identifier="floodTbl"/>
<org.eventb.core.variable name="_oRByEJakEeSDW82aTOSJOQ" org.eventb.core.comment="(ctl) neighbour lists" org.eventb.core.identifier="ctlNeighbours"/>
