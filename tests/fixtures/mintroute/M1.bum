<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1445861654844" org.eventb.texttools.text_representation="machine M1 refines M0  sees C1&#10;&#10;variables sinkBuff // a sink ndBuff&#10;          ndBuff // nodes' waiting buffer  --------------------- var of M2&#10;          WiMedium // wireless medium&#10;          sensingNDs // sensing nodes&#10;          sensedPkts // sensed packets&#10;          floodedPkts // flooded packets&#10;          floodTbl // historical received packets used for detect duplicated packets&#10;          ctlNeighbours // neighbour lists&#10;          recLostPkts // recorded lost packet at each node&#10;          floodFlg // flood flag&#10;&#10;&#10;invariants&#10;  @inv1_1 ndBuff ∈ ND ↔PKT&#10;  @inv1_2 WiMedium ∈ ND ↔PKT&#10;  @inv1_3 sensingNDs ⊆ ND ∖ {Sink}&#10;  @inv1_4 sensedPkts ⊆ PKT&#10;  @inv1_6 floodedPkts ⊆ PKT&#10;  @inv1_7 floodTbl ∈ ND → ℙ(PKT)&#10;  @inv1_8 ctlNeighbours ∈ PKT ↔ (ND ∪ {FAILED_XMIT})&#10;  @inv1_12 floodFlg ∈ ND →BOOL&#10;  @inv1_20 recLostPkts ∈ ND ↔ PKT&#10;  @glu1_1 ran(ndBuff ∪ WiMedium) =middleware&#10;  @glu1_2 sensedPkts ∪  floodedPkts = xmittedPkts&#10;  @glu_1_3 ran(recLostPkts) = lostPkts&#10;  @saf1_1 ndBuff ∩ WiMedium = ∅ // @saf1_1 sensedPkts ≠ ∅  ⇒ partition(sensedPkts, ndBuff, WiMedium, ({Sink} × sinkBuff))&#10;  @saf1_2 (ndBuff ∩ WiMedium) ∩ recLostPkts = ∅&#10;  //@saf1_3 ran(ndBuff) ∪ ran(WiMedium) ∪ ran(recLostPkts) ∪ sinkBuff =  (sensedPkts ∪  floodedPkts)&#10;  @saf1_3 ∀p ·p ∈ sensedPkts ⇒ p ∈  (ran(ndBuff) ∪  ran(WiMedium) ∪   ran(recLostPkts) ∪ sinkBuff)&#10;  @saf1_4 ∀p· p ∈ sensedPkts ∧ p ∉ ran(ndBuff) ∧ p∉ ran(WiMedium)  ⇒ (p ∈ sinkBuff ∧ p ∉ ran(recLostPkts)) ∨ (p ∉ sinkBuff ∧ p ∈ ran(recLostPkts))&#10;  //@saf1_3 partition(sensedPkts ∪  floodedPkts,ran(ndBuff) ∪ ran(WiMedium) ∪ sinkBuff, ran(recLostPkts))&#10;  //@saf1_4  ∀p· p ∈ (sensedPkts ∪ floodedPkts) ∧ p ∉ ran(ndBuff) ∧ p∉ ran(WiMedium) ⇒ (p ∈ sinkBuff ∧ p ∉ ran(recLostPkts)) ∨ (p ∉ sinkBuff ∧ p ∈ ran(recLostPkts))&#10;  //@saf1_4  ∀p· p ∈ sensedPkts ∖ran(ndBuff ∪WiMedium) ⇒ (p ∈ sinkBuff ∧ p ∉ ran(recLostPkts)) ∨ (p ∉ sinkBuff ∧ p ∈ ran(recLostPkts))&#10;  //@saf1_3 partition(sensedPkts,ran(ndBuff) ∪ ran(WiMedium) ∪ sinkBuff, ran(recLostPkts))&#10;  //@saf1_4  ∀p· p ∈ sensedPkts ∧ p ∉ ran(ndBuff) ∧ p∉ ran(WiMedium) ⇒ (p ∈ sinkBuff ∧ p ∉ ran(recLostPkts)) ∨ (p ∉ sinkBuff ∧ p ∈ ran(recLostPkts))&#10;&#10;   //@saf1_3 partition((sensedPkts ∪  floodedPkts), ran(ndBuff), ran(WiMedium), ran(recLostPkts))&#10;  //@saf1_3 partition((sensedPkts ∪  floodedPkts), ndBuff, WiMedium, recLostPkts)&#10;  /* @saf1_2 partition(sensedPkts ∪  floodedPkts,ran(ndBuff), ran(WiMedium), ran(recLostPkts))&#10;     @saf1_3 partition(sensedPkts, ndBuff, WiMedium, recLostPkts) */&#10;&#10;events&#10;  event INITIALISATION&#10;    then&#10;      @int0_3 sinkBuff ≔  ∅&#10;      @int1_1 ndBuff ≔ ∅&#10;      @int1_2 WiMedium ≔ ∅&#10;      @int1_3 sensingNDs ≔ ∅&#10;      @int1_4 sensedPkts ≔ ∅&#10;      @int1_6 floodedPkts ≔ ∅&#10;      @int1_7 floodTbl ≔ ND × {∅}&#10;      @int1_8 ctlNeighbours ≔ ∅&#10;      @int1_12 floodFlg ≔ ND × {FALSE}&#10;      @inv1_20 recLostPkts ≔ ∅&#10;  end&#10;&#10;  event create_dataPkt // creating a data packet&#10;  refines create_pkt&#10;    any s pkt&#10;    where&#10;      @g1 pkt ∈ PKT ∧ s ∈ ND ∖{Sink}&#10;      @g2 pkt ∉  ran(ndBuff ∪ WiMedium)&#10;      @g3 s ∉ sensingNDs  ∧ pkt ∉ sensedPkts ∪  floodedPkts // has not been created yet&#10;      @g4 s = initialSrcAddr(pkt)&#10;      @g5 s ∈ dom(floodTbl)  ∧ pkt ∉ floodTbl(s)&#10;      @g6 type(pkt) = DATA&#10;      @g71 pkt ∉ sinkBuff  ∧ pkt  ∉  ran(recLostPkts)&#10;    then&#10;      @a1 sensingNDs ≔ sensingNDs ∪ {s}&#10;      @a2 sensedPkts ≔ sensedPkts ∪ {pkt}&#10;      @a3 ndBuff ≔ ndBuff  ∪ {s ↦ pkt}&#10;      @a4 floodTbl(s) ≔  floodTbl(s) ∪ {pkt}&#10;  end&#10;&#10;  event clear_sensingNDs // clearing a sensed node&#10;    any x&#10;    where&#10;      @g1 sensingNDs = {x} // ∖ {Sink}&#10;    then&#10;      @a1 sensingNDs ≔ ∅&#10;  end&#10;&#10;  event start_flooding // starting flooding (used for a control packet)&#10;    any x&#10;    where&#10;      @g1 x ∈ ND&#10;      @g2 floodFlg(x) = FALSE&#10;    then&#10;      @a1 floodFlg(x) ≔ TRUE&#10;  end&#10;&#10;  event reset_flooding // resetting flooding (used for a control packet)&#10;    any x&#10;    where&#10;      @g1 x ∈ dom(floodFlg)&#10;      @g2 floodFlg(x) = TRUE&#10;    then&#10;      @a1 floodFlg(x) ≔ FALSE&#10;  end&#10;&#10;  event create_controlPkt // creating a control packet&#10;  refines create_pkt&#10;    any s pkt&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∉  ran(ndBuff ∪ WiMedium)&#10;      @g3 pkt ∉ sensedPkts ∪  floodedPkts // has not been created yet&#10;      @g4 s = initialSrcAddr(pkt)&#10;      @g5 s ∈ dom(floodTbl)  ∧ pkt ∉ floodTbl(s)&#10;      @g6 type(pkt) ∈ CONTROL&#10;      @g7 floodFlg(s) = TRUE&#10;    then&#10;      @a1 floodedPkts ≔ floodedPkts ∪ {pkt}&#10;      @a2 ndBuff ≔ ndBuff  ∪ {s ↦ pkt}&#10;      @a3 floodTbl(s) ≔  floodTbl(s) ∪ {pkt}&#10;  end&#10;&#10;  event start_tx // starting transmiting a packet to wireless medium&#10;    any x pkt&#10;    where&#10;      @g1 x ↦ pkt ∈ ndBuff // packet in waiting buffer&#10;      @g2 x ↦ pkt ∉ WiMedium // but has not been tranmitted to wireless medium&#10;    then&#10;      @a1 ndBuff ≔ ndBuff ∖{x↦pkt}&#10;      @a2 WiMedium ≔ WiMedium  ∪  {x ↦ pkt}&#10;  end&#10;&#10;  event indicate_neighbours // channel indicates the neighbour of a forwarder&#10;    any pkt nbrs f&#10;    where&#10;      @g1 pkt ∈ ran(WiMedium)&#10;      @g2 f ↦ pkt ∈ WiMedium&#10;      @g3 nbrs ∈ {n∣n ∈ (ℙ(ND)) ∪ {{FAILED_XMIT}}}&#10;      @g4 nbrs ≠ ∅&#10;      @g5 pkt ∉ dom(ctlNeighbours)&#10;    then&#10;      @a2 ctlNeighbours ≔ ctlNeighbours ∪({pkt}× nbrs)&#10;  end&#10;&#10;  event receive_pkt // each neighbour node receives a transmitted packet&#10;    any s nb pkt&#10;    where&#10;      @g1 pkt ∈ ran(WiMedium)&#10;      @g2 pkt  ↦ nb ∈ ctlNeighbours&#10;      @g3 nb ↦ pkt ∉   ndBuff&#10;      @g4 nb ↦ pkt ∉ WiMedium&#10;      @g5 s = initialSrcAddr(pkt) ∧ s ≠ nb&#10;      @g6 nb ≠ Sink&#10;      @g7 nb ∈ dom(floodTbl)  ∧pkt ∉ floodTbl(nb) // is not a duplicted packet&#10;    then&#10;      @a1 ndBuff ≔ ndBuff ∪ {nb ↦pkt}&#10;      @a2 ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}&#10;      @a3 floodTbl(nb) ≔  floodTbl(nb) ∪ {pkt}&#10;  end&#10;&#10;  event receive_dup_pkt // each neighbour node discards a duplicated packet&#10;    any nb pkt&#10;    where&#10;      @g1 pkt ∈ dom(ctlNeighbours)&#10;      @g2 pkt ↦ nb ∈ ctlNeighbours&#10;      @g3 nb ∈ dom(floodTbl)  ∧pkt ∈ floodTbl(nb) // is a duplicted packet&#10;    then&#10;      @a1 ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}&#10;  end&#10;&#10;  event sink_recv_pkt // sink receives a packet&#10;  refines sink_recv_pkt&#10;    any s pkt nb&#10;    where&#10;      @g1 s = initialSrcAddr(pkt)&#10;      @g2 s ≠ Sink&#10;      @g3 pkt ∈ ran(WiMedium)∖sinkBuff&#10;      @g4 nb =  Sink&#10;      @g5 pkt ↦ nb ∈ ctlNeighbours&#10;      @g6 nb ∈ dom(floodTbl)  ∧pkt ∉ floodTbl(nb) // is not duplicted packet&#10;      //@g71 pkt ∈ sensedPkts ∧ pkt ∉ ran(recLostPkts)&#10;    then&#10;      @a1 sinkBuff ≔ sinkBuff ∪ {pkt}&#10;      @a2 ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}&#10;      @a3 floodTbl(nb) ≔  floodTbl(nb) ∪ {pkt}&#10;  end&#10;&#10;  event finish_tx_pkt // finishing packet transmission&#10;    any f pkt&#10;    where&#10;      @g1 {pkt} ◁ctlNeighbours = ∅&#10;      @g2 pkt ∈  ran(WiMedium) ∧ pkt ∈ ran(ndBuff) // there are some packets being forwarded&#10;      @g3 f ∈ dom(WiMedium) ∧ f ↦ pkt ∈ WiMedium&#10;    then&#10;      @a1 WiMedium ≔ WiMedium  ∖ {f↦pkt}&#10;  end&#10;&#10;  event final_tx_pkt // the transmitted packet is removed from middleware indicating completion of transmission mechanism&#10;  refines final_tx_pkt&#10;    any pkt&#10;    where&#10;      @g1 {pkt} ◁ctlNeighbours = ∅&#10;      //@g11 pkt∈ sensedPkts ∧ pkt∈sinkBuff&#10;      @g2 pkt ∈ ran(WiMedium) ∧ pkt ∉ ran(ndBuff)&#10;      @g21 pkt∈ sensedPkts ⇒ pkt∈sinkBuff ∧ pkt ∉  ran(recLostPkts)&#10;    then&#10;      @a1 WiMedium ≔ WiMedium  ⩥ {pkt}&#10;  end&#10;&#10;  event final_tx_controlPkt&#10;  /* the transmitted packet is removed from middleware indicating completion of&#10;     transmission mechanism */&#10;  refines final_tx_pkt&#10;    any pkt&#10;    where&#10;      @g1 {pkt} ◁ctlNeighbours = ∅&#10;      @g11 pkt ∉ sensedPkts&#10;      @g2 pkt ∈ ran(WiMedium) ∧ pkt ∈ ran(ndBuff)&#10;      @g3 type(pkt) ≠ DATA&#10;    then&#10;      @a1 WiMedium ≔ WiMedium  ⩥ {pkt}&#10;      @a2 ndBuff ≔ ndBuff  ⩥ {pkt}&#10;  end&#10;&#10;  event lose_pkt // each node records a lost packet&#10;  refines net_losing&#10;    any f pkt&#10;    where&#10;      @g1 pkt ∈ ran(WiMedium) ∖ ran(recLostPkts)&#10;      @g2 pkt ∉ ran(ndBuff)&#10;      @g3 f ↦ pkt ∈ WiMedium&#10;      @g4 f ↦ pkt ∉ recLostPkts&#10;      @g5 ran({pkt} ◁ ctlNeighbours) = {FAILED_XMIT}&#10;      @g6 pkt ∉ sinkBuff&#10;    then&#10;      @a1 WiMedium ≔ WiMedium  ⩥ {pkt}&#10;      @a2 recLostPkts ≔ recLostPkts  ∪ {f↦pkt}&#10;  end&#10;end&#10;" version="5">
<org.eventb.core.refinesMachine name="'" org.eventb.core.target="M0"/>
