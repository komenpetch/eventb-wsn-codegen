<org.eventb.core.action name="_JrEk85ZuEeSDW82aTOSJOQ" org.eventb.core.assignment="floodedPkts ≔ ∅" org.eventb.core.label="int1_6"/>
<org.eventb.core.action name="_bfpOQJZ4EeSDW82aTOSJOQ" org.eventb.core.assignment="floodTbl ≔ ND × {∅}" org.eventb.core.label="int1_7"/>
<org.eventb.core.action name="_NkHdwJdYEeS7UZUzQZNbaA" org.eventb.core.assignment="ctlNeighbours ≔ ∅" org.eventb.core.label="int1_8"/>
<org.eventb.core.action name="_gyEq8JdZEeS7UZUzQZNbaA" org.eventb.core.assignment="floodFlg ≔ ND × {FALSE}" org.eventb.core.label="int1_12"/>
<org.eventb.core.action name="_GoDvAJayEeSDW82aTOSJOQ" org.eventb.core.assignment="recLostPkts ≔ ∅" org.eventb.core.label="inv1_20"/>
</org.eventb.core.event>
<org.eventb.core.event name="_JrKrmZZuEeSDW82aTOSJOQ" org.eventb.core.comment="creating a data packet" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="create_dataPkt">
