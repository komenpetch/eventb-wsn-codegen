<org.eventb.core.action name="_cAXfY5dtEeS7UZUzQZNbaA" org.eventb.core.assignment="liveliness ≔ liveliness   {x ↦ y ↦ (live−1)}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_cAYGcJdtEeS7UZUzQZNbaA" org.eventb.core.assignment="checkedLiveNbrs ≔ checkedLiveNbrs ∖ {x↦y}" org.eventb.core.label="a2"/>
</org.eventb.core.event>
