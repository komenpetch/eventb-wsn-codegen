<org.eventb.core.guard name="_niTONAk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MDestBuffer_record_destBuff_g1" org.eventb.core.predicate="nb ↦ pkt   ∉  destBuff"/>
<org.eventb.core.action name="_niTONQk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="destBuff ≔ destBuff ∪ {nb ↦ pkt}" org.eventb.core.label="MDestBuffer_ndBuff_a1"/>
<org.eventb.core.action name="_niTONgk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="clrRecvBuffFlg ≔ clrRecvBuffFlg ∪ {nb ↦pkt}" org.eventb.core.label="MDestBuffer_record_destBuff_a1"/>
