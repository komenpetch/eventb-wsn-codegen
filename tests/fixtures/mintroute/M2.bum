</org.eventb.core.event>
<org.eventb.core.event name="_xPmp0ZdYEeS7UZUzQZNbaA" org.eventb.core.comment="(shd) finishing sensing data process" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="finish_sensing">
