<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1438247373729" org.eventb.texttools.text_representation="machine M3 refines M2  sees C3&#10;&#10;variables destBuff // nodes' receiving buffer&#10;          finalDestAddr // (ctl) final dest address&#10;          ndBuff // nodes' waiting buffer --------------------- var of M1&#10;          sensingNDs // (ctl)sensing nodes&#10;          sensedPkts // (ctl)sensed packets&#10;          floodedPkts // (ctl)flooded packets&#10;          floodTbl // for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // record recLostPkts packet at each node&#10;          floodFlg // flood flag&#10;          envSensedFlg // (env) sensing period--------------------- var of M2&#10;          envData // (env) environmental/conditional data&#10;          ctlSensedFlg // (ctl)sensing period&#10;          senseBuff // (ctl) sense ndBuff&#10;          recvedData // (ctl) received data&#10;          emergencyAlert // (ctl) actuating status&#10;          pktData // (ctl) data attached in transmitted packet&#10;          sentDown // transmitted packet to channel ------------------------- var of M3&#10;          sentUp // transmitted packet up to channel&#10;          channel // channel&#10;          envNeighbours // (env) neighbour list&#10;          wsnLinks // (env) dynamic WSN links -&#10;          crashedLinks // (env) cashed WSN Links&#10;          dataSeqNo // local nodes' current data sequence number at application layer&#10;          floodSeqNo // local nodes' current  broadcast sequence number at application layer&#10;          nbHops // neighbour's hop&#10;          pktSrc // (ctl) src address attached in transmitted packet&#10;          pktSeqNo // sequence number attached in transmitted packet&#10;          pktFwdr // fowarder attached in transmitted packet&#10;          pktNbHops // nb hop attached in transmitted packet&#10;          vPktSeqNo // (env) virtual packet at channel&#10;          vPktSrc // (env) virtual packet at channel&#10;          vPktFwdr // (env) virtual packet at channel&#10;          vPktData // (env) virtual packet at channel&#10;          vPktNbHops // (env) virtual packet at chennel&#10;&#10;&#10;invariants&#10;  @inv3_1 sentUp  ∈ ND ↔PKT&#10;  @inv3_2 sentDown  ∈ ND ↔PKT&#10;  @inv3_3 channel  ∈ ND ↔PKT&#10;  @inv3_4 envNeighbours ∈ ran(channel) ↔ (ND ∪ {FAILED_XMIT})&#10;  @inv3_5 wsnLinks ∈ WSN&#10;  @inv3_6 crashedLinks ∈ WSN&#10;  @inv3_7 dataSeqNo ∈ ND → ℕ&#10;  @inv3_8 floodSeqNo ∈ ND → ℕ&#10;  @inv3_9 nbHops ∈  ND ↔ (PKT  ⇸ ℤ)&#10;  @inv3_10 pktSeqNo ∈ PKT ⇸ ℕ&#10;  @inv3_11 pktSrc ∈  PKT⇸ ND&#10;  @inv3_12 pktFwdr ∈ PKT ⇸  ND&#10;  @inv3_13 vPktNbHops ∈  ran(channel)  ⇸ ℤ&#10;  @inv3_14 vPktSrc ∈  ran(channel) ⇸ ND&#10;  @inv3_15 pktNbHops ∈  PKT  ⇸ ℤ&#10;  @inv3_16 vPktSeqNo ∈ ran(channel)  ⇸ ℕ&#10;  @inv3_17 vPktFwdr ∈ ran(channel)  ⇸  ND // @inv3_18 vPktData ∈  ran(channel)   ⇸ ℤ&#10;  @saf3_1 partition(WiMedium, sentDown, sentUp) // sentDown /\ sentUp = {}&#10;&#10;events&#10;  event INITIALISATION&#10;    then&#10;      @int0_3 destBuff ≔  ND × {∅}&#10;      @int0_4 finalDestAddr ≔ ∅&#10;      @int1_1 ndBuff ≔ ∅&#10;      @int1_3 sensingNDs ≔ ∅&#10;      @int1_4 sensedPkts ≔ ∅&#10;      @int1_6 floodedPkts ≔ ∅&#10;      @int1_7 floodTbl ≔ ND × {∅}&#10;      @int1_8 ctlNeighbours ≔ ∅&#10;      @int1_12 floodFlg ≔ ND × {FALSE}&#10;      @inv1_20 recLostPkts ≔ ∅&#10;      @int2_1 envSensedFlg ≔ (ND ∖Destination) × {FALSE}&#10;      @int2_2 envData ≔ (ND ∖Destination) × {0}&#10;      @int2_3 ctlSensedFlg ≔ (ND ∖Destination) × {FALSE}&#10;      @int2_4 senseBuff ≔  (ND ∖Destination) × {∅}&#10;      @int2_5 recvedData ≔ Destination × {∅}&#10;      @int2_6 emergencyAlert ≔  Actuators × {FALSE}&#10;      @int2_7 pktData ≔ ∅&#10;      @int3_1 sentUp≔ ∅&#10;      @int3_2 sentDown≔ ∅&#10;      @int3_3 channel ≔ ∅&#10;      @int3_4 envNeighbours ≔ ∅&#10;      @int3_5 wsnLinks ≔ ∅&#10;      @int3_6 crashedLinks ≔ ∅&#10;      @int3_7 dataSeqNo ≔ ND × {0}&#10;      @int3_8 floodSeqNo ≔ ND × {0}&#10;      @int3_9 nbHops ≔ ∅&#10;      @int3_10 pktSeqNo ≔ ∅&#10;      @int3_11 pktSrc ≔ ∅&#10;      @int3_12 pktFwdr ≔ ∅&#10;      @int3_13 pktNbHops ≔ ∅&#10;      @int3_14 vPktSeqNo ≔ ∅&#10;      @int3_15 vPktSrc ≔ ∅&#10;      @int3_16 vPktFwdr ≔ ∅&#10;      @int2_8 vPktData ≔ ∅&#10;      @int3_18 vPktNbHops ≔ ∅&#10;  end&#10;&#10;  event set_link // (env) channel sets a topology&#10;    any l&#10;    where&#10;      @g1 l ∈ WSN&#10;      @g2 l = wsnTopology&#10;    then&#10;      @a4 wsnLinks ≔ l&#10;  end&#10;&#10;  event disconnect_link // (env) disconnecte/damage a link&#10;    any x y&#10;    where&#10;      @g1 x ∈ ND ∧ y ∈ ND&#10;      @g2 x ↦ y ∈wsnLinks&#10;      @g3 x ↦ y ∉crashedLinks&#10;    then&#10;      @a1 crashedLinks ≔ crashedLinks  ∪ {x ↦ y}&#10;      @a2 wsnLinks ≔  wsnLinks ∖    {x ↦ y}&#10;  end&#10;&#10;  event recover_link // (env) recover a link&#10;    any x y&#10;    where&#10;      @g1 x ∈ ND ∧ y ∈ ND&#10;      @g2 x ↦ y  ∈crashedLinks&#10;      @g3 x ↦ y ∉wsnLinks&#10;    then&#10;      @a1 wsnLinks ≔  wsnLinks ∪    {x ↦ y}&#10;      @a2 crashedLinks ≔ crashedLinks ∖ {x ↦ y}&#10;  end&#10;&#10;  event start_sensing extends start_sensing&#10;  end&#10;&#10;  event sensing extends sensing&#10;  end&#10;&#10;  event finish_sensing refines finish_sensing&#10;    any x&#10;    where&#10;      @g1 sensingNDs = {x} // ∖ {Destination}&#10;      @g2 x ∈ dom(envSensedFlg)&#10;      @g3 envSensedFlg(x) = TRUE&#10;      @g4 ctlSensedFlg(x) = TRUE&#10;      @g5 ndBuff = ∅ ∧ (sentDown ∪ sentUp) = ∅&#10;    then&#10;      @a1 sensingNDs ≔ ∅&#10;      @a2 ctlSensedFlg(x) ≔ FALSE&#10;      @a3 envSensedFlg(x) ≔ FALSE // @a3 sensingNDs ≔ ∅&#10;  end&#10;&#10;  event create_dataPkt // (ctl)  create a  data packet&#10;  refines create_dataPkt&#10;    any s pkt fDes data sno nbh&#10;    where&#10;      @g1 pkt ∈ PKT ∧ s ∈ ND ∖Destination&#10;      @g2 pkt ∉  ran(ndBuff ∪ sentDown ∪ sentUp)&#10;      @g3 s ∉ sensingNDs  ∧ pkt ∉ (sensedPkts ∪  floodedPkts) // has not been created yet&#10;      @g4 s = initialSrcAddr(pkt)&#10;      @g5 s ∈ dom(floodTbl)  ∧ pkt ∉ floodTbl(s) // not is duplicted packet&#10;      @g6 type(pkt) = DATA&#10;      @g7 fDes ∈ Destination&#10;      @g8 pkt ↦ fDes ∉ finalDestAddr&#10;      @g9 fDes ≠ s&#10;      @g10 ctlSensedFlg(s) = TRUE&#10;      @g11 s ∈ dom(senseBuff) ∧ senseBuff ≠ ∅ ∧ data ∈ senseBuff(s)&#10;      @g12 pkt  ∉ dom(pktData)&#10;      @g13 sno = dataSeqNo(s) + 1 ∧ s ∈ dom(dataSeqNo) // identify seq no&#10;      @g14 nbh ∈ ℤ   ∧ nbh = −1&#10;      @g15 s ↦ {pkt ↦ nbh} ∉ nbHops&#10;      @g16 pkt ∉ dom(pktSeqNo)&#10;      @g17 pkt  ∉ dom(pktSrc)&#10;      @g18 pkt ∉ dom(pktFwdr)&#10;      @g19 pkt ∉ dom(pktNbHops)&#10;    then&#10;      @a1 sensingNDs ≔ sensingNDs ∪ {s}&#10;      @a2 sensedPkts ≔ sensedPkts ∪ {pkt}&#10;      @a3 ndBuff ≔ ndBuff  ∪ {s ↦ pkt}&#10;      @a4 floodTbl(s) ≔  floodTbl(s) ∪ {pkt}&#10;      @a5 finalDestAddr ≔ finalDestAddr ∪ {pkt  ↦ fDes}&#10;      @a6 senseBuff(s) ≔  senseBuff(s) ∖{data}&#10;      @a7 pktData ≔ pktData  ∪ {pkt ↦ data}&#10;      @a8 dataSeqNo ≔  dataSeqNo{s↦sno}&#10;      @a9 nbHops ≔  nbHops ∪ {s ↦ {pkt ↦ nbh}}&#10;      @a10 pktSeqNo ≔ pktSeqNo {pkt↦sno}&#10;      @a11 pktSrc ≔ pktSrc ∪ {pkt↦s}&#10;      @a12 pktFwdr ≔ pktFwdr ∪ {pkt↦s}&#10;      @a13 pktNbHops ≔ pktNbHops ∪ {pkt ↦nbh}&#10;  end&#10;&#10;  event start_flooding // (ctl) start flooding&#10;  extends start_flooding&#10;  end&#10;&#10;  event reset_flooding extends reset_flooding&#10;  end&#10;&#10;  event create_floodPkt // (ctl)  create a packet&#10;  refines create_floodPkt&#10;    any s pkt fDes sno nbh&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∉  ran(ndBuff ∪ sentDown ∪ sentUp)&#10;      @g3 pkt ∉ (sensedPkts ∪  floodedPkts) // has not been created yet&#10;      @g4 s = initialSrcAddr(pkt)&#10;      @g5 s ∈ dom(floodTbl)  ∧ pkt ∉ floodTbl(s) // not is duplicted packet&#10;      @g6 type(pkt) ∈ CONTROL&#10;      @g7 floodFlg(s) = TRUE&#10;      @g8 fDes ∈ ND&#10;      @g9 pkt ↦ fDes ∉ finalDestAddr&#10;      @g10 fDes ≠ s&#10;      @g11 sno = floodSeqNo(s) + 1 ∧ s ∈ dom(floodSeqNo) // identify seq no&#10;      @g12 nbh ∈ ℤ   ∧ nbh = −1&#10;      @g13 s ↦ {pkt ↦ nbh} ∉ nbHops&#10;      @g14 pkt  ∉ dom(pktSeqNo)&#10;      @g15 pkt ∉ dom(pktSrc)&#10;      @g16 pkt ∉ dom(pktFwdr)&#10;      @g17 pkt ∉ dom(pktData)&#10;      @g18 pkt ∉ dom(pktNbHops)&#10;    then&#10;      @a1 floodedPkts ≔ floodedPkts ∪ {pkt}&#10;      @a2 ndBuff ≔ ndBuff  ∪ {s ↦ pkt}&#10;      @a3 floodTbl(s) ≔  floodTbl(s) ∪ {pkt}&#10;      @a4 finalDestAddr ≔ finalDestAddr ∪ {pkt  ↦ fDes}&#10;      @a5 floodSeqNo ≔  floodSeqNo {s↦sno}&#10;      @a6 nbHops ≔  nbHops ∪ {s ↦ {pkt ↦ nbh}}&#10;      @a7 pktSeqNo ≔ pktSeqNo {pkt↦sno}&#10;      @a8 pktFwdr ≔ pktFwdr ∪ {pkt↦s}&#10;      @a9 pktSrc ≔ pktSrc ∪ {pkt↦s}&#10;      @a10 pktData ≔ pktData ∪ {pkt ↦0}&#10;      @a11 pktNbHops ≔ pktNbHops ∪ {pkt ↦nbh}&#10;  end&#10;&#10;  event lose_pkt refines lose_pkt&#10;    any f pkt&#10;    where&#10;      @g1 pkt ∈  ran(sentUp)  ∧ pkt ∉ ran(sentDown)&#10;      @g2 pkt ∉ ran(recLostPkts)&#10;      @g3 pkt ∉ ran(ndBuff)&#10;      @g4 f ↦ pkt ∈ sentUp ∧ f ↦ pkt ∉ sentDown&#10;      @g5 f ↦ pkt ∉ recLostPkts&#10;      @g6 ran({pkt} ◁ ctlNeighbours) = {FAILED_XMIT}&#10;    then&#10;      @a1 sentUp ≔ sentUp  ⩥ {pkt}&#10;      @a2 recLostPkts ≔ recLostPkts  ∪ {f↦pkt}&#10;      @a3 ctlNeighbours ≔ ctlNeighbours ∖ {pkt ↦ FAILED_XMIT}&#10;  end&#10;&#10;  event start_tx // (ctl) starting transmiting a packet to WiMedium&#10;  refines start_tx&#10;    any x pkt nbh&#10;    where&#10;      @g1 x ↦ pkt ∈ ndBuff // packet in waiting ndBuff&#10;      @g2 x ↦ pkt ∉ sentDown // but has not tranmitted to WiMedium&#10;      @g3 x ↦ pkt ∉ sentUp&#10;      @g4 x ↦ {pkt ↦ nbh} ∈ nbHops&#10;      @g5 pkt  ∈ dom(pktFwdr)&#10;      @g6 pkt ∈ dom(pktNbHops)&#10;    then&#10;      @a1 ndBuff ≔ ndBuff ∖{x↦pkt}&#10;      @a2 sentDown ≔ sentDown  ∪  {x ↦ pkt}&#10;      @a3 pktFwdr ≔pktFwdr {pkt↦x}&#10;      @a4 pktNbHops ≔ pktNbHops   {pkt ↦nbh}&#10;      @a5 nbHops ≔ nbHops  ∖  {x ↦ {pkt ↦ nbh}}&#10;  end&#10;&#10;  event send_down refines assign_vPktData&#10;    any cn pkt sno src data fwdr nbh&#10;    where&#10;      @g1 cn ↦ pkt ∈ sentDown&#10;      @g2 cn ↦ pkt ∉ channel&#10;      @g3 pkt ∈ dom(pktSeqNo) ∧ sno = pktSeqNo(pkt)&#10;      @g4 pkt ∈ dom(pktSrc) ∧ src= pktSrc(pkt)&#10;      @g5 pkt ∈ dom(pktFwdr) ∧ fwdr = pktFwdr(pkt)&#10;      @g6 pkt ∈ dom(pktData) ∧ data = pktData(pkt)&#10;      @g7 pkt ∈ dom(pktNbHops) ∧ nbh = pktNbHops(pkt)&#10;      @g8 pkt ∉ dom(vPktSeqNo)&#10;      @g10 pkt ∉ dom(vPktFwdr)&#10;      @g9 pkt ∉ dom(vPktSrc)&#10;      @g11 pkt ∉ dom(vPktData)&#10;      @g12 pkt ∉ dom(vPktNbHops)&#10;    then&#10;      @a1 channel ≔ channel ∪ {cn ↦ pkt}&#10;      @a2 vPktSeqNo ≔ vPktSeqNo  ∪ {pkt ↦ sno}&#10;      @a3 vPktSrc ≔ vPktSrc ∪ {pkt   ↦   src}&#10;      @a4 vPktFwdr ≔  vPktFwdr ∪ {pkt   ↦ fwdr}&#10;      @a5 vPktData ≔ vPktData ∪ {pkt   ↦ data}&#10;      @a6 vPktNbHops ≔ vPktNbHops ∪ {pkt   ↦ nbh}&#10;      @a7 pktSeqNo ≔  {pkt} ⩤ pktSeqNo&#10;      @a8 pktSrc ≔  {pkt} ⩤ pktSrc&#10;      @a9 pktFwdr ≔ {pkt}  ⩤ pktFwdr&#10;      @a10 pktData ≔  {pkt} ⩤ pktData&#10;      @a11 pktNbHops ≔  {pkt} ⩤ pktNbHops&#10;  end&#10;&#10;  event find_neighbour&#10;    any s nbs f pkt&#10;    where&#10;      @g1 channel ≠ ∅&#10;      @g2 pkt ∈ ran(channel)&#10;      @g3 s = initialSrcAddr(pkt)&#10;      @g4 f ↦pkt ∈ channel&#10;      @g5 nbs ⊆ ND ∧nbs = wsnLinks[{f}] ∧ nbs ≠ ∅ // find all neighbours of current forwarder&#10;      @g6 envNeighbours = ∅&#10;    then&#10;      @a2 envNeighbours ≔ envNeighbours  ∪ ({pkt} ×nbs)&#10;  end&#10;&#10;  event assign_forwarder&#10;    any s nb pkt f nbs&#10;    where&#10;      @g1 channel ≠ ∅&#10;      @g2 pkt ∈ ran(channel)&#10;      @g3 s = initialSrcAddr(pkt)&#10;      @g4 f ↦pkt ∈ channel&#10;      @g5 nbs = wsnLinks[{f}] ∧ nbs ≠ ∅&#10;      @g6 nb ∈ nbs // find all neighbours of current forwarder&#10;    then&#10;      @a2 envNeighbours ≔ envNeighbours  ∪ {pkt ↦ nb}&#10;  end&#10;&#10;  event lose_all_neighbours&#10;    any s nbs f pkt&#10;    where&#10;      @g1 channel ≠ ∅&#10;      @g2 pkt ∈ ran(channel)&#10;      @g3 s = initialSrcAddr(pkt)&#10;      @g4 f ↦pkt ∈ channel&#10;      @g5 nbs = wsnLinks[{f}] ∧ nbs = ∅ // find all neighbours of current forwarder&#10;    then&#10;      @a2 envNeighbours ≔ envNeighbours  ∪ {pkt ↦FAILED_XMIT}&#10;  end&#10;&#10;  event lose_specifc_neighbours&#10;    any s nbs f pkt&#10;    where&#10;      @g1 channel ≠ ∅&#10;      @g2 pkt ∈ ran(channel)&#10;      @g3 s = initialSrcAddr(pkt)&#10;      @g4 f ↦pkt ∈ channel&#10;      @g5 nbs = wsnLinks[{f}] ∧ nbs ≠ ∅  // find all neighbours of current forwarder&#10;    then&#10;      @a2 envNeighbours ≔ envNeighbours  ∪ {pkt ↦FAILED_XMIT}&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  refines indicate_neighbours&#10;    any pkt nbrs f sno src fwdr data nbh&#10;    where&#10;      @g1 pkt ∈ ran(sentDown)&#10;      @g2 f ↦ pkt ∈ sentDown&#10;      @g3 f ↦ pkt  ∉ sentUp&#10;      @g4 f ↦ pkt  ∈ channel // ready to remove current pket from channel&#10;      @g5 nbrs ∈ {n∣n ∈ (ℙ(ND)) ∪ {{FAILED_XMIT}}}&#10;      @g6 nbrs ≠ ∅ // @g5 ∀nb · nb ∈ nbrs ∧ nb ↦ pkt   ∉ ndBuff&#10;      @g7 ran({pkt} ◁ envNeighbours) ∈ (ℙ(ND) ∪ {{FAILED_XMIT}})&#10;      @g8 nbrs = ran({pkt} ◁ envNeighbours)  ∧ nbrs ≠ ∅ // update neghbours at env to ct      l&#10;      @g9 pkt ∉ dom(ctlNeighbours)&#10;      @g10 pkt ∈ dom(vPktSeqNo) ∧ sno = vPktSeqNo(pkt)&#10;      @g11 pkt ∈ dom(vPktSrc) ∧ src = vPktSrc(pkt)&#10;      @g12 pkt ∈ dom(vPktFwdr) ∧ fwdr = vPktFwdr(pkt)&#10;      @g13 pkt ∈ dom(vPktData) ∧ data = vPktData(pkt)&#10;      @g14 pkt ∈ dom(vPktNbHops) ∧ nbh = vPktNbHops(pkt)&#10;      @g17 pkt ∉ dom(pktSeqNo)&#10;      @g18 pkt ∉ dom(pktSrc)&#10;      @g19 pkt ∉ dom(pktFwdr)&#10;      @g20 pkt ∉ dom(pktData)&#10;      @g21 pkt ∉ dom(pktNbHops)&#10;    then&#10;      @a1 ctlNeighbours ≔ ctlNeighbours ∪({pkt}× nbrs)&#10;      @a2 envNeighbours ≔ ∅&#10;      @a3 channel ≔ channel ∖ {f ↦pkt}&#10;      @a4 sentDown ≔ sentDown  ∖ {f ↦ pkt}&#10;      @a5 sentUp ≔ sentUp ∪ {f ↦ pkt  }&#10;      @a6 pktSeqNo ≔ pktSeqNo  ∪ {pkt ↦ sno}&#10;      @a7 pktSrc ≔ pktSrc ∪ {pkt   ↦   src}&#10;      @a8 pktFwdr ≔ pktFwdr ∪ {pkt   ↦ fwdr}&#10;      @a9 pktData ≔ pktData ∪ {pkt   ↦ data}&#10;      @a10 pktNbHops ≔ pktNbHops  ∪ {pkt  ↦nbh}&#10;      @a11 vPktSeqNo ≔  {pkt} ⩤ vPktSeqNo&#10;      @a12 vPktSrc ≔  {pkt} ⩤ vPktSrc&#10;      @a13 vPktFwdr ≔  {pkt} ⩤ vPktFwdr&#10;      @a14 vPktData ≔  {pkt} ⩤ vPktData&#10;      @a15 vPktNbHops ≔  {pkt} ⩤ vPktNbHops&#10;  end&#10;&#10;  event receive_pkt refines receive_pkt&#10;    any s nb pkt nbh f&#10;    where&#10;      @g0 pkt ∈ ran(sentUp ∪ sentDown)&#10;      @g1 pkt  ↦ nb ∈ ctlNeighbours&#10;      @g2 nb ↦ pkt ∉   ndBuff // @g3 nb ∈ dom(recvNbrFlg) ∧ recvNbrFlg(nb) = FALSE&#10;      @g3 nb ∉ dom(sentUp ∪ sentDown)&#10;      @g4 s = initialSrcAddr(pkt) ∧ s ≠ nb&#10;      @g5 pkt ∈ dom(finalDestAddr) ∧ nb ≠ finalDestAddr(pkt)&#10;      @g6 nb ∈ dom(floodTbl)  ∧pkt ∉ floodTbl(nb) // not is duplicted packet&#10;      //@g7 type(pkt) = DATA&#10;      @g8 pkt ∈ dom(pktNbHops) ∧ nbh = pktNbHops(pkt) + 1&#10;      @g9 pkt ↦ f ∈   pktFwdr&#10;    then&#10;      @a1 ndBuff ≔ ndBuff ∪ {nb ↦pkt}&#10;      @a2 ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}&#10;      @a3 floodTbl(nb) ≔  floodTbl(nb) ∪ {pkt}&#10;      @a4 nbHops ≔  nbHops ∪  {nb ↦ {pkt ↦ nbh}}&#10;  end&#10;&#10;  event receive_dup_pkt extends receive_dup_pkt&#10;    any f&#10;    where&#10;      @g5 pkt ↦ f ∈   pktFwdr&#10;  end&#10;&#10;  event dest_recv_dataPkt // (ctl) Destination receives a packet&#10;  refines dest_recv_dataPkt&#10;    any s des pkt data f&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∈ dom(finalDestAddr) ∧ des = finalDestAddr(pkt)&#10;      @g3 des ∈dom(destBuff)&#10;      @g4 pkt ∈ ran(sentUp ∪ sentDown)∖destBuff(des)&#10;      @g5 s = initialSrcAddr(pkt)&#10;      @g6 {pkt} ◁ ctlNeighbours ≠ ∅ // returned by initial env event indicate_neighbour&#10;      @g7 ran({pkt} ◁ ctlNeighbours)  ≠ {FAILED_XMIT}&#10;      @g8 des ∈ ( ran({pkt} ◁ ctlNeighbours) ) // neighbour who is a sink&#10;      @g9 des ∈ dom(recvedData)&#10;      @g10 pkt ∈ dom(pktData) ∧ data = pktData(pkt)&#10;      @g11 type(pkt) = DATA&#10;      @g12 pkt ↦ f ∈   pktFwdr&#10;    then&#10;      @a1 destBuff(des) ≔ destBuff(des) ∪ {pkt}&#10;      @a2 ctlNeighbours ≔ ctlNeighbours ∖ {pkt ↦des}&#10;      @a3 floodTbl(des) ≔  floodTbl(des) ∪ {pkt}&#10;      @a4 recvedData(des) ≔ recvedData(des) ∪ {data}&#10;  end&#10;&#10;  event dest_recv_fldpkt // (ctl) Destination receives a packet&#10;  refines dest_recv_fldpkt&#10;    any s des pkt f&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∈ dom(finalDestAddr) ∧ des = finalDestAddr(pkt)&#10;      @g3 des ∈dom(destBuff)&#10;      @g4 pkt ∈ ran(sentUp ∪ sentDown)∖destBuff(des)&#10;      @g5 s = initialSrcAddr(pkt)&#10;      @g6 {pkt} ◁ ctlNeighbours ≠ ∅ // returned by initial env event indicate_neighbour&#10;      @g7 ran({pkt} ◁ ctlNeighbours)  ≠ {FAILED_XMIT}&#10;      @g8 des ∈ ( ran({pkt} ◁ ctlNeighbours) ) // neighbour who is a sink&#10;      //@g9 des ∈ dom(recvedData)&#10;      @g11 type(pkt) ∈ CONTROL&#10;      @g12 pkt ↦ f ∈   pktFwdr&#10;    then&#10;      @a1 destBuff(des) ≔ destBuff(des) ∪ {pkt}&#10;      @a2 ctlNeighbours ≔ ctlNeighbours ∖ {pkt ↦des}&#10;      @a3 floodTbl(des) ≔  floodTbl(des) ∪ {pkt}&#10;  end&#10;&#10;  event activating extends activating&#10;  end&#10;&#10;  event no_activating extends no_activating&#10;  end&#10;&#10;  event reset_activatingStatus extends reset_activatingStatus&#10;  end&#10;&#10;  event finish_tx_pkt // (ctl) removes packet from network for transit tx&#10;  refines finish_tx_pkt&#10;    any pkt f&#10;    where&#10;      @g1 {pkt} ◁ctlNeighbours = ∅ // all neighbours receive transmitted packet pkt&#10;      @g2 f ∈ ND ∧  f ↦pkt∈ sentUp&#10;      @g3 pkt ∈  ran(sentUp) ∧ pkt ∉ ran(sentDown) ∧ pkt ∈ ran(ndBuff) // in WiMedium and still transited in another nodes&#10;    then&#10;      @a1 sentUp ≔  sentUp   ∖ {f↦pkt}&#10;  end&#10;&#10;  event final_tx_pkt // (ctl) remove data packet from network indicating completion of tx&#10;  refines final_tx_pkt&#10;    any pkt sk&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∈  ran(sentUp)  ∧ pkt ∉ ran(sentDown) ∧ pkt ∉ ran(ndBuff) // in WiMedium and not transited in another nodes&#10;      @g3 pkt ∈ dom(finalDestAddr) ∧sk = finalDestAddr(pkt)&#10;      @g4 sk ∈ ND&#10;      @g5 pkt ∈destBuff(sk)&#10;      @g8 {pkt} ◁ctlNeighbours = ∅ // all neighbours receive transmitted packet pkt&#10;    then&#10;      @a1 sentUp ≔  sentUp   ⩥ {pkt}&#10;  end&#10;&#10;  event clear_pkt refines clear_pkt&#10;    any pkt&#10;    where&#10;      @g1 (sentDown ∪ sentUp) = ∅ ∧ ndBuff = ∅&#10;      @g2 pkt ∈ dom(finalDestAddr)&#10;      @g3 pkt ∈ dom(pktData)&#10;      @g4 pkt ∈ dom(pktSeqNo)&#10;      @g5 pkt ∈ dom(pktFwdr)&#10;      @g6 pkt ∈ dom(pktNbHops)&#10;    then&#10;      @a1 finalDestAddr ≔  {pkt} ⩤ finalDestAddr&#10;      @a2 pktData ≔  {pkt} ⩤ pktData&#10;      @a3 pktSeqNo ≔  {pkt} ⩤ pktSeqNo&#10;      @a4 pktFwdr ≔  {pkt} ⩤ pktFwdr&#10;      @a5 pktNbHops ≔  {pkt} ⩤ pktNbHops&#10;  end&#10;end&#10;" version="5">
