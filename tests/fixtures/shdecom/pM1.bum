<org.eventb.core.action name="_niA6Ugk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="pktData ≔ ∅" org.eventb.core.label="MPacket_int_2"/>
<org.eventb.core.action name="_niA6Uwk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="createdPkts ≔ ∅" org.eventb.core.label="MPacket_int_3"/>
<org.eventb.core.action name="_niA6VAk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="ndBuff ≔ ∅" org.eventb.core.label="MNDBuffer_int_1"/>
<org.eventb.core.action name="_niA6VQk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="sentUp≔ ∅" org.eventb.core.label="MSend_int_1"/>
<org.eventb.core.action name="_niA6Vgk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="sentDown≔ ∅" org.eventb.core.label="MSend_int_2"/>
<org.eventb.core.action name="_niA6Vwk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="ctlNeighbours ≔ ∅" org.eventb.core.label="MSend_int_3"/>
<org.eventb.core.action name="_niA6WAk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="destBuff ≔ ∅" org.eventb.core.label="MDestBuffer_int_1"/>
<org.eventb.core.action name="_niA6WQk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="recvBuff ≔ ∅" org.eventb.core.label="MReceive_int_1"/>
<org.eventb.core.action name="_niA6Wgk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="clrRecvBuffFlg ≔ ∅" org.eventb.core.label="MReceive_int_2"/>
</org.eventb.core.event>
