</org.eventb.core.event>
<org.eventb.core.event name="_xTHljCPBEeWw7avYyJIc7e" org.eventb.core.comment="(ctl) alerting emergency: sensed data is above safety threshold" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="actuating">
