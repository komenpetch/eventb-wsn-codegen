<org.eventb.core.refinesEvent name="'" org.eventb.core.target="create_controlPkt"/>
</org.eventb.core.event>
<org.eventb.core.variable name="_dITCsJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) number of sent flood packets, used for cost-estimation ------------------------- var of M3" org.eventb.core.identifier="totalSentBcon"/>
<org.eventb.core.variable name="_dITCsZdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) link sequence number in a packet, used for cost-estimation" org.eventb.core.identifier="netSeqNo"/>
<org.eventb.core.variable name="_dITCspdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) link sequence number of each node" org.eventb.core.identifier="linkSeqNo"/>
<org.eventb.core.variable name="_dITpwJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) for update neighbours in the neighbour table" org.eventb.core.identifier="updateNbrs"/>
<org.eventb.core.variable name="_dITpwZdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) neighbour table structure" org.eventb.core.identifier="neighbourTbl"/>
<org.eventb.core.variable name="_dITpwpdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) neighbour table: field missed (number of lost packet)" org.eventb.core.identifier="missed"/>
<org.eventb.core.variable name="_dIUQ0JdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) neighbour table: field received (number of received packets)" org.eventb.core.identifier="received"/>
<org.eventb.core.variable name="_dIUQ0ZdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) neighbur table: field lastSeqno in the neighbour table&#9;" org.eventb.core.identifier="lastSeqno"/>
<org.eventb.core.variable name="_dIUQ0pdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) neighbour table: field receiveEst (reception link quality) " org.eventb.core.identifier="receiveEst"/>
<org.eventb.core.variable name="_dIUQ05drEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) estimation nodes" org.eventb.core.identifier="estNDs"/>
<org.eventb.core.variable name="_dIU34JdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) estimation neighbours" org.eventb.core.identifier="estNbrs"/>
<org.eventb.core.invariant name="_dIU34ZdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_1" org.eventb.core.predicate="totalSentBcon ∈ ND →ℕ"/>
<org.eventb.core.invariant name="_dIU34pdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_3" org.eventb.core.predicate="netSeqNo ∈ PKT → ℕ"/>
<org.eventb.core.invariant name="_dIVe8JdrEeS7UZUzQZNbaA" org.eventb.core.comment="forwarder &lt;-&gt; neighbours" org.eventb.core.label="inv3_4" org.eventb.core.predicate="updateNbrs ∈ ND ↔ ND"/>
<org.eventb.core.invariant name="_dIVe8ZdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_5" org.eventb.core.predicate="neighbourTbl ∈ ND  ↔ ND"/>
<org.eventb.core.invariant name="_dIVe8pdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_6" org.eventb.core.predicate="missed ∈ neighbourTbl → ℕ"/>
<org.eventb.core.invariant name="_dIWGAJdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_7" org.eventb.core.predicate="received ∈ neighbourTbl → ℕ"/>
<org.eventb.core.invariant name="_dIWGAZdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_8" org.eventb.core.predicate="lastSeqno ∈ neighbourTbl →ℕ"/>
<org.eventb.core.invariant name="_dIWtEJdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_9" org.eventb.core.predicate="receiveEst ∈ neighbourTbl → ℕ"/>
<org.eventb.core.invariant name="_dIWtEZdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_10" org.eventb.core.predicate="linkSeqNo ∈ ND → ℕ"/>
<org.eventb.core.invariant name="_dIWtEpdrEeS7UZUzQZNbaA" org.eventb.core.label="int3_12" org.eventb.core.predicate="estNDs ⊆ ND"/>
<org.eventb.core.invariant name="_dIXUIJdrEeS7UZUzQZNbaA" org.eventb.core.label="inv3_13" org.eventb.core.predicate="estNbrs ⊆ neighbourTbl"/>
<org.eventb.core.event name="_dIXUIZdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) starting transmiting a data packet to a channel" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="start_tx_dataPkt">
<org.eventb.core.refinesEvent name="_dIXUIpdrEeS7UZUzQZNbaA" org.eventb.core.target="start_tx"/>
<org.eventb.core.guard name="_dIX7MJdrEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="type(pkt) = DATA"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIX7MZdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) starting transmiting a beacon packet to a channel" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="start_tx_bconPkt">
<org.eventb.core.refinesEvent name="_dIX7MpdrEeS7UZUzQZNbaA" org.eventb.core.target="start_tx"/>
<org.eventb.core.parameter name="_dIX7M5drEeS7UZUzQZNbaA" org.eventb.core.identifier="lsno"/>
<org.eventb.core.guard name="_dIYiQJdrEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="type(pkt) = BEACON"/>
<org.eventb.core.guard name="_dIYiQZdrEeS7UZUzQZNbaA" org.eventb.core.label="g8" org.eventb.core.predicate="x ∈ dom(totalSentBcon) ∧ totalSentBcon(x) ≥ 0"/>
<org.eventb.core.guard name="_dIYiQpdrEeS7UZUzQZNbaA" org.eventb.core.comment="calculate the link sequence number from the recent number" org.eventb.core.label="g9" org.eventb.core.predicate="lsno = linkSeqNo(x) + 1 ∧ x ∈ dom(linkSeqNo)"/>
<org.eventb.core.action name="_dIYiQ5drEeS7UZUzQZNbaA" org.eventb.core.assignment="totalSentBcon(x) ≔ totalSentBcon(x) + 1" org.eventb.core.label="a6"/>
<org.eventb.core.action name="_dIZJUJdrEeS7UZUzQZNbaA" org.eventb.core.assignment="linkSeqNo ≔  linkSeqNo{x↦lsno}" org.eventb.core.comment="update the current sequence number of node x" org.eventb.core.label="a7"/>
<org.eventb.core.action name="_dIZJUZdrEeS7UZUzQZNbaA" org.eventb.core.assignment="netSeqNo(pkt) ≔ lsno" org.eventb.core.comment="update the current sequence number into a flood packet" org.eventb.core.label="a8"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIZJUpdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) starting transmiting a control packet to a channel" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="start_tx_controlPkt">
<org.eventb.core.refinesEvent name="_dIZwYJdrEeS7UZUzQZNbaA" org.eventb.core.target="start_tx"/>
<org.eventb.core.parameter name="_dIZwYZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="lsno"/>
<org.eventb.core.guard name="_dIZwYpdrEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="type(pkt) ≠ BEACON"/>
<org.eventb.core.guard name="_dIZwY5drEeS7UZUzQZNbaA" org.eventb.core.label="g8" org.eventb.core.predicate="lsno ∈ ℕ"/>
<org.eventb.core.action name="_dIZwZJdrEeS7UZUzQZNbaA" org.eventb.core.assignment="netSeqNo(pkt) ≔ lsno" org.eventb.core.label="a6"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaN" org.eventb.core.comment="(shd) sending a packet down to a channel" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="send_down">
<org.eventb.core.refinesEvent name="'" org.eventb.core.target="send_down"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaO" org.eventb.core.comment="(env) channel finds the neighbour list of the forwarder" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="find_neighbours">
<org.eventb.core.refinesEvent name="'" org.eventb.core.target="find_neighbours"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaP" org.eventb.core.comment="(env) channel assigns specific forwarder - preparing for unicast for later refinement" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="assign_forwarder">
<org.eventb.core.refinesEvent name="'" org.eventb.core.target="assign_forwarder"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaR" org.eventb.core.comment="(env) channel sends the neighbour information" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="send_up">
<org.eventb.core.refinesEvent name="'" org.eventb.core.target="send_up"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIaXcJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) each neighbour node receives a data pacekt " org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="receive_dataPkt">
<org.eventb.core.refinesEvent name="_dIaXcZdrEeS7UZUzQZNbaA" org.eventb.core.target="receive_pkt"/>
<org.eventb.core.guard name="_dIaXcpdrEeS7UZUzQZNbaA" org.eventb.core.label="g9" org.eventb.core.predicate="type(pkt) = DATA"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIa-gJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) each neighbour node discards a duplicated data packet" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="receive_dup_dataPkt">
<org.eventb.core.refinesEvent name="_dIa-gZdrEeS7UZUzQZNbaA" org.eventb.core.target="receive_dup_pkt"/>
<org.eventb.core.guard name="_dIa-gpdrEeS7UZUzQZNbaA" org.eventb.core.label="g31" org.eventb.core.predicate="type(pkt) = DATA"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIa-g5drEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) each neighbour node receives a control packet" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="receive_controlPkt">
<org.eventb.core.refinesEvent name="_dIblkJdrEeS7UZUzQZNbaA" org.eventb.core.target="receive_pkt"/>
<org.eventb.core.parameter name="_dIblkZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="f"/>
<org.eventb.core.guard name="_dIblkpdrEeS7UZUzQZNbaA" org.eventb.core.label="g9" org.eventb.core.predicate="type(pkt) ∈ CONTROL"/>
<org.eventb.core.guard name="_dIblk5drEeS7UZUzQZNbaA" org.eventb.core.label="g10" org.eventb.core.predicate="pkt ∈ dom(pktFwdr) ∧ f= pktFwdr(pkt)"/>
<org.eventb.core.guard name="_dIcMoJdrEeS7UZUzQZNbaA" org.eventb.core.label="g11" org.eventb.core.predicate="f ∈ ND ∧ nb ∈ ND"/>
<org.eventb.core.guard name="_dIcMoZdrEeS7UZUzQZNbaA" org.eventb.core.comment="nb has not considered to update in the neighbour table yet" org.eventb.core.label="g12" org.eventb.core.predicate="f ↦ nb ∉ updateNbrs"/>
<org.eventb.core.action name="_dIcMopdrEeS7UZUzQZNbaA" org.eventb.core.assignment="updateNbrs ≔ updateNbrs ∪ {f ↦nb}" org.eventb.core.comment="put nb into updateNbrs for update it into the neighbour table later" org.eventb.core.label="a6"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIczsJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) each neighbour node receives a duplicated control packet" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="receive_dup_controlPkt">
<org.eventb.core.refinesEvent name="_dIczsZdrEeS7UZUzQZNbaA" org.eventb.core.target="receive_dup_pkt"/>
<org.eventb.core.parameter name="_dIczspdrEeS7UZUzQZNbaA" org.eventb.core.identifier="f"/>
<org.eventb.core.guard name="_dIczs5drEeS7UZUzQZNbaA" org.eventb.core.label="g4" org.eventb.core.predicate="type(pkt) ∈ CONTROL"/>
<org.eventb.core.guard name="_dIdawJdrEeS7UZUzQZNbaA" org.eventb.core.label="g5" org.eventb.core.predicate="pkt ∈ dom(pktFwdr) ∧ f= pktFwdr(pkt)"/>
<org.eventb.core.guard name="_dIdawZdrEeS7UZUzQZNbaA" org.eventb.core.label="g6" org.eventb.core.predicate="f ∈ ND ∧ nb ∈ ND"/>
<org.eventb.core.guard name="_dIdawpdrEeS7UZUzQZNbaA" org.eventb.core.comment="nb has not considered to update in the neighbour table yet" org.eventb.core.label="g7" org.eventb.core.predicate="f ↦ nb ∉ updateNbrs"/>
<org.eventb.core.action name="_dIdaw5drEeS7UZUzQZNbaA" org.eventb.core.assignment="updateNbrs ≔ updateNbrs ∪ {f ↦nb}" org.eventb.core.comment="put nb into updateNbrs for update it into the neighbour table later" org.eventb.core.label="a2"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIeB0JdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) each neighbour node receives a data pacekt from a channel" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="sink_recv_dataPkt">
<org.eventb.core.refinesEvent name="_dIeB0ZdrEeS7UZUzQZNbaA" org.eventb.core.target="sink_recv_pkt"/>
<org.eventb.core.guard name="_dIeB0pdrEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="type(pkt) = DATA"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIeo4JdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) sink receives a control packet" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="sink_recv_controlPkt">
<org.eventb.core.refinesEvent name="_dIeo4ZdrEeS7UZUzQZNbaA" org.eventb.core.target="sink_recv_pkt"/>
<org.eventb.core.parameter name="_dIeo4pdrEeS7UZUzQZNbaA" org.eventb.core.identifier="f"/>
<org.eventb.core.guard name="_dIeo45drEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="type(pkt) ≠ DATA"/>
<org.eventb.core.guard name="_dIfP8JdrEeS7UZUzQZNbaA" org.eventb.core.label="g8" org.eventb.core.predicate="pkt ∈ dom(pktFwdr) ∧ f = pktFwdr(pkt)"/>
<org.eventb.core.guard name="_dIfP8ZdrEeS7UZUzQZNbaA" org.eventb.core.label="g9" org.eventb.core.predicate="f ∈ ND ∧ nb ∈ ND"/>
<org.eventb.core.guard name="_dIfP8pdrEeS7UZUzQZNbaA" org.eventb.core.comment="nb has not considered to update in the neighbour table yet" org.eventb.core.label="g10" org.eventb.core.predicate="f ↦ nb ∉ updateNbrs"/>
<org.eventb.core.action name="_dIfP85drEeS7UZUzQZNbaA" org.eventb.core.assignment="updateNbrs ≔ updateNbrs ∪ {f ↦nb}" org.eventb.core.comment="put nb into updateNbrs for update it into the neighbour table later" org.eventb.core.label="a4"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIf3AJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) add new entry into the neighbour table" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="add_newEntry">
<org.eventb.core.parameter name="_dIf3AZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="x"/>
<org.eventb.core.parameter name="_dIf3ApdrEeS7UZUzQZNbaA" org.eventb.core.identifier="y"/>
<org.eventb.core.guard name="_dIf3A5drEeS7UZUzQZNbaA" org.eventb.core.comment="there is some nodes that have to update thier neighbour table" org.eventb.core.label="g1" org.eventb.core.predicate="updateNbrs ≠ ∅"/>
<org.eventb.core.guard name="_dIgeEJdrEeS7UZUzQZNbaA" org.eventb.core.label="g2" org.eventb.core.predicate="x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs"/>
<org.eventb.core.guard name="_dIgeEZdrEeS7UZUzQZNbaA" org.eventb.core.comment="in case these new pairs don't appear in the neighbour table" org.eventb.core.label="g3" org.eventb.core.predicate="y ↦ x   ∉ neighbourTbl"/>
<org.eventb.core.guard name="_dIgeEpdrEeS7UZUzQZNbaA" org.eventb.core.label="g4" org.eventb.core.predicate="y ↦ x ↦ 0 ∉ missed"/>
<org.eventb.core.guard name="_dIhFIJdrEeS7UZUzQZNbaA" org.eventb.core.label="g5" org.eventb.core.predicate="y ↦ x ↦ 0 ∉ received"/>
<org.eventb.core.guard name="_dIhFIZdrEeS7UZUzQZNbaA" org.eventb.core.label="g6" org.eventb.core.predicate="y ↦ x ↦ 0 ∉ lastSeqno"/>
<org.eventb.core.guard name="_dIhFIpdrEeS7UZUzQZNbaA" org.eventb.core.comment="@g10 ctlNeighbours = ∅" org.eventb.core.label="g7" org.eventb.core.predicate="y ↦ x ↦ 0 ∉ receiveEst"/>
<org.eventb.core.action name="_dIhFI5drEeS7UZUzQZNbaA" org.eventb.core.assignment="neighbourTbl ≔ neighbourTbl  ∪ {y  ↦ x}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_dIhsMJdrEeS7UZUzQZNbaA" org.eventb.core.assignment="missed ≔ missed  ∪  {y ↦ x ↦ 0}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_dIhsMZdrEeS7UZUzQZNbaA" org.eventb.core.assignment="received ≔ received  ∪  {y ↦ x ↦ 0}" org.eventb.core.label="a3"/>
<org.eventb.core.action name="_dIhsMpdrEeS7UZUzQZNbaA" org.eventb.core.assignment="lastSeqno ≔ lastSeqno  ∪  {y ↦ x ↦ 0}" org.eventb.core.label="a4"/>
<org.eventb.core.action name="_dIhsM5drEeS7UZUzQZNbaA" org.eventb.core.assignment="receiveEst ≔ receiveEst  ∪  {y ↦ x ↦0}" org.eventb.core.label="a5"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIiTQJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) update receiving information into the neighbour table" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="update_nbr">
<org.eventb.core.parameter name="_dIiTQZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="x"/>
<org.eventb.core.parameter name="_dIiTQpdrEeS7UZUzQZNbaA" org.eventb.core.identifier="y"/>
<org.eventb.core.parameter name="_dIiTQ5drEeS7UZUzQZNbaA" org.eventb.core.identifier="sNo"/>
<org.eventb.core.parameter name="_dIi6UJdrEeS7UZUzQZNbaA" org.eventb.core.identifier="delta"/>
<org.eventb.core.parameter name="_dIi6UZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="pkt"/>
<org.eventb.core.guard name="_dIi6UpdrEeS7UZUzQZNbaA" org.eventb.core.comment="there is some nodes that have to update thier neighbour table" org.eventb.core.label="g1" org.eventb.core.predicate="updateNbrs ≠ ∅"/>
<org.eventb.core.guard name="_dIi6U5drEeS7UZUzQZNbaA" org.eventb.core.label="g2" org.eventb.core.predicate="x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs"/>
<org.eventb.core.guard name="_dIjhYJdrEeS7UZUzQZNbaA" org.eventb.core.comment="in case there is existing pairs in the neighbour table" org.eventb.core.label="g3" org.eventb.core.predicate="y ↦ x   ∈ neighbourTbl"/>
<org.eventb.core.guard name="_dIjhYZdrEeS7UZUzQZNbaA" org.eventb.core.label="g4" org.eventb.core.predicate="pkt ↦x ∈ pktFwdr"/>
<org.eventb.core.guard name="_dIjhYpdrEeS7UZUzQZNbaA" org.eventb.core.comment="retriving the sequence number from  the transmitted packet" org.eventb.core.label="g5" org.eventb.core.predicate="sNo = netSeqNo(pkt)"/>
<org.eventb.core.guard name="_dIjhY5drEeS7UZUzQZNbaA" org.eventb.core.comment="calculating the missed sequence number" org.eventb.core.label="g6" org.eventb.core.predicate="delta = sNo − lastSeqno(y ↦ x) −1"/>
<org.eventb.core.guard name="_dIkIcJdrEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="delta ≥ 0"/>
<org.eventb.core.guard name="_dIkIcZdrEeS7UZUzQZNbaA" org.eventb.core.comment=" " org.eventb.core.label="g8" org.eventb.core.predicate="type(pkt) = BEACON"/>
<org.eventb.core.guard name="_dIkIcpdrEeS7UZUzQZNbaA" org.eventb.core.label="g9" org.eventb.core.predicate="pkt ∈ ran(sentUp)"/>
<org.eventb.core.action name="_dIkvgJdrEeS7UZUzQZNbaA" org.eventb.core.assignment="received ≔ received    {y ↦ x ↦ (received(y ↦ x) + 1)}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_dIkvgZdrEeS7UZUzQZNbaA" org.eventb.core.assignment="lastSeqno ≔ lastSeqno    {y ↦ x ↦ sNo}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_dIkvgpdrEeS7UZUzQZNbaA" org.eventb.core.assignment="missed ≔ missed    {y ↦ x ↦ delta}" org.eventb.core.label="a3"/>
<org.eventb.core.action name="_dIkvg5drEeS7UZUzQZNbaA" org.eventb.core.assignment="updateNbrs ≔ updateNbrs ∖ {x ↦ y}" org.eventb.core.label="a4"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIlWkJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) preparing for update route packet for the later refinement" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="update_nbr2">
<org.eventb.core.parameter name="_dIlWkZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="x"/>
<org.eventb.core.parameter name="_dIlWkpdrEeS7UZUzQZNbaA" org.eventb.core.identifier="y"/>
<org.eventb.core.parameter name="_dIlWk5drEeS7UZUzQZNbaA" org.eventb.core.identifier="pkt"/>
<org.eventb.core.guard name="_dIl9oJdrEeS7UZUzQZNbaA" org.eventb.core.comment="there is some nodes that have to process something" org.eventb.core.label="g1" org.eventb.core.predicate="updateNbrs ≠ ∅"/>
<org.eventb.core.guard name="_dIl9oZdrEeS7UZUzQZNbaA" org.eventb.core.label="g2" org.eventb.core.predicate="x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs"/>
<org.eventb.core.guard name="_dIl9opdrEeS7UZUzQZNbaA" org.eventb.core.label="g3" org.eventb.core.predicate="y ↦ x   ∈ neighbourTbl"/>
<org.eventb.core.guard name="_dIl9o5drEeS7UZUzQZNbaA" org.eventb.core.label="g4" org.eventb.core.predicate="pkt ↦ x ∈   pktFwdr"/>
<org.eventb.core.guard name="_dImksJdrEeS7UZUzQZNbaA" org.eventb.core.comment="not from neither data or beacon packet" org.eventb.core.label="g5" org.eventb.core.predicate="type(pkt) ≠ DATA ∧ type(pkt) ≠ BEACON"/>
<org.eventb.core.guard name="_dImksZdrEeS7UZUzQZNbaA" org.eventb.core.label="g6" org.eventb.core.predicate="pkt ∈ ran(sentUp)"/>
<org.eventb.core.action name="_dImkspdrEeS7UZUzQZNbaA" org.eventb.core.assignment="updateNbrs ≔ updateNbrs ∖ {x ↦ y}" org.eventb.core.label="a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dInLwJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) due the link quality estimation" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="est_due">
<org.eventb.core.parameter name="_dInLwZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="x"/>
<org.eventb.core.guard name="_dInLwpdrEeS7UZUzQZNbaA" org.eventb.core.comment="the node that has not calculated quality estimation yet" org.eventb.core.label="g1" org.eventb.core.predicate="x ∈ ND ∖ estNDs"/>
<org.eventb.core.guard name="_dIny0JdrEeS7UZUzQZNbaA" org.eventb.core.label="g2" org.eventb.core.predicate="x ∈ dom (totalSentBcon) ∧ totalSentBcon(x) &gt; 0"/>
<org.eventb.core.guard name="_dIny0ZdrEeS7UZUzQZNbaA" org.eventb.core.comment="the number of transmitted packet reaches the estimation ratio" org.eventb.core.label="g3" org.eventb.core.predicate="totalSentBcon(x) mod EST_RATIO = 0"/>
<org.eventb.core.action name="_dIny0pdrEeS7UZUzQZNbaA" org.eventb.core.assignment="estNDs ≔ estNDs ∪ {x}" org.eventb.core.comment="update node x in estNDs for considering to update reception ratio" org.eventb.core.label="a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIny05drEeS7UZUzQZNbaA" org.eventb.core.comment="(cal) calculating and updating reception ratio in case no lost packets or lose packets in the middle of transmission" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="update_est">
<org.eventb.core.parameter name="_dIoZ4JdrEeS7UZUzQZNbaA" org.eventb.core.identifier="nd"/>
<org.eventb.core.parameter name="_dIoZ4ZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="nb"/>
<org.eventb.core.parameter name="_dIoZ4pdrEeS7UZUzQZNbaA" org.eventb.core.identifier="r"/>
<org.eventb.core.parameter name="_dIoZ45drEeS7UZUzQZNbaA" org.eventb.core.identifier="m"/>
<org.eventb.core.parameter name="_dIoZ5JdrEeS7UZUzQZNbaA" org.eventb.core.identifier="rt"/>
<org.eventb.core.parameter name="_dIpA8JdrEeS7UZUzQZNbaA" org.eventb.core.identifier="newAve"/>
<org.eventb.core.guard name="_dIpA8ZdrEeS7UZUzQZNbaA" org.eventb.core.comment="the link quality estimation period of node nd must be due" org.eventb.core.label="g1" org.eventb.core.predicate="nd ∈ estNDs"/>
<org.eventb.core.guard name="_dIpA8pdrEeS7UZUzQZNbaA" org.eventb.core.comment="finding the neighbours of node nd in the neighbour table" org.eventb.core.label="g2" org.eventb.core.predicate="nb ∈ ran({nd} ◁ neighbourTbl)"/>
<org.eventb.core.guard name="_dIpA85drEeS7UZUzQZNbaA" org.eventb.core.comment="node nd should transmit at least one packet" org.eventb.core.label="g3" org.eventb.core.predicate="nd ∈ dom(totalSentBcon) ∧ totalSentBcon(nd) &gt; 0"/>
<org.eventb.core.guard name="_dIpoAJdrEeS7UZUzQZNbaA" org.eventb.core.label="g4" org.eventb.core.predicate="nd ↦ nb ∈ dom(lastSeqno) ∧  lastSeqno(nd ↦ nb) &gt; 0"/>
<org.eventb.core.guard name="_dIpoAZdrEeS7UZUzQZNbaA" org.eventb.core.label="g5" org.eventb.core.predicate="r = received(nd ↦ nb)"/>
<org.eventb.core.guard name="_dIpoApdrEeS7UZUzQZNbaA" org.eventb.core.label="g6" org.eventb.core.predicate="m = missed(nd↦nb)"/>
<org.eventb.core.guard name="_dIpoA5drEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="rt =  EST_RATIO"/>
<org.eventb.core.guard name="_dIqPEJdrEeS7UZUzQZNbaA" org.eventb.core.comment="calculate the reception ratio" org.eventb.core.label="g8" org.eventb.core.predicate="newAve = ((r ∗ 100)÷rt)"/>
<org.eventb.core.guard name="_dIqPEZdrEeS7UZUzQZNbaA" org.eventb.core.label="g9" org.eventb.core.predicate="nd ↦ nb∈dom(receiveEst) ∧ newAve &gt;  0"/>
<org.eventb.core.guard name="_dIqPEpdrEeS7UZUzQZNbaA" org.eventb.core.label="g10" org.eventb.core.predicate="nd ↦ nb∈dom(missed)"/>
<org.eventb.core.guard name="_dIq2IJdrEeS7UZUzQZNbaA" org.eventb.core.label="g11" org.eventb.core.predicate="nd ↦ nb∈dom(received)"/>
<org.eventb.core.guard name="_dIq2IZdrEeS7UZUzQZNbaA" org.eventb.core.label="g12" org.eventb.core.predicate="nd  ↦ nb ∉ estNbrs"/>
<org.eventb.core.guard name="_dIq2IpdrEeS7UZUzQZNbaA" org.eventb.core.label="g13" org.eventb.core.predicate="estNbrs ≠ neighbourTbl"/>
<org.eventb.core.action name="_dIrdMJdrEeS7UZUzQZNbaA" org.eventb.core.assignment="receiveEst ≔ receiveEst    {nd ↦ nb ↦ newAve}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_dIrdMZdrEeS7UZUzQZNbaA" org.eventb.core.assignment="missed ≔ missed    {nd ↦ nb ↦ 0}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_dIrdMpdrEeS7UZUzQZNbaA" org.eventb.core.assignment="received ≔ received    {nd ↦ nb ↦ 0}" org.eventb.core.label="a3"/>
<org.eventb.core.action name="_dIrdM5drEeS7UZUzQZNbaA" org.eventb.core.assignment="estNbrs ≔ estNbrs ∪ {nd ↦ nb}" org.eventb.core.label="a4"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIrdNJdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) for case the dead neighbour node affecting sentEst become zero" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="update_est_nothing">
<org.eventb.core.parameter name="_dIsEQJdrEeS7UZUzQZNbaA" org.eventb.core.identifier="nd"/>
<org.eventb.core.parameter name="_dIsEQZdrEeS7UZUzQZNbaA" org.eventb.core.identifier="nb"/>
<org.eventb.core.parameter name="_dIsEQpdrEeS7UZUzQZNbaA" org.eventb.core.identifier="r"/>
<org.eventb.core.parameter name="_dIsEQ5drEeS7UZUzQZNbaA" org.eventb.core.identifier="m"/>
<org.eventb.core.parameter name="_dIsERJdrEeS7UZUzQZNbaA" org.eventb.core.identifier="rt"/>
<org.eventb.core.parameter name="_dIsrUJdrEeS7UZUzQZNbaA" org.eventb.core.identifier="newAve"/>
<org.eventb.core.guard name="_dIsrUZdrEeS7UZUzQZNbaA" org.eventb.core.label="g1" org.eventb.core.predicate="nd ∈ estNDs"/>
<org.eventb.core.guard name="_dIsrUpdrEeS7UZUzQZNbaA" org.eventb.core.label="g2" org.eventb.core.predicate="nb ∈ ran({nd} ◁ neighbourTbl)"/>
<org.eventb.core.guard name="_dIsrU5drEeS7UZUzQZNbaA" org.eventb.core.comment="node nd should transmit at least one packet" org.eventb.core.label="g3" org.eventb.core.predicate="nd ∈ dom(totalSentBcon) ∧ totalSentBcon(nd) &gt; 0"/>
<org.eventb.core.guard name="_dItSYJdrEeS7UZUzQZNbaA" org.eventb.core.label="g4" org.eventb.core.predicate="nd ↦ nb ∈ dom(lastSeqno) ∧  lastSeqno(nd ↦ nb) &gt; 0"/>
<org.eventb.core.guard name="_dItSYZdrEeS7UZUzQZNbaA" org.eventb.core.label="g5" org.eventb.core.predicate="r = received(nd ↦ nb)"/>
<org.eventb.core.guard name="_dItSYpdrEeS7UZUzQZNbaA" org.eventb.core.label="g6" org.eventb.core.predicate="m = missed(nd↦nb)"/>
<org.eventb.core.guard name="_dItSY5drEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="rt = EST_RATIO ∧ rt &gt; 0"/>
<org.eventb.core.guard name="_dIt5cJdrEeS7UZUzQZNbaA" org.eventb.core.comment="calculate the reception ratio" org.eventb.core.label="g8" org.eventb.core.predicate="newAve = ((r ∗ 100)÷rt)"/>
<org.eventb.core.guard name="_dIt5cZdrEeS7UZUzQZNbaA" org.eventb.core.label="g9" org.eventb.core.predicate="newAve = 0"/>
<org.eventb.core.guard name="_dIt5cpdrEeS7UZUzQZNbaA" org.eventb.core.label="g10" org.eventb.core.predicate="nd  ↦ nb ∉ estNbrs"/>
<org.eventb.core.guard name="_dIuggJdrEeS7UZUzQZNbaA" org.eventb.core.label="g11" org.eventb.core.predicate="estNbrs ≠  neighbourTbl"/>
<org.eventb.core.action name="_dIuggZdrEeS7UZUzQZNbaA" org.eventb.core.assignment="estNbrs ≔ estNbrs ∪ {nd ↦ nb}" org.eventb.core.label="a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_dIuggpdrEeS7UZUzQZNbaA" org.eventb.core.comment="(ctl) reseting estimation timer for the next round" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="reset_estTimer">
<org.eventb.core.guard name="_dIvHkJdrEeS7UZUzQZNbaA" org.eventb.core.label="g1" org.eventb.core.predicate="estNDs = ND"/>
<org.eventb.core.guard name="_dIvHkZdrEeS7UZUzQZNbaA" org.eventb.core.label="g2" org.eventb.core.predicate="totalSentBcon ≠ ∅"/>
<org.eventb.core.guard name="_dIvHkpdrEeS7UZUzQZNbaA" org.eventb.core.comment=" " org.eventb.core.label="g3" org.eventb.core.predicate="estNbrs =  neighbourTbl"/>
<org.eventb.core.action name="_dIvHk5drEeS7UZUzQZNbaA" org.eventb.core.assignment="estNDs ≔ ∅" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_dIvHlJdrEeS7UZUzQZNbaA" org.eventb.core.assignment="estNbrs ≔ ∅" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_dIvHlZdrEeS7UZUzQZNbaA" org.eventb.core.assignment="totalSentBcon ≔ ND × {0}" org.eventb.core.label="a3"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaW" org.eventb.core.comment="(ctl) finishing packet transmission" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="finish_tx_pkt">
<org.eventb.core.refinesEvent name="'" org.eventb.core.target="finish_tx_pkt"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaX" org.eventb.core.comment="(ctl) the transmitted packet is removed from middleware indicating completion of transmission mechanism" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="final_tx_pkt ">
<org.eventb.core.refinesEvent name="_7UD0sHM7EeWkEMfLnDLuAw" org.eventb.core.target="final_tx_pkt"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaY" org.eventb.core.comment="(ctl) the transmitted packet is removed from middleware indicating completion of transmission mechanism" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="final_tx_controlPkt">
<org.eventb.core.refinesEvent name="_7UD0sXM7EeWkEMfLnDLuAw" org.eventb.core.target="final_tx_controlPkt"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaQ" org.eventb.core.comment="(env) channel loses all neighbuor" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="lose_all_neighbours">
<org.eventb.core.refinesEvent name="'" org.eventb.core.target="lose_all_neighbours"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaV" org.eventb.core.comment="(ctl) each node records a lost packet" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="lose_pkt">
<org.eventb.core.refinesEvent name="'" org.eventb.core.target="lose_pkt"/>
</org.eventb.core.event>
</org.eventb.core.machineFile>
