<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.contextFile org.eventb.core.comment="/* Defines objects, root object and&#10;   transitive closure of relations on objects,&#10;   and introduces some theorems used for discharging OPs. " org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1435932972003" org.eventb.texttools.text_representation="context TCL&#10;/* /* Defines objects, root object and&#10;   transitive closure of relations on objects,&#10;   and introduces some theorems used for discharging OPs. */&#10; extends C2&#10;&#10;constants tcl // transitive closure of an objrel&#10;          wsnfn // type of function on objects&#10;&#10;&#10;axioms&#10;  @axm2 wsnfn= ND ⇸ ND&#10;  @axm3 tcl ∈ WSN → WSN&#10;  @axm5 ∀r·(r∈WSN ⇒   r ⊆ tcl(r)) // r is included in tcl(r)&#10;  @axm6 ∀r·(r∈WSN ⇒   r;tcl(r) ⊆ tcl(r)) // forward composition of tcl(r) with r is included in tcl(r)&#10;  @axm7 ∀r,t·(r∈WSN ∧ r⊆t ∧ r;t⊆t   ⇒ tcl(r)⊆t) // tcl(r) is the smallest relation&#10;  theorem @thm5 wsnfn ⊆ WSN&#10;  theorem @thm1 ∀r·r∈WSN ⇒ tcl(r) = r ∪ (r;tcl(r)) // tcl(r) is a fixed point&#10;  theorem @thm2 ∀t·t∈wsnfn∧(∀s·s⊆t∼[s]⇒s=∅)⇒tcl(t)∩(ND ◁ id)=∅&#10;  /* No loop theorem:&#10;     $(!s.s&lt;:(t∼)[s] =&gt; s={})$&#10;     imples tcl(t) has no loops. */&#10;  theorem @thm3 tcl(∅) = ∅&#10;end" version="3">
<org.eventb.core.extendsContext name="_rO_FsCGFEeWBBdN5RKBVAg" org.eventb.core.target="C2"/>
<org.eventb.core.constant name="_rO_FsSGFEeWBBdN5RKBVAg" org.eventb.core.comment="transitive closure of an objrel" org.eventb.core.identifier="tcl"/>
<org.eventb.core.constant name="_rO_FsiGFEeWBBdN5RKBVAg" org.eventb.core.comment="type of function on objects" org.eventb.core.identifier="wsnfn"/>
<org.eventb.core.axiom name="_rO_FsyGFEeWBBdN5RKBVAg" org.eventb.core.label="axm2" org.eventb.core.predicate="wsnfn= ND ⇸ ND"/>
<org.eventb.core.axiom name="_rO_FtCGFEeWBBdN5RKBVAg" org.eventb.core.label="axm3" org.eventb.core.predicate="tcl ∈ WSN → WSN"/>
<org.eventb.core.axiom name="_rO_FtSGFEeWBBdN5RKBVAg" org.eventb.core.comment="r is included in tcl(r)" org.eventb.core.label="axm5" org.eventb.core.predicate="∀r·(r∈WSN ⇒   r ⊆ tcl(r))"/>
<org.eventb.core.axiom name="_rO_FtiGFEeWBBdN5RKBVAg" org.eventb.core.comment="forward composition of tcl(r) with r is included in tcl(r)" org.eventb.core.label="axm6" org.eventb.core.predicate="∀r·(r∈WSN ⇒   r;tcl(r) ⊆ tcl(r))"/>
<org.eventb.core.axiom name="_rO_FtyGFEeWBBdN5RKBVAg" org.eventb.core.comment="tcl(r) is the smallest relation" org.eventb.core.label="axm7" org.eventb.core.predicate="∀r,t·(r∈WSN ∧ r⊆t ∧ r;t⊆t   ⇒ tcl(r)⊆t)"/>
<org.eventb.core.axiom name="_rO_FuCGFEeWBBdN5RKBVAg" org.eventb.core.label="thm5" org.eventb.core.predicate="wsnfn ⊆ WSN" org.eventb.core.theorem="true"/>
<org.eventb.core.axiom name="_rO_FuSGFEeWBBdN5RKBVAg" org.eventb.core.comment="tcl(r) is a fixed point" org.eventb.core.label="thm1" org.eventb.core.predicate="∀r·r∈WSN ⇒ tcl(r) = r ∪ (r;tcl(r))" org.eventb.core.theorem="true"/>
<org.eventb.core.axiom name="_rO_FuiGFEeWBBdN5RKBVAg" org.eventb.core.comment="No loop theorem:&#10;     $(!s.s&lt;:(t∼)[s] =&gt; s={})$&#10;     imples tcl(t) has no loops. " org.eventb.core.label="thm2" org.eventb.core.predicate="∀t·t∈wsnfn∧(∀s·s⊆t∼[s]⇒s=∅)⇒tcl(t)∩(ND ◁ id)=∅" org.eventb.core.theorem="true"/>
<org.eventb.core.axiom name="_rO_FuyGFEeWBBdN5RKBVAg" org.eventb.core.label="thm3" org.eventb.core.predicate="tcl(∅) = ∅" org.eventb.core.theorem="true"/>
</org.eventb.core.contextFile>
