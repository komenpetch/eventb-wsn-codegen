</org.eventb.core.event>
<org.eventb.core.event name="_xTHljCPBEeWw7avYyJIc7b" org.eventb.core.comment="(ctl) not alerting emergency sensed data is below safety threshold " org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="no_actuating">
<org.eventb.core.refinesEvent name="'" org.eventb.core.target="no_actuating"/>
</org.eventb.core.event>
