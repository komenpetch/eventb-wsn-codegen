<org.eventb.core.event name="_JrKrpJZuEeSDW82aTOSJOQ" org.eventb.core.comment="creating a control packet" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="create_controlPkt">
