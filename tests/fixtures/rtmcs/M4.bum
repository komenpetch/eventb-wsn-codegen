<org.eventb.core.guard name="_IwYVxiPxEeWw7avYyJIc7Q" org.eventb.core.comment="there is some nodes that have to update thier neighbour table" org.eventb.core.label="g1" org.eventb.core.predicate="updateNbrs ≠ ∅"/>
<org.eventb.core.guard name="_IwY80CPxEeWw7avYyJIc7Q" org.eventb.core.label="g2" org.eventb.core.predicate="x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs"/>
<org.eventb.core.guard name="_IwY80SPxEeWw7avYyJIc7Q" org.eventb.core.label="g3" org.eventb.core.predicate="pkt ∈ dom(initialSrcAddr) ∧ s = initialSrcAddr(pkt)"/>
<org.eventb.core.guard name="_IwY80iPxEeWw7avYyJIc7Q" org.eventb.core.comment="in case these new pairs don't appear in the neighbour table" org.eventb.core.label="g4" org.eventb.core.predicate="y ↦ s   ∉ bwdRouteTbl"/>
<org.eventb.core.guard name="_IwZj4CPxEeWw7avYyJIc7Q" org.eventb.core.label="g5" org.eventb.core.predicate="pkt ↦x ∈ pktFwdr"/>
