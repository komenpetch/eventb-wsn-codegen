<org.eventb.core.guard name="_niNHoAk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MReceive_receive_g2" org.eventb.core.predicate="nb ↦ pkt ∉  recvBuff"/>
<org.eventb.core.guard name="_niNHoQk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_remove_ctlNeighbour_g1" org.eventb.core.predicate="nb ↦ pkt ∉ sentUp"/>
<org.eventb.core.guard name="_niNHogk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_remove_ctlNeighbour_g2" org.eventb.core.predicate="nb ↦ pkt ∉ sentDown"/>
<org.eventb.core.action name="_niNHowk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="recvBuff ≔ recvBuff ∪ {nb ↦pkt}" org.eventb.core.label="MReceive_receive_a1"/>
<org.eventb.core.action name="_niNHpAk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}" org.eventb.core.label="MSend_remove_ctlNeighbour_a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_niNHpQk_EeWZ6ayKi1-Bfw" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="clear_recvdBuff">
