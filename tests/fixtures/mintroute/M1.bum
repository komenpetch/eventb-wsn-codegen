</org.eventb.core.event>
<org.eventb.core.event name="_gyaCIZdZEeS7UZUzQZNbaA" org.eventb.core.comment="starting flooding (used for a control packet)" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="start_flooding">
