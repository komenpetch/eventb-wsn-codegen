<org.eventb.core.guard name="_niNHqgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MReceive_clear_recvdBuff_g3" org.eventb.core.predicate="nb ↦ pkt ∈ clrRecvBuffFlg"/>
<org.eventb.core.action name="_niNHqwk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="recvBuff ≔ recvBuff ∖ {nb ↦pkt}" org.eventb.core.label="MReceive_clear_recvdBuff_a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_niNHrAk_EeWZ6ayKi1-Bfw" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="fwdr_receive_pkt">
