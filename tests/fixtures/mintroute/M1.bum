<org.eventb.core.guard name="_JrKrn5ZuEeSDW82aTOSJOQ" org.eventb.core.label="g2" org.eventb.core.predicate="pkt ∉  ran(ndBuff ∪ WiMedium)"/>
<org.eventb.core.guard name="_MP5SIJZuEeSDW82aTOSJOQ" org.eventb.core.comment="has not been created yet" org.eventb.core.label="g3" org.eventb.core.predicate="s ∉ sensingNDs  ∧ pkt ∉ sensedPkts ∪  floodedPkts"/>
