<org.eventb.core.guard name="_JLFqyCPDEeWw7avYyJIc7Q" org.eventb.core.comment="in WiMedium and not transited in another nodes" org.eventb.core.label="g2" org.eventb.core.predicate="pkt ∈  ran(sentUp)  ∧ pkt ∉ ran(sentDown) ∧ pkt ∉ ran(ndBuff)"/>
<org.eventb.core.guard name="_JLFqySPDEeWw7avYyJIc7Q" org.eventb.core.label="g3" org.eventb.core.predicate="pkt ∈ dom(finalDestAddr) ∧sk = finalDestAddr(pkt)"/>
