<org.eventb.core.guard name="_xA5suSPEEeWw7avYyJIc7Q" org.eventb.core.label="g3" org.eventb.core.predicate="envSensedFlg(x) = TRUE"/>
<org.eventb.core.guard name="_xA5suiPEEeWw7avYyJIc7Q" org.eventb.core.label="g4" org.eventb.core.predicate="ctlSensedFlg(x) = TRUE"/>
<org.eventb.core.action name="_xA5suyPEEeWw7avYyJIc7Q" org.eventb.core.assignment="ctlSensedFlg(x) ≔ FALSE" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_xA5svCPEEeWw7avYyJIc7Q" org.eventb.core.assignment="envSensedFlg(x) ≔ FALSE" org.eventb.core.comment="@a3 sensingNDs ≔ ∅" org.eventb.core.label="a3"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xTHljCPBEeWw7avYyJIc7S" org.eventb.core.comment="creating a  data packet" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="create_dataPkt">
