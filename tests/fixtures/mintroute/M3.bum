<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1444917290399" org.eventb.texttools.text_representation="machine M3 refines M2  sees C3&#10;&#10;variables sinkBuff // a sink ndBuff&#10;          ndBuff // nodes' ndBuff&#10;          sensingNDs // (ctl)sensing nodes&#10;          sensedPkts // (ctl)sensed packets&#10;          senseBuff // (ctl) sense ndBuff&#10;          floodedPkts // (ctl)flooded packets&#10;          floodTbl // for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // record lost packet at each nodd&#10;          envSensedFlg // (env) sensing period&#10;          envData // (env) environmental/conditional data&#10;          ctlSensedFlg // (ctl)sensing period&#10;          sentDown // transmitted packet to channel ------------------------- var of M2&#10;          sentUp // transmitted packet up to channel&#10;          channel // channel&#10;          envNeighbours // (env) neighbour list&#10;          wsnLinks // (env) dynamic WSN links&#10;          floodFlg // flood flag&#10;          dataSeqNo // local nodes' current data sequence number at application layer&#10;          floodSeqNo // local nodes' current  broadcast sequence number at application layer&#10;          nbHops // neighbour's hop&#10;          crashedLinks // (env) cashed WSN Links&#10;          pktSrc // (ctl) src address attached in transmitted packet&#10;          pktSeqNo // sequence number attached in transmitted packet&#10;          pktFwdr // fowarder attached in transmitted packet&#10;          pktData // (ctl) data attached in transmitted packet&#10;          pktNbHops // nb hop attached in transmitted packet&#10;          vPktSeqNo // (env) virtual packet at channel&#10;          vPktSrc // (env) virtual packet at channel&#10;          vPktFwdr // (env) virtual packet at channel&#10;          vPktData // (env) virtual packet at channel&#10;          vPktNbHops // (env) virtual packet at chennel&#10;          totalSentBcon // number of sent flood packets, used for cost-estimation ------------------------- var of M3&#10;          netSeqNo // link sequence no in a packet, used for cost-estimation&#10;          linkSeqNo // link sequence number of each node&#10;          updateNbrs // for update neighbours in the neighbour table&#10;          neighbourTbl // neighbourTbl structure&#10;          missed // field missed (no of lost packets) in neighbour table&#10;          received // field received (no of received packets)  in neighbour table&#10;          lastSeqno // field lastSeqno in neighbour table&#10;          receiveEst // field receiveEst (reception link quality) in neighbour table&#10;          estNDs // estimation nodes&#10;          estNbrs // estimation neighbours&#10;&#10;&#10;invariants&#10;  @inv3_1 totalSentBcon ∈ ND →ℕ&#10;  @inv3_3 netSeqNo ∈ PKT → ℕ&#10;  @inv3_4 updateNbrs ∈ ND ↔ ND // forwarder &lt;-&gt; neighbours&#10;  @inv3_5 neighbourTbl ∈ ND  ↔ ND&#10;  @inv3_6 missed ∈ neighbourTbl → ℕ&#10;  @inv3_7 received ∈ neighbourTbl → ℕ&#10;  @inv3_8 lastSeqno ∈ neighbourTbl →ℕ&#10;  @inv3_9 receiveEst ∈ neighbourTbl → ℕ&#10;  @inv3_10 linkSeqNo ∈ ND → ℕ&#10;  @int3_12 estNDs ⊆ ND&#10;  @inv3_13 estNbrs ⊆ neighbourTbl&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @int3_1 totalSentBcon ≔ ND × {0}&#10;      @int3_2 netSeqNo ≔ PKT × {0}&#10;      @int3_3 updateNbrs ≔ ∅&#10;      @int3_4 neighbourTbl ≔ ∅&#10;      @int3_5 missed ≔ ∅&#10;      @int3_6 received ≔ ∅&#10;      @int3_7 lastSeqno ≔ ∅&#10;      @int3_8 receiveEst ≔ ∅&#10;      @int3_9 linkSeqNo ≔  ND × {0}&#10;      @int3_11 estNDs ≔ ∅&#10;      @int3_12 estNbrs ≔ ∅&#10;  end&#10;&#10;  event set_link // (env) channel sets a topology&#10;  extends set_link&#10;  end&#10;&#10;  event disconnect_link // (env) disconnecte/damage a link&#10;  extends disconnect_link&#10;  end&#10;&#10;  event recover_link // (env) recover a link&#10;  extends recover_link&#10;  end&#10;&#10;  event start_sensing extends start_sensing&#10;  end&#10;&#10;  event sensing extends sensing&#10;  end&#10;&#10;  event finish_sensing extends finish_sensing&#10;  end&#10;&#10;  event node_sense_pkt // (ctl)  create a packet&#10;  extends node_sense_pkt&#10;  end&#10;&#10;  event start_flooding extends start_flooding&#10;  end&#10;&#10;  event reset_flooding extends reset_flooding&#10;  end&#10;&#10;  event node_create_floodPkt // (ctl)  create a packet&#10;  extends node_create_floodPkt&#10;  end&#10;&#10;  event start_tx_dataPkt // (ctl) starting transmiting a packet to WiMedium&#10;  extends start_tx&#10;    where&#10;      @g21 type(pkt) = DATA&#10;  end&#10;&#10;  event start_tx_bconPkt // (ctl) starting transmiting a flood packet from ndBuff to lower layers (sentDown)&#10;  extends start_tx&#10;    any lsno&#10;    where&#10;      @g10 type(pkt) = BEACON&#10;      @g11 x ∈ dom(totalSentBcon) ∧ totalSentBcon(x) ≥ 0&#10;      @g12 lsno = linkSeqNo(x) + 1 ∧ x ∈ dom(linkSeqNo) // calculate the link sequence number from the recent number&#10;    then&#10;      @a10 totalSentBcon(x) ≔ totalSentBcon(x) + 1&#10;      @a11 linkSeqNo ≔  linkSeqNo{x↦lsno} // update the current sequence number of node x&#10;      @a12 netSeqNo(pkt) ≔ lsno // update the current sequence number into a flood packet&#10;  end&#10;&#10;  event start_tx_floodPkt // (ctl) starting transmiting a flood packet from ndBuff to lower layers (sentDown)&#10;  extends start_tx&#10;    any lsno&#10;    where&#10;      @g10 type(pkt) ≠ BEACON&#10;      @g11 lsno ∈ ℕ&#10;    then&#10;      @a10 netSeqNo(pkt) ≔ lsno&#10;  end&#10;&#10;  event send_down extends send_down&#10;  end&#10;&#10;  event find_neighbour // (env) channel finds neighbour&#10;  extends find_neighbour&#10;  end&#10;&#10;  event assign_forwarder // (env) channel assigns specific forwarder - preparing for unicast for later refinement&#10;  extends assign_forwarder&#10;  end&#10;&#10;  event lose_all_neighbours // (env) channel loes all neighbuor&#10;  extends lose_all_neighbours&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  extends send_up&#10;  end&#10;&#10;  event receive_dataPkt // (ctl) each neighbour node receives a data pacekt from channel&#10;  extends receive_pkt&#10;    where&#10;      @g31 type(pkt) = DATA&#10;  end&#10;&#10;  event receive_dup_dataPkt // (ctl) each neighbour node including sink receives a duplicated data packet from channel&#10;  extends receive_dup_pkt&#10;    where&#10;      @g31 type(pkt) = DATA&#10;  end&#10;&#10;  event receive_floodPkt // (ctl) each neighbour node receives a  flood pacekt from channel&#10;  extends receive_pkt&#10;    any f&#10;    where&#10;      @g12 type(pkt) ∈ CONTROL&#10;      @g13 pkt ∈ dom(pktFwdr) ∧ f= pktFwdr(pkt)&#10;      @g14 f ∈ ND ∧ nb ∈ ND&#10;      @g15 f ↦ nb ∉ updateNbrs // nb has not considered to update in the neighbour table yet&#10;    then&#10;      @a6 updateNbrs ≔ updateNbrs ∪ {f ↦nb} // put nb into updateNbrs for update it into the neighbour table later&#10;  end&#10;&#10;  event receive_dup_floodPkt // (ctl) each neighbour node including sink receives a duplicated flood packet from channel&#10;  extends receive_dup_pkt&#10;    any f&#10;    where&#10;      @g9 type(pkt) ∈ CONTROL&#10;      @g11 pkt ∈ dom(pktFwdr) ∧ f= pktFwdr(pkt)&#10;      @g12 f ∈ ND ∧ nb ∈ ND&#10;      @g13 f ↦ nb ∉ updateNbrs // nb has not considered to update in the neighbour table yet&#10;    then&#10;      @a4 updateNbrs ≔ updateNbrs ∪ {f ↦nb} // put nb into updateNbrs for update it into the neighbour table later&#10;  end&#10;&#10;  event sink_recv_dataPkt // (ctl) each neighbour node receives a data pacekt from channel&#10;  extends sink_recv_pkt&#10;    where&#10;      @g15 type(pkt) = DATA&#10;  end&#10;&#10;  event sink_recv_floodPkt // (ctl) sink receives a flood packet&#10;  extends sink_recv_pkt&#10;    any f&#10;    where&#10;      @g14 type(pkt) ≠ DATA&#10;      @grd1 pkt ∈ dom(pktFwdr) ∧ f = pktFwdr(pkt)&#10;      @g13 f ∈ ND ∧ nb ∈ ND&#10;      @g15 f ↦ nb ∉ updateNbrs // nb has not considered to update in the neighbour table yet&#10;    then&#10;      @a5 updateNbrs ≔ updateNbrs ∪ {f ↦nb} // put nb into updateNbrs for update it into the neighbour table later&#10;  end&#10;&#10;  event add_newEntry // (ctl) add new entry into the neighbour table&#10;    any x y&#10;    where&#10;      @g1 updateNbrs ≠ ∅ // there is some nodes that have to update thier neighbour table&#10;      @g2 x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs&#10;      @g4 y ↦ x   ∉ neighbourTbl // in case these new pairs don't appear in the neighbour table&#10;      @g5 y ↦ x ↦ 0 ∉ missed&#10;      @g6 y ↦ x ↦ 0 ∉ received&#10;      @g7 y ↦ x ↦ 0 ∉ lastSeqno&#10;      @g8 y ↦ x ↦ 0 ∉ receiveEst // @g10 ctlNeighbours = ∅&#10;    then&#10;      @a1 neighbourTbl ≔ neighbourTbl  ∪ {y  ↦ x}&#10;      @a2 missed ≔ missed  ∪  {y ↦ x ↦ 0}&#10;      @a3 received ≔ received  ∪  {y ↦ x ↦ 0}&#10;      @a4 lastSeqno ≔ lastSeqno  ∪  {y ↦ x ↦ 0}&#10;      @a5 receiveEst ≔ receiveEst  ∪  {y ↦ x ↦0}&#10;  end&#10;&#10;  event update_nbr // (ctl) update receiving information into the neighbour table&#10;    any x y sNo delta pkt&#10;    where&#10;      @g1 updateNbrs ≠ ∅ // there is some nodes that have to update thier neighbour table&#10;      @g2 x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs&#10;      @g3 y ↦ x   ∈ neighbourTbl // in case there is existing pairs in the neighbour table&#10;      @g4 pkt ↦x ∈ pktFwdr&#10;      @g5 sNo = netSeqNo(pkt) // get the sequence number from  the transmitted packet&#10;      @g6 delta = sNo − lastSeqno(y ↦ x) −1 // calculate the missed sequence number&#10;      @g7 delta ≥ 0&#10;      @g8 type(pkt) = BEACON // @g10 ctlNeighbours = ∅&#10;      @g11 pkt ∈ ran(sentUp)&#10;    then&#10;      @a1 received ≔ received    {y ↦ x ↦ (received(y ↦ x) + 1)}&#10;      @a2 lastSeqno ≔ lastSeqno    {y ↦ x ↦ sNo}&#10;      @a3 missed ≔ missed    {y ↦ x ↦ delta}&#10;      @a4 updateNbrs ≔ updateNbrs ∖ {x ↦ y}&#10;  end&#10;&#10;  event update_nbr2 // (ctl) preparing for update route packet for the later refinement&#10;    any x y pkt&#10;    where&#10;      @g1 updateNbrs ≠ ∅ // there is some nodes that have to process something&#10;      @g2 x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs&#10;      @g3 y ↦ x   ∈ neighbourTbl&#10;      @g4 pkt ↦ x ∈   pktFwdr&#10;      @g8 type(pkt) ≠ DATA ∧ type(pkt) ≠ BEACON&#10;      /* not from neither data or beacon packet&#10;         @g10 ctlNeighbours = ∅ */&#10;      @g11 pkt ∈ ran(sentUp)&#10;    then&#10;      @a1 updateNbrs ≔ updateNbrs ∖ {x ↦ y}&#10;  end&#10;&#10;  event est_due // (ctl) due the link quality estimation&#10;    any x&#10;    where&#10;      @g1 x ∈ ND ∖ estNDs // the node that has not calculated quality estimation yet&#10;      @g2 x ∈ dom (totalSentBcon) ∧ totalSentBcon(x) &gt; 0&#10;      @g3 totalSentBcon(x) mod EST_RATIO = 0&#10;      /* the number of transmitted packet reaches the estimation ratio&#10;         @g4 estNbrs = ∅ */&#10;    then&#10;      @a1 estNDs ≔ estNDs ∪ {x} // update node x in estNDs for considering to update reception ratio&#10;  end&#10;&#10;  event update_est // (cal) calculate and update reception ratio in case no lost packets or lose packets in the middle of transmission&#10;    any nd nb r m rt newAve&#10;    where&#10;      @g1 nd ∈ estNDs // the link quality estimation period of node nd must be due&#10;      @g2 nb ∈ ran({nd} ◁ neighbourTbl) // finding the neighbours of node nd in the neighbour table&#10;      @g3 nd ∈ dom(totalSentBcon) ∧ totalSentBcon(nd) &gt; 0 // node nd should transmit at least one packet&#10;      @g4 nd ↦ nb ∈ dom(lastSeqno) ∧  lastSeqno(nd ↦ nb) &gt; 0&#10;      @g5 r = received(nd ↦ nb)&#10;      @g6 m = missed(nd↦nb)&#10;      @g8 rt =  EST_RATIO&#10;      @g9 newAve = ((r ∗ 100)÷rt) // calculate the reception ratio&#10;      @g10 nd ↦ nb∈dom(receiveEst) ∧ newAve &gt;  0&#10;      @g11 nd ↦ nb∈dom(missed)&#10;      @g12 nd ↦ nb∈dom(received)&#10;      @g13 nd  ↦ nb ∉ estNbrs&#10;      @g14 estNbrs ≠ neighbourTbl&#10;    then&#10;      @a1 receiveEst ≔ receiveEst    {nd ↦ nb ↦ newAve}&#10;      @a2 missed ≔ missed    {nd ↦ nb ↦ 0}&#10;      @a3 received ≔ received    {nd ↦ nb ↦ 0}&#10;      @a4 estNbrs ≔ estNbrs ∪ {nd ↦ nb}&#10;  end&#10;&#10;  event update_est_nothing // (ctl) for case the dead neighbour node affecting sentEst become zero&#10;    any nd nb r m rt newAve&#10;    where&#10;      @g1 nd ∈ estNDs&#10;      @g2 nb ∈ ran({nd} ◁ neighbourTbl)&#10;      @g3 nd ∈ dom(totalSentBcon) ∧ totalSentBcon(nd) &gt; 0 // node nd should transmit at least one packet&#10;      @g4 nd ↦ nb ∈ dom(lastSeqno) ∧  lastSeqno(nd ↦ nb) &gt; 0&#10;      @g5 r = received(nd ↦ nb)&#10;      @g6 m = missed(nd↦nb)&#10;      @g7 rt = EST_RATIO ∧ rt &gt; 0&#10;      @g8 newAve = ((r ∗ 100)÷rt) // calculate the reception ratio&#10;      @g9 newAve = 0&#10;      @g10 nd  ↦ nb ∉ estNbrs&#10;      @g11 estNbrs ≠  neighbourTbl&#10;    then&#10;      @a1 estNbrs ≔ estNbrs ∪ {nd ↦ nb}&#10;  end&#10;&#10;  event reset_estTimer&#10;    where&#10;      @g1 estNDs = ND&#10;      @g2 totalSentBcon ≠ ∅&#10;      @g3 estNbrs =  neighbourTbl // @g4 x ∈ dom(totalSentBcon)&#10;    then&#10;      @a1 estNDs ≔ ∅&#10;      @a3 estNbrs ≔ ∅&#10;      @a31 totalSentBcon ≔ ND × {0}&#10;  end&#10;&#10;  event lose_pkt extends lose_pkt&#10;  end&#10;&#10;  event finish_tx_pkt extends finish_tx_pkt&#10;  end&#10;&#10;  event final_tx_pkt_1 extends final_tx_pkt_1&#10;  end&#10;&#10;  event final_tx_pkt_2 extends final_tx_pkt_2&#10;  end&#10;end&#10;" version="5">
