<org.eventb.core.guard name="_gyaCKJdZEeS7UZUzQZNbaA" org.eventb.core.label="g1" org.eventb.core.predicate="x ∈ dom(floodFlg)"/>
<org.eventb.core.guard name="_gyaCKZdZEeS7UZUzQZNbaA" org.eventb.core.label="g2" org.eventb.core.predicate="floodFlg(x) = TRUE"/>
