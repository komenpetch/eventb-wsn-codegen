<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1438245022536" org.eventb.texttools.text_representation="machine M1 refines M0  sees C1&#10;&#10;variables destBuff // nodes' receiving buffer&#10;          finalDestAddr // (ctl) final dest address&#10;          ndBuff // nodes' waiting buffer --------------------- var of M2&#10;          WiMedium // wireless medium&#10;          sensingNDs // (ctl)sensing nodes&#10;          sensedPkts // (ctl)sensed packets&#10;          floodedPkts // (ctl)flooded packets&#10;          floodTbl // for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // record recLostPkts packet at each node&#10;          floodFlg // flood flag&#10;&#10;&#10;invariants&#10;  @inv1_1 ndBuff ∈ ND ↔PKT&#10;  @inv1_2 WiMedium ∈ ND ↔PKT&#10;  @inv1_3 sensingNDs ⊆ ND ∖ Destination&#10;  @inv1_4 sensedPkts ⊆ PKT&#10;  @inv1_6 floodedPkts ⊆ PKT&#10;  @inv1_7 floodTbl ∈ ND → ℙ(PKT)&#10;  @inv1_8 ctlNeighbours ∈ PKT ↔ (ND ∪ {FAILED_XMIT})&#10;  @inv1_12 floodFlg ∈ ND →BOOL&#10;  @inv1_20 recLostPkts ∈ ND ↔ PKT&#10;  @glu1_1 ran(ndBuff ∪ WiMedium) =middleware&#10;  @glu1_2 sensedPkts ∪  floodedPkts = xmittedPkts&#10;  @glu_1_3 ran(recLostPkts) = lostPkts&#10;  @saf1_1 ndBuff ∩ WiMedium = ∅ // @saf1_1 sensedPkts ≠ ∅  ⇒ partition(sensedPkts, ndBuff, WiMedium, ({Sink} × sinkBuff))&#10;  @saf1_2 (ndBuff ∩ WiMedium) ∩ recLostPkts = ∅&#10;&#10;events&#10;  event INITIALISATION&#10;    then&#10;      @int0_3 destBuff ≔  ND × {∅}&#10;      @int0_4 finalDestAddr ≔ ∅&#10;      @int1_1 ndBuff ≔ ∅&#10;      @int1_2 WiMedium ≔ ∅&#10;      @int1_3 sensingNDs ≔ ∅&#10;      @int1_4 sensedPkts ≔ ∅&#10;      @int1_6 floodedPkts ≔ ∅&#10;      @int1_7 floodTbl ≔ ND × {∅}&#10;      @int1_8 ctlNeighbours ≔ ∅&#10;      @int1_12 floodFlg ≔ ND × {FALSE}&#10;      @inv1_20 recLostPkts ≔ ∅&#10;  end&#10;&#10;  event clear_sensingNDs // (shared) finish sensing&#10;    any x&#10;    where&#10;      @g1 sensingNDs = {x} // ∖ {Destination}&#10;    then&#10;      @a1 sensingNDs ≔ ∅&#10;  end&#10;&#10;  event create_dataPkt // (ctl)  create a  data packet&#10;  refines create_pkt&#10;    any s pkt fDes&#10;    where&#10;      @g1 pkt ∈ PKT ∧ s ∈ ND ∖Destination&#10;      @g2 pkt ∉  ran(ndBuff ∪ WiMedium)&#10;      @g3 s ∉ sensingNDs  ∧ pkt ∉ (sensedPkts ∪  floodedPkts) // has not been created yet&#10;      @g4 s = initialSrcAddr(pkt)&#10;      @g5 s ∈ dom(floodTbl)  ∧ pkt ∉ floodTbl(s) // not is duplicted packet&#10;      @g6 type(pkt) = DATA&#10;      @g7 fDes ∈ Destination&#10;      @g8 pkt ↦ fDes ∉ finalDestAddr&#10;      @g9 fDes ≠ s&#10;    then&#10;      @a1 sensingNDs ≔ sensingNDs ∪ {s}&#10;      @a2 sensedPkts ≔ sensedPkts ∪ {pkt}&#10;      @a3 ndBuff ≔ ndBuff  ∪ {s ↦ pkt}&#10;      @a4 floodTbl(s) ≔  floodTbl(s) ∪ {pkt}&#10;      @a5 finalDestAddr ≔ finalDestAddr ∪ {pkt  ↦ fDes}&#10;  end&#10;&#10;  event start_flooding // (ctl) start flooding&#10;    any x&#10;    where&#10;      @g1 x ∈ ND&#10;      @g2 floodFlg(x) = FALSE&#10;    then&#10;      @a1 floodFlg(x) ≔ TRUE&#10;  end&#10;&#10;  event reset_flooding&#10;    any x&#10;    where&#10;      @g1 x ∈ dom(floodFlg)&#10;      @g2 floodFlg(x) = TRUE&#10;    then&#10;      @a1 floodFlg(x) ≔ FALSE&#10;  end&#10;&#10;  event create_floodPkt // (ctl)  create a packet&#10;  refines create_pkt&#10;    any s pkt fDes&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∉  ran(ndBuff ∪ WiMedium)&#10;      @g3 pkt ∉ (sensedPkts ∪  floodedPkts) // has not been created yet&#10;      @g4 s = initialSrcAddr(pkt)&#10;      @g5 s ∈ dom(floodTbl)  ∧ pkt ∉ floodTbl(s) // not is duplicted packet&#10;      @g6 type(pkt) ∈ CONTROL&#10;      @g7 floodFlg(s) = TRUE&#10;      @g8 fDes ∈ ND&#10;      @g9 pkt ↦ fDes ∉ finalDestAddr&#10;      @g10 fDes ≠ s&#10;    then&#10;      @a1 floodedPkts ≔ floodedPkts ∪ {pkt}&#10;      @a2 ndBuff ≔ ndBuff  ∪ {s ↦ pkt}&#10;      @a3 floodTbl(s) ≔  floodTbl(s) ∪ {pkt}&#10;      @a4 finalDestAddr ≔ finalDestAddr ∪ {pkt  ↦ fDes}&#10;  end&#10;&#10;  event lose_pkt refines net_losing&#10;    any f pkt&#10;    where&#10;      @g1 pkt ∈ ran(WiMedium) ∖ ran(recLostPkts)&#10;      @g2 pkt ∉ ran(ndBuff)&#10;      @g3 f ↦ pkt ∈ WiMedium&#10;      @g4 f ↦ pkt ∉ recLostPkts&#10;      @g5 ran({pkt} ◁ ctlNeighbours) = {FAILED_XMIT}&#10;    then&#10;      @a1 WiMedium ≔ WiMedium  ⩥ {pkt}&#10;      @a2 recLostPkts ≔ recLostPkts  ∪ {f↦pkt}&#10;      @a3 ctlNeighbours ≔ ctlNeighbours ∖ {pkt ↦ FAILED_XMIT}&#10;  end&#10;&#10;  event start_tx // (ctl) starting transmiting a packet to WiMedium&#10;    any x pkt&#10;    where&#10;      @g2 x ↦ pkt ∈ ndBuff // packet in waiting ndBuff&#10;      @g3 x ↦ pkt ∉ WiMedium // but has not tranmitted to WiMedium&#10;    then&#10;      @a1 ndBuff ≔ ndBuff ∖{x↦pkt}&#10;      @a2 WiMedium ≔ WiMedium  ∪  {x ↦ pkt}&#10;  end&#10;&#10;  event indicate_neighbours // (env) channel sends the neighbour information&#10;    any pkt nbrs f&#10;    where&#10;      @g1 pkt ∈ ran(WiMedium)&#10;      @g2 f ↦ pkt ∈ WiMedium&#10;      @g3 nbrs ∈ {n∣n ∈ (ℙ(ND)) ∪ {{FAILED_XMIT}}}&#10;      @g4 nbrs ≠ ∅ // @g5 ∀nb · nb ∈ nbrs ∧ nb ↦ pkt   ∉ ndBuff&#10;      @g5 pkt ∉ dom(ctlNeighbours)&#10;    then&#10;      @a2 ctlNeighbours ≔ ctlNeighbours ∪({pkt}× nbrs)&#10;  end&#10;&#10;  event receive_pkt&#10;    any s nb pkt&#10;    where&#10;      @g0 pkt ∈ ran(WiMedium)&#10;      @g1 pkt  ↦ nb ∈ ctlNeighbours&#10;      @g2 nb ↦ pkt ∉   ndBuff // @g3 nb ∈ dom(recvNbrFlg) ∧ recvNbrFlg(nb) = FALSE&#10;      @g3 nb ↦ pkt ∉ WiMedium&#10;      @g4 s = initialSrcAddr(pkt) ∧ s ≠ nb&#10;      @g5 pkt ∈ dom(finalDestAddr) ∧ nb ≠ finalDestAddr(pkt)&#10;      @g6 nb ∈ dom(floodTbl)  ∧pkt ∉ floodTbl(nb) // not is duplicted packet&#10;    then&#10;      @a1 ndBuff ≔ ndBuff ∪ {nb ↦pkt}&#10;      @a2 ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}&#10;      @a3 floodTbl(nb) ≔  floodTbl(nb) ∪ {pkt}&#10;  end&#10;&#10;  event receive_dup_pkt&#10;    any nb pkt&#10;    where&#10;      @g1 pkt ∈ dom(ctlNeighbours)&#10;      @g2 pkt ↦ nb ∈ ctlNeighbours // @g3 nb ∈ dom(recvNbrFlg) ∧ recvNbrFlg(nb) = FALSE&#10;      @g3 nb ∈ dom(floodTbl)  ∧pkt ∈ floodTbl(nb) // not is duplicted packet&#10;    then&#10;      @a1 ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}&#10;  end&#10;&#10;  event dest_recv_pkt // (ctl) Destination receives a packet&#10;  refines dest_recv_pkt&#10;    any s des pkt&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∈ dom(finalDestAddr) ∧ des = finalDestAddr(pkt)&#10;      @g3 des ∈dom(destBuff)&#10;      @g4 pkt ∈ ran(WiMedium)∖destBuff(des)&#10;      @g5 s = initialSrcAddr(pkt)&#10;      @g6 {pkt} ◁ ctlNeighbours ≠ ∅ // returned by initial env event indicate_neighbour&#10;      @g7 ran({pkt} ◁ ctlNeighbours)  ≠ {FAILED_XMIT}&#10;      @g8 des ∈ ( ran({pkt} ◁ ctlNeighbours) ) // neighbour who is a sink&#10;    then&#10;      @a1 destBuff(des) ≔ destBuff(des) ∪ {pkt}&#10;      @a2 ctlNeighbours ≔ ctlNeighbours ∖ {pkt ↦des}&#10;      @a3 floodTbl(des) ≔  floodTbl(des) ∪ {pkt}&#10;  end&#10;&#10;  event finish_tx_pkt // (ctl) removes packet from network for transit tx&#10;    any pkt f&#10;    where&#10;      @g1 {pkt} ◁ctlNeighbours = ∅ // all neighbours receive transmitted packet pkt&#10;      @g2 f ∈ ND ∧  f ↦pkt∈WiMedium&#10;      @g3 pkt ∈  ran(WiMedium) ∧ pkt ∈ ran(ndBuff) // in WiMedium and still transited in another nodes&#10;    then&#10;      @a1 WiMedium ≔  WiMedium   ∖ {f↦pkt}&#10;  end&#10;&#10;  event final_tx_pkt // (ctl) remove data packet from network indicating completion of tx&#10;  refines final_tx_pkt&#10;    any pkt sk&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∈  ran(WiMedium) ∧ pkt ∉ ran(ndBuff) // in WiMedium and not transited in another nodes&#10;      @g3 pkt ∈ dom(finalDestAddr) ∧sk = finalDestAddr(pkt)&#10;      @g4 sk ∈ ND&#10;      @g5 pkt ∈destBuff(sk)&#10;      @g8 {pkt} ◁ctlNeighbours = ∅ // all neighbours receive transmitted packet pkt&#10;    then&#10;      @a1 WiMedium ≔  WiMedium   ⩥ {pkt}&#10;  end&#10;&#10;  event clear_pkt refines clear_pkt&#10;    any pkt&#10;    where&#10;      @g1 WiMedium = ∅ ∧ ndBuff = ∅&#10;      @g2 pkt ∈ dom(finalDestAddr)&#10;    then&#10;      @a1 finalDestAddr ≔  {pkt} ⩤ finalDestAddr&#10;  end&#10;end&#10;" version="5">
<org.eventb.core.refinesMachine name="'" org.eventb.core.target="M0"/>
<org.eventb.core.seesContext name="_xTBe0CPBEeWw7avYyJIc7Q" org.eventb.core.target="C1"/>
