<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1438251639390" org.eventb.texttools.text_representation="machine M6 refines M5  sees C4&#10;&#10;variables destBuff // nodes' receiving buffer&#10;          finalDestAddr // (ctl) final dest address&#10;          ndBuff // nodes' waiting buffer --------------------- var of M1&#10;          sensingNDs // (ctl)sensing nodes&#10;          sensedPkts // (ctl)sensed packets&#10;          floodedPkts // (ctl)flooded packets&#10;          floodTbl // for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // record recLostPkts packet at each node&#10;          floodFlg // flood flag&#10;          envSensedFlg // (env) sensing period--------------------- var of M2&#10;          envData // (env) environmental/conditional data&#10;          ctlSensedFlg // (ctl)sensing period&#10;          senseBuff // (ctl) sense ndBuff&#10;          recvedData // (ctl) received data&#10;          emergencyAlert // (ctl) actuating status&#10;          pktData // (ctl) data attached in transmitted packet&#10;          sentDown // transmitted packet to channel ------------------------- var of M3&#10;          sentUp // transmitted packet up to channel&#10;          channel // channel&#10;          envNeighbours // (env) neighbour list&#10;          wsnLinks // (env) dynamic WSN links -&#10;          crashedLinks // (env) cashed WSN Links&#10;          dataSeqNo // local nodes' current data sequence number at application layer&#10;          floodSeqNo // local nodes' current  broadcast sequence number at application layer&#10;          nbHops // neighbour's hop&#10;          pktSrc // (ctl) src address attached in transmitted packet&#10;          pktSeqNo // sequence number attached in transmitted packet&#10;          pktFwdr // fowarder attached in transmitted packet&#10;          pktNbHops // nb hop attached in transmitted packet&#10;          vPktSeqNo // (env) virtual packet at channel&#10;          vPktSrc // (env) virtual packet at channel&#10;          vPktFwdr // (env) virtual packet at channel&#10;          vPktData // (env) virtual packet at channel&#10;          vPktNbHops // (env) virtual packet at chennel&#10;          bwdNeighbourTbl // neighbourTbl structure ------------------------- var of M5&#10;          bwdNextND // next node&#10;          bwdSeqNo // field sequence no in neighbour table&#10;          bwdHopCnt // field hop count in neighbour table&#10;          netSeqNo // link sequence no in a packet, used for cost-estimation&#10;          linkSeqNo // link sequence number of each node&#10;          updateNbrs // for update neighbours in the neighbour table&#10;          fwdNeighbourTbl // neighbourTbl structure  ------------------------- var of M3&#10;          fwdNextND // next node&#10;          fwdSeqNo // field sequence no in neighbour table&#10;          fwdHopCnt // field hop count in neighbour table&#10;          rrepLists // rout reply lists&#10;          rrepSeqNo // sequence of rout at each node&#10;          netDestAddr // destination address of rrep&#10;          envDestAddr // destination addr for channel&#10;          rrepFlg // rrep flag&#10;          rrerLists // rout reply lists-----------------------------------------var of M6&#10;          pktErrND // node error&#10;          errND&#10;          rrerFlg // rrep flag&#10;&#10;&#10;invariants&#10;  @inv6_1 rrerLists ∈ ND ↔  PKT&#10;  @inv6_2 pktErrND ∈ PKT ⇸  ND&#10;  @inv6_4 errND ∈ ND ↔ ND&#10;  @inv6_5 rrerFlg ∈ ND → BOOL&#10;  @saf6_1 errND ⊆ fwdNeighbourTbl&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @int6_1 rrerLists ≔  ∅&#10;      @int6_2 pktErrND ≔ ∅&#10;      @int6_4 errND ≔ ∅&#10;      @int6_5 rrerFlg ≔  ND × {FALSE}&#10;  end&#10;&#10;  event set_link // (env) channel sets a topology&#10;  extends set_link&#10;  end&#10;&#10;  event disconnect_link // (env) disconnecte/damage a link&#10;  extends disconnect_link&#10;  end&#10;&#10;  event recover_link // (env) recover a link&#10;  extends recover_link&#10;  end&#10;&#10;  event start_sensing extends start_sensing&#10;  end&#10;&#10;  event sensing extends sensing&#10;  end&#10;&#10;  event finish_sensing extends finish_sensing&#10;  end&#10;&#10;  event create_dataPkt // (ctl)  create a  data packet&#10;  extends create_dataPkt&#10;  end&#10;&#10;  event start_fldRREQ // (ctl) start flooding&#10;  extends start_fldRREQ&#10;  end&#10;&#10;  event reset_fldRREQ extends reset_fldRREQ&#10;  end&#10;&#10;  event create_rreq // (ctl)  create a packet&#10;  extends create_rreq&#10;  end&#10;&#10;  event start_fldRRER // (ctl) start flooding&#10;  extends start_flooding&#10;    where&#10;      @g6 rrerFlg(x) = FALSE&#10;    then&#10;      @a16 rrerFlg(x) ≔ TRUE&#10;  end&#10;&#10;  event reset_fldRRER extends reset_flooding&#10;    where&#10;      @g13 rrerFlg(x) = TRUE&#10;    then&#10;      @a16 rrerFlg(x) ≔ FALSE&#10;  end&#10;&#10;  event create_rrer // (ctl)  create a packet&#10;  extends create_floodPkt&#10;    any rrer eND&#10;    where&#10;      @g22 eND ∈ ND&#10;      @g23 s ↦ rrer ∈ rrerLists&#10;      @g24 rrer ∈ dom(initialSrcAddr) ∧ fDes = initialSrcAddr(rrer)&#10;      @g25 s ↦ eND ∈fwdNeighbourTbl&#10;      @g26 pkt ∉ dom(pktErrND)&#10;      @g27 rrerFlg(s) = TRUE&#10;    then&#10;      @a15 rrerLists ≔ rrerLists ∖ {s↦rrer}&#10;      @a16 pktErrND ≔ pktErrND ∪ {pkt ↦ eND}&#10;  end&#10;&#10;  event start_fldRREP // (ctl) start flooding&#10;  extends start_fldRREP&#10;  end&#10;&#10;  event reset_fldRREP extends reset_fldRREP&#10;  end&#10;&#10;  event create_rrep // (ctl)  create a packet&#10;  extends create_rrep&#10;  end&#10;&#10;  event start_tx_dataPkt_bct // (ctl) starting transmiting a packet to WiMedium&#10;  extends start_tx_dataPkt_bct&#10;  end&#10;&#10;  event start_tx_dataPkt_fwd // (ctl) starting transmiting a data packet from buffer to lower layers (sentDown)&#10;  extends start_tx_dataPkt_fwd&#10;  end&#10;&#10;  event start_tx_rrep // (ctl) starting transmiting a flood packet from buffer to lower layers (sentDown)&#10;  extends start_tx_rrep&#10;  end&#10;&#10;  event start_tx_rreq // (ctl) starting transmiting a route request&#10;  extends start_tx_rreq&#10;  end&#10;&#10;  event start_tx_rrer // (ctl) starting transmiting a flood packet from buffer to lower layers (sentDown)&#10;  extends start_tx_floodPkt&#10;    any fDes&#10;    where&#10;      @g28 pkt ∈ dom(finalDestAddr) ∧ fDes = finalDestAddr(pkt)&#10;      @g29 ran({x}◁dom(bwdNextND)) ≠ ∅ ∧ fDes∈ran({x}◁dom(bwdNextND))&#10;      @g30 nxt = bwdNextND(x↦fDes)&#10;      @g31 type(pkt) = RRER&#10;  end&#10;&#10;  event send_down // (shared) set parameter from controller to channel&#10;  extends send_down&#10;  end&#10;&#10;  event find_neighbour // (env) channel finds neighbour&#10;  extends find_neighbour&#10;  end&#10;&#10;  event assign_forwarder // (env) channel assigns specific forwarder - preparing for unicast for later refinement&#10;  extends assign_forwarder&#10;  end&#10;&#10;  event lose_all_neighbours extends lose_all_neighbours&#10;    any nxt&#10;    where&#10;      @g7 pkt ∈ dom(netDestAddr) ∧ nxt=netDestAddr(pkt)&#10;      @g8 nxt = BROADCAST&#10;  end&#10;&#10;  event lose_specifc_neighbours extends lose_specifc_neighbours&#10;    any nxt&#10;    where&#10;      @g7 pkt ∈ dom(netDestAddr) ∧ nxt=netDestAddr(pkt)&#10;      @g8 nxt ≠ BROADCAST ∧ nxt ∉ nbs&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  extends send_up&#10;  end&#10;&#10;  event receive_rreqPkt // (ctl) each neighbour node receives a  flood pacekt from channel&#10;  extends receive_rreqPkt&#10;  end&#10;&#10;  event receive_dup_rreqPkt // (ctl) each neighbour node including sink receives a duplicated flood packet from channel&#10;  extends receive_dup_rreqPkt&#10;  end&#10;&#10;  event receive_rrepPkt // (ctl) each neighbour node receives a  flood pacekt from channel&#10;  extends receive_rrepPkt&#10;  end&#10;&#10;  event receive_dup_rrepPkt // (ctl) each neighbour node including sink receives a duplicated flood packet from channel&#10;  extends receive_dup_rrepPkt&#10;  end&#10;&#10;  event receive_dup_rrerPkt // (ctl) each neighbour node including sink receives a duplicated flood packet from channel&#10;  extends receive_dup_floodPkt&#10;    where&#10;      @g19 type(pkt) = RRER&#10;  end&#10;&#10;  event receive_dataPkt // (ctl) each neighbour node receives a data pacekt from channel&#10;  extends receive_dataPkt&#10;  end&#10;&#10;  event receive_dup_dataPkt // (ctl) each neighbour node including sink receives a duplicated data packet from channel&#10;  extends receive_dup_dataPkt&#10;  end&#10;&#10;  event dest_recv_dataPkt extends dest_recv_dataPkt&#10;  end&#10;&#10;  event dest_recv_rreqPkt // (ctl) sink receives a flood packet&#10;  extends dest_recv_rreqPkt&#10;  end&#10;&#10;  event dest_recv_rrepPkt // (ctl) sink receives a flood packet&#10;  extends dest_recv_rrepPkt&#10;  end&#10;&#10;  event dest_recv_rrerpkt // (ctl) sink receives a flood packet&#10;  extends dest_recv_fldpkt&#10;  end&#10;&#10;  event activating extends activating&#10;  end&#10;&#10;  event no_activating extends no_activating&#10;  end&#10;&#10;  event reset_activatingStatus extends reset_activatingStatus&#10;  end&#10;&#10;  event add_bwdRouteEntry // (ctl) add new entry into the route table&#10;  extends add_bwdRouteEntry&#10;  end&#10;&#10;  event add_fwdrouteEntry // (ctl) add new entry into the route table&#10;  extends add_fwdrouteEntry&#10;  end&#10;&#10;  event invalidate_neighbour extends add_routeEntry3&#10;    any eND&#10;    where&#10;      @g11 type(pkt)= RRER&#10;      @g12 pkt ↦ eND ∈   pktErrND&#10;      @g13 y ↦ eND  ∈ fwdNeighbourTbl&#10;      @g14  y ↦ eND  ∉ errND&#10;    then&#10;      @a7 errND ≔ errND  ∪  {y ↦ eND}&#10;  end&#10;&#10;  event lose_fldPkt extends lose_pkt&#10;    where&#10;      @g12 type(pkt) ∈ FLOOD&#10;  end&#10;&#10;  event lose_dataPkt extends lose_pkt&#10;    where&#10;      @g12 type(pkt) = DATA&#10;      @g13 f ↦ pkt   ∉  rrerLists&#10;    then&#10;      @a8 rrerLists ≔ rrerLists ∪ {f↦pkt}&#10;  end&#10;&#10;  event finish_tx_pkt // (ctl) removes packet from network for transit tx&#10;  extends finish_tx_pkt&#10;  end&#10;&#10;  event final_tx_pkt // (ctl) remove data packet from network indicating completion of tx&#10;  extends final_tx_pkt&#10;  end&#10;&#10;  event clear_pkt extends clear_pkt&#10;  end&#10;&#10;  event receive_rrerPkt // (ctl) each neighbour node receives a  flood pacekt from channel&#10;  extends receive_floodPkt&#10;    where&#10;      @g19 type(pkt) = RRER&#10;  end&#10;end&#10;" version="5">
