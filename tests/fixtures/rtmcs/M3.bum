<org.eventb.core.action name="_JLFqzSPDEeWw7avYyJIc7Q" org.eventb.core.assignment="sentUp ≔  sentUp   ⩥ {pkt}" org.eventb.core.label="a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xTHljCPBEeWw7avYyJIc7[" org.eventb.core.comment="(ctl) each node records a lost packet" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="lose_pkt">
