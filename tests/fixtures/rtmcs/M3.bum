<org.eventb.core.guard name="_BBeMiCP1EeWw7avYyJIc7Q" org.eventb.core.label="g2" org.eventb.core.predicate="pkt ∈ dom(finalDestAddr) ∧ des = finalDestAddr(pkt)"/>
<org.eventb.core.guard name="_BBeMiSP1EeWw7avYyJIc7Q" org.eventb.core.label="g3" org.eventb.core.predicate="des ∈dom(destBuff)"/>
<org.eventb.core.guard name="_BBeMiiP1EeWw7avYyJIc7Q" org.eventb.core.label="g4" org.eventb.core.predicate="pkt ∈ ran(sentUp ∪ sentDown)∖destBuff(des)"/>
<org.eventb.core.guard name="_BBeMiyP1EeWw7avYyJIc7Q" org.eventb.core.label="g5" org.eventb.core.predicate="s = initialSrcAddr(pkt)"/>
<org.eventb.core.guard name="_BBkTICP1EeWw7avYyJIc7Q" org.eventb.core.comment="returned by initial env event indicate_neighbour" org.eventb.core.label="g6" org.eventb.core.predicate="{pkt} ◁ ctlNeighbours ≠ ∅"/>
<org.eventb.core.guard name="_BBkTISP1EeWw7avYyJIc7Q" org.eventb.core.label="g7" org.eventb.core.predicate="ran({pkt} ◁ ctlNeighbours)  ≠ {FAILED_XMIT}"/>
<org.eventb.core.guard name="_BBkTIiP1EeWw7avYyJIc7Q" org.eventb.core.comment="neighbour who is a sink" org.eventb.core.label="g8" org.eventb.core.predicate="des ∈ ( ran({pkt} ◁ ctlNeighbours) )"/>
<org.eventb.core.guard name="_BBkTIyP1EeWw7avYyJIc7Q" org.eventb.core.label="g9" org.eventb.core.predicate="des ∈ dom(recvedData)"/>
<org.eventb.core.guard name="_BBkTJCP1EeWw7avYyJIc7Q" org.eventb.core.label="g10" org.eventb.core.predicate="pkt ∈ dom(pktData) ∧ data = pktData(pkt)"/>
<org.eventb.core.guard name="_BBkTJSP1EeWw7avYyJIc7Q" org.eventb.core.label="g11" org.eventb.core.predicate="type(pkt) = DATA"/>
<org.eventb.core.guard name="_BBkTJiP1EeWw7avYyJIc7Q" org.eventb.core.label="g12" org.eventb.core.predicate="pkt ↦ f ∈   pktFwdr"/>
<org.eventb.core.action name="_BBkTJyP1EeWw7avYyJIc7Q" org.eventb.core.assignment="destBuff(des) ≔ destBuff(des) ∪ {pkt}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_BBkTKCP1EeWw7avYyJIc7Q" org.eventb.core.assignment="ctlNeighbours ≔ ctlNeighbours ∖ {pkt ↦des}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_BBkTKSP1EeWw7avYyJIc7Q" org.eventb.core.assignment="floodTbl(des) ≔  floodTbl(des) ∪ {pkt}" org.eventb.core.label="a3"/>
<org.eventb.core.action name="_BBkTKiP1EeWw7avYyJIc7Q" org.eventb.core.assignment="recvedData(des) ≔ recvedData(des) ∪ {data}" org.eventb.core.label="a4"/>
</org.eventb.core.event>
