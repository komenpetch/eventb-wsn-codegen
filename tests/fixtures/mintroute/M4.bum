<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1436958022750" org.eventb.texttools.text_representation="machine M4 refines M3  sees C3&#10;&#10;variables sinkBuff // a sink ndBuff&#10;          ndBuff // nodes' ndBuff&#10;          sensingNDs // (ctl)sensing nodes&#10;          sensedPkts // (ctl)sensed packets&#10;          senseBuff // (ctl) sense ndBuff&#10;          floodedPkts // (ctl)flooded packets&#10;          floodTbl // for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // record lost packet at each nodd&#10;          envSensedFlg // (env) sensing period&#10;          envData // (env) environmental/conditional data&#10;          ctlSensedFlg // (ctl)sensing period&#10;          sentDown // transmitted packet to channel ------------------------- var of M2&#10;          sentUp // transmitted packet up to channel&#10;          channel // channel&#10;          envNeighbours // (env) neighbour list&#10;          wsnLinks // (env) dynamic WSN links&#10;          floodFlg // flood flag&#10;          dataSeqNo // local nodes' current data sequence number at application layer&#10;          floodSeqNo // local nodes' current  broadcast sequence number at application layer&#10;          nbHops // neighbour's hop&#10;          crashedLinks // (env) cashed WSN Links&#10;          pktSrc // (ctl) src address attached in transmitted packet&#10;          pktSeqNo // sequence number attached in transmitted packet&#10;          pktFwdr // fowarder attached in transmitted packet&#10;          pktData // (ctl) data attached in transmitted packet&#10;          pktNbHops // nb hop attached in transmitted packet&#10;          vPktSeqNo // (env) virtual packet at channel&#10;          vPktSrc // (env) virtual packet at channel&#10;          vPktFwdr // (env) virtual packet at channel&#10;          vPktData // (env) virtual packet at channel&#10;          vPktNbHops // (env) virtual packet at chennel&#10;          totalSentBcon // number of sent flood packets, used for cost-estimation ------------------------- var of M3&#10;          netSeqNo // link sequence no in a packet, used for cost-estimation&#10;          linkSeqNo // link sequence number of each node&#10;          updateNbrs // for update neighbours in the neighbour table&#10;          neighbourTbl // neighbourTbl structure&#10;          missed // field missed (no of lost packets) in neighbour table&#10;          received // field received (no of received packets)  in neighbour table&#10;          lastSeqno // field lastSeqno in neighbour table&#10;          receiveEst // field receiveEst (reception link quality) in neighbour table&#10;          estNDs // estimation nodes&#10;          estNbrs // estimation neighbours&#10;          bcastRouTimer // bcastRouTimer ------------------------- var of M4&#10;          bcastRouNodes // route broadcast nodes&#10;          routeSeqNo // sequence of rout at each node&#10;          sentEst // field sentEst (transmission quality) in neighbour table&#10;          liveliness // field liveliness in neighbour table&#10;          checkedLiveNbrs // liveliness nds&#10;&#10;&#10;invariants&#10;  @inv4_1 sentEst ∈ neighbourTbl → ℕ&#10;  @inv4_2 bcastRouTimer ∈ BOOL&#10;  @inv4_3 bcastRouNodes ⊆ ND&#10;  @inv4_4 routeSeqNo ∈ ND → ℕ&#10;  @inv4_5 liveliness ∈  neighbourTbl →  ℕ&#10;  @inv4_6 checkedLiveNbrs ⊆ neighbourTbl&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @int4_1 sentEst ≔ ∅&#10;      @int4_2 bcastRouTimer ≔ FALSE&#10;      @int4_3 bcastRouNodes ≔ ∅&#10;      @int4_4 routeSeqNo ≔ ND × {0}&#10;      @int4_5 liveliness ≔ ∅&#10;      @int4_6 checkedLiveNbrs ≔ ∅&#10;  end&#10;&#10;  event set_link // (env) channel sets a topology&#10;  extends set_link&#10;  end&#10;&#10;  event disconnect_link // (env) disconnecte/damage a link&#10;  extends disconnect_link&#10;  end&#10;&#10;  event recover_link // (env) recover a link&#10;  extends recover_link&#10;  end&#10;&#10;  event start_sensing extends start_sensing&#10;  end&#10;&#10;  event finish_sensing extends finish_sensing&#10;  end&#10;&#10;  event sensing extends sensing&#10;  end&#10;&#10;  event node_sense_pkt // (ctl)  create a packet&#10;  extends node_sense_pkt&#10;  end&#10;&#10;  event start_flooding extends start_flooding&#10;  end&#10;&#10;  event reset_flooding extends reset_flooding&#10;  end&#10;&#10;  event sink_create_bconPkt // (ctl)  create a packet&#10;  extends node_create_floodPkt&#10;    where&#10;      @g17 s = Sink&#10;      @g18 type(pkt) = BCON&#10;  end&#10;&#10;  event bcastRou_due extends reset_estTimer&#10;    where&#10;      @g5 bcastRouTimer = FALSE // @g6 ∀i · i∈ ran(receiveEst) ⇒ i &gt; 0 // when all node calculate the reception ratio&#10;      @g7 checkedLiveNbrs = ∅&#10;    then&#10;      @a5 bcastRouTimer ≔ TRUE&#10;  end&#10;&#10;  event reset_bcastRouTimer&#10;    where&#10;      @g1 bcastRouTimer = TRUE&#10;      @g2 bcastRouNodes = ND // when all node broadcast the route packet&#10;    then&#10;      @a1 bcastRouTimer ≔ FALSE&#10;      @a2 bcastRouNodes ≔  ∅&#10;  end&#10;&#10;  event node_create_routePkt // (ctl)  create a packet&#10;  extends node_create_floodPkt&#10;    where&#10;      @g17 type(pkt) =ROUTE&#10;      @g18 bcastRouTimer = TRUE&#10;      @g19 s ∉ bcastRouNodes&#10;    then&#10;      @a12 bcastRouNodes ≔ bcastRouNodes ∪ {s}&#10;  end&#10;&#10;  event start_tx_dataPkt // (ctl) starting transmiting a packet to WiMedium&#10;  extends start_tx_dataPkt&#10;  end&#10;&#10;  event start_tx_bconPkt // (ctl) starting transmiting a flood packet from ndBuff to lower layers (sentDown)&#10;  extends start_tx_bconPkt&#10;  end&#10;&#10;  event start_tx_routePkt // (ctl) starting transmiting a flood packet from ndBuff to lower layers (sentDown)&#10;  extends start_tx_floodPkt&#10;    where&#10;      @g12 type(pkt) = ROUTE&#10;      @g13 x ∈ dom(routeSeqNo)∧ lsno = routeSeqNo(x) + 1&#10;    then&#10;      @a11 routeSeqNo ≔  routeSeqNo{x↦lsno} // update the current sequence number of node x&#10;  end&#10;&#10;  event send_down extends send_down&#10;  end&#10;&#10;  event find_neighbour // (env) channel finds neighbour&#10;  extends find_neighbour&#10;  end&#10;&#10;  event assign_forwarder // (env) channel assigns specific forwarder - preparing for unicast for later refinement&#10;  extends assign_forwarder&#10;  end&#10;&#10;  event lose_all_neighbours // (env) channel loes all neighbuor&#10;  extends lose_all_neighbours&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  extends send_up&#10;  end&#10;&#10;  event receive_dataPkt // (ctl) each neighbour node receives a data pacekt from channel&#10;  extends receive_dataPkt&#10;  end&#10;&#10;  event receive_dup_dataPkt // (ctl) each neighbour node including sink receives a duplicated data packet from channel&#10;  extends receive_dup_dataPkt&#10;  end&#10;&#10;  event receive_floodPkt // (ctl) each neighbour node receives a  flood pacekt from channel&#10;  extends receive_floodPkt&#10;  end&#10;&#10;  event receive_dup_floodPkt // (ctl) each neighbour node including sink receives a duplicated flood packet from channel&#10;  extends receive_dup_floodPkt&#10;  end&#10;&#10;  event sink_recv_dataPkt // (ctl) each neighbour node receives a data pacekt from channel&#10;  extends sink_recv_dataPkt&#10;  end&#10;&#10;  event sink_recv_floodPkt // (ctl) sink receives a flood packet&#10;  extends sink_recv_floodPkt&#10;  end&#10;&#10;  event add_newEntry // (ctl) add new entry into the neighbour table&#10;  extends add_newEntry&#10;    where&#10;      @g9 y ↦ x ↦ 0 ∉ sentEst&#10;      @g10 y ↦ x ↦ LIVELINESS ∉ liveliness&#10;    then&#10;      @a6 sentEst ≔ sentEst  ∪  {y ↦ x ↦ 0} // set transmission ratio of each nighbour node to be zero&#10;      @a7 liveliness ≔ liveliness  ∪  {y ↦ x ↦ LIVELINESS} // set liveliness of each nighbour node to be zero&#10;  end&#10;&#10;  event update_nbr // (ctl) update receiving information into the neighbour table&#10;  extends update_nbr&#10;  end&#10;&#10;  event update_route // (ctl) preparing for update route packet for the later refinement&#10;  extends update_nbr2&#10;    where&#10;      @g9 y ↦ x ∈ dom(sentEst)&#10;      @g12 x ↦ y ∈ dom(receiveEst)&#10;      @g13 y ↦ x   ∈ dom(liveliness) // @g14 y ↦ x ↦ LIVELINESS ∉ liveliness&#10;    then&#10;      @a2 sentEst(y ↦ x) ≔ receiveEst(x ↦ y) // updating the transmission quality ratio with the reception quality ration attached in route update packets&#10;      @a3 liveliness(y ↦ x) ≔ LIVELINESS&#10;  end&#10;&#10;  event decrease_liveliness // (cal) decrease liveliness of each neighbour in neighbour table&#10;    any x y live&#10;    where&#10;      @g1 estNbrs = neighbourTbl&#10;      @g2 x ↦ y  ∈  checkedLiveNbrs&#10;      @g3 x ↦ y ∈  dom(liveliness)&#10;      @g4 live = liveliness(x↦y) ∧ live &gt; 0&#10;    then&#10;      @a1 liveliness ≔ liveliness   {x ↦ y ↦ (live−1)}&#10;      @a2 checkedLiveNbrs ≔ checkedLiveNbrs ∖ {x↦y}&#10;  end&#10;&#10;  event exclude_deadNbr // (cal) exclude dead neighbour from  neighbour table&#10;    any x y live&#10;    where&#10;      @g1 estNbrs =  neighbourTbl&#10;      @g2 x ↦ y  ∈  checkedLiveNbrs&#10;      @g3 x ↦ y  ∈  dom(liveliness)&#10;      @g4 live = liveliness(x↦y) ∧ live = 0&#10;      @g5 y ↦ x ∈ dom(sentEst)&#10;    then&#10;      @a1 sentEst(y ↦ x) ≔ 1&#10;      @a2 checkedLiveNbrs ≔ checkedLiveNbrs ∖ {x↦y}&#10;  end&#10;&#10;  event est_due // (ctl) due the link quality estimation&#10;  extends est_due&#10;  end&#10;&#10;  event update_est // (cal) calculate and update reception ratio in case no lost packets or lose packets in the middle of transmission&#10;  extends update_est&#10;    where&#10;      @g15 nd ↦ nb  ∉  checkedLiveNbrs&#10;    then&#10;      @a7 checkedLiveNbrs ≔ checkedLiveNbrs ∪ {nd ↦ nb}&#10;  end&#10;&#10;  event update_est_nothing // (ctl) for case the dead neighbour node affecting sentEst become zero&#10;  extends update_est_nothing&#10;    where&#10;      @g12 nd ↦ nb  ∉  checkedLiveNbrs&#10;    then&#10;      @a2 checkedLiveNbrs ≔ checkedLiveNbrs ∪ {nd ↦ nb}&#10;  end&#10;&#10;  event lose_pkt extends lose_pkt&#10;  end&#10;&#10;  event finish_tx_pkt extends finish_tx_pkt&#10;    where&#10;      @g41 type(pkt) =  DATA ∨ type(pkt) =  BEACON&#10;  end&#10;&#10;  event final_tx_pkt_1 extends final_tx_pkt_1&#10;    where&#10;      @g41 type(pkt) =  DATA ∨type(pkt) =  BEACON&#10;  end&#10;&#10;  event final_tx_pkt_2 extends final_tx_pkt_2&#10;    where&#10;      @g41 type(pkt) =  ROUTE&#10;  end&#10;end&#10;" version="5">
