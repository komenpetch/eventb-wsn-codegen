<org.eventb.core.event name="_xPmCwJdYEeS7UZUzQZNbaA" org.eventb.core.comment="(env) activating each node to sense data" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="start_sensing">
