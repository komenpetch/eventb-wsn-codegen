<org.eventb.core.guard name="_niTORAk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_final_tx_pkt_g2" org.eventb.core.predicate="{pkt} ◁ctlNeighbours = ∅"/>
<org.eventb.core.guard name="_niTORQk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_final_tx_pkt_g3" org.eventb.core.predicate="pkt ∈  ran(sentUp) ∧ pkt ∉ ran(sentDown)"/>
<org.eventb.core.guard name="_niTORgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MNDBuffer_isNot_In_Range_ndBuff_g1" org.eventb.core.predicate="pkt ∉ ran(ndBuff)"/>
<org.eventb.core.action name="_niTORwk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="sentUp ≔ sentUp  ⩥ {pkt}" org.eventb.core.label="MSend_final_tx_pkt_a1"/>
</org.eventb.core.event>
