<org.eventb.core.action name="_IwaK8yPxEeWw7avYyJIc7Q" org.eventb.core.assignment="bwdNextND ≔ bwdNextND  ∪  {y ↦ s ↦ x}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_IwayACPxEeWw7avYyJIc7Q" org.eventb.core.assignment="bwdSeqNo ≔ bwdSeqNo  ∪  {y ↦ s ↦ sNo}" org.eventb.core.label="a3"/>
<org.eventb.core.action name="_IwayASPxEeWw7avYyJIc7Q" org.eventb.core.assignment="bwdHopCnt ≔ bwdHopCnt  ∪  {y ↦ s ↦ hCnt}" org.eventb.core.label="a4"/>
<org.eventb.core.action name="_IwayAiPxEeWw7avYyJIc7Q" org.eventb.core.assignment="updateNbrs ≔ updateNbrs ∖ {x ↦ y}" org.eventb.core.label="a5"/>
</org.eventb.core.event>
<org.eventb.core.event name="_IwayAyPxEeWw7avYyJIc7Q" org.eventb.core.comment="(ctl) add new entry into the route table" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="add_routeEntry2">
