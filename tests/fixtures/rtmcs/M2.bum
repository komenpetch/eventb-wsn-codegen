<org.eventb.core.guard name="_xAzmJCPEEeWw7avYyJIc7Q" org.eventb.core.label="g1" org.eventb.core.predicate="x ∈ ND ∖Destination"/>
<org.eventb.core.guard name="_xAzmJSPEEeWw7avYyJIc7Q" org.eventb.core.label="g2" org.eventb.core.predicate="sf = envSensedFlg(x)"/>
