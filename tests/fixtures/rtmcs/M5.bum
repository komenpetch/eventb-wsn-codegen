<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1438250308946" org.eventb.texttools.text_representation="machine M5 refines M4  sees C4&#10;&#10;variables destBuff // (ctl) nodes' receiving buffer&#10;          finalDestAddr // (ctl) final destination address&#10;          ndBuff // (ctl) nodes' waiting buffer&#10;          sensingNDs // (ctl) sensing nodes&#10;          sensedPkts // (ctl) sensed packets&#10;          floodedPkts // (ctl) flooded packets&#10;          floodTbl // (ctl) historical received packets used for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // (ctl) record recLostPkts packet at each node&#10;          floodFlg // (ctl) flood flag&#10;          envSensedFlg // (env) sensing period&#10;          envData // (env) environmental/conditional data&#10;          ctlSensedFlg // (ctl)sensing period&#10;          senseBuff // (ctl) sense buffer&#10;          recvedData // (ctl) received data at destination&#10;          emergencyAlert // (ctl) actuating status&#10;          pktData // (ctl) data attached in transmitted packet&#10;          sentDown // (ctl) transmitted packet to channel&#10;          sentUp // (ctl) transmitted packet up to channel&#10;          channel // (env) channel&#10;          envNeighbours // (env) neighbour list&#10;          wsnLinks // (env) dynamic WSN links&#10;          crashedLinks // (env) crashed WSN Links&#10;          dataSeqNo // (ctl) local nodes' current data sequence number at application layer&#10;          floodSeqNo // (ctl) local nodes' current  broadcast sequence number at application layer&#10;          nbHops // (ctl) neighbour's hop count&#10;          pktSrc // (ctl) src address attached in transmitted packet&#10;          pktSeqNo // (ctl) sequence number attached in transmitted packet&#10;          pktFwdr // (ctl) fowarder attached in transmitted packet&#10;          pktNbHops // (ctl) hop count attached in transmitted packet&#10;          vPktSeqNo // (env) virtual packet at channel&#10;          vPktSrc // (env) virtual packet at channel&#10;          vPktFwdr // (env) virtual packet at channel&#10;          vPktData // (env) virtual packet at channel&#10;          vPktNbHops // (env) virtual packet at channel&#10;          bwdRouteTbl // (ctl) backwards route table to a source&#10;          bwdNextND // (ctl) neighbour table: field next node&#10;          bwdSeqNo // (ctl) neighbour table: field sequence number&#10;          bwdHopCnt // (ctl) neighbour table: field hop count&#10;          netSeqNo // (ctl) link sequence number in a packet&#10;          linkSeqNo // (ctl) link sequence number of each node&#10;          updateNbrs // (ctl) for update neighbours in the neighbour table&#10;          fwdNeighbourTbl // (ctl) fowards route table&#10;          fwdNextND // (ctl) fowards route table: field next node&#10;          fwdSeqNo // (ctl) fowards route table: field:sequence no in neighbour table&#10;          fwdHopCnt // (ctl) fowards route table: field hop count in neighbour table&#10;          rrepLists //(ctl)  route reply lists&#10;          rrepSeqNo // (ctl) sequence of route reply at each node&#10;          netDestAddr //(ctl) destination address of rrep&#10;          envDestAddr //(ctl) destination addr for a channel&#10;          rrepFlg //(ctl) rrep flag&#10;&#10;&#10;invariants&#10;  @inv4_5 fwdNeighbourTbl ∈ ND  ↔ ND&#10;  @inv4_6 fwdNextND ∈ fwdNeighbourTbl → ND&#10;  @inv4_7 fwdSeqNo ∈ fwdNeighbourTbl → ℕ&#10;  @inv4_8 fwdHopCnt ∈ fwdNeighbourTbl → ℕ&#10;  @inv4_9 rrepLists ∈ ND ↔  PKT&#10;  @inv4_10 rrepSeqNo ∈ ND → ℕ&#10;  @inv4_11 netDestAddr ∈ PKT ⇸ (ND ∪  {BROADCAST})&#10;  @inv4_12 envDestAddr ∈ PKT ⇸ (ND ∪  {BROADCAST})&#10;  @inv4_14 rrepFlg ∈ ND → BOOL&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @int5_1 fwdNeighbourTbl ≔ ∅&#10;      @int5_2 fwdSeqNo ≔ ∅&#10;      @int5_3 fwdNextND ≔ ∅&#10;      @int5_4 fwdHopCnt ≔ ∅&#10;      @int5_5 rrepLists ≔ ∅&#10;      @int5_6 rrepSeqNo ≔ ND × {0}&#10;      @int5_7 netDestAddr ≔ ∅&#10;      @int5_8 envDestAddr ≔ ∅&#10;      @int5_9 rrepFlg ≔ ND × {FALSE}&#10;  end&#10;&#10;  event set_link // (env) channel sets a topology&#10;  extends set_link&#10;  end&#10;&#10;  event disconnect_link // (env) disconnecte/damage a link&#10;  extends disconnect_link&#10;  end&#10;&#10;  event recover_link // (env) recover a link&#10;  extends recover_link&#10;  end&#10;&#10;  event start_sensing extends start_sensing&#10;  end&#10;&#10;  event sensing extends sensing&#10;  end&#10;&#10;  event finish_sensing extends finish_sensing&#10;  end&#10;&#10;  event create_dataPkt // (ctl)  create a  data packet&#10;  extends create_dataPkt&#10;    where&#10;      @g23 pkt ∉ dom(netDestAddr)&#10;    then&#10;      @a18 netDestAddr ≔ netDestAddr ∪   {pkt ↦  BROADCAST}&#10;  end&#10;&#10;  event start_fldRREQ // (ctl) start flooding&#10;  extends start_fldRREQ&#10;  end&#10;&#10;  event reset_fldRREQ extends reset_fldRREQ&#10;  end&#10;&#10;  event create_rreq // (ctl)  create a packet&#10;  extends create_floodPkt&#10;    where&#10;      @g19 type(pkt) = RREQ&#10;      @g20 pkt ∉ dom(netDestAddr)&#10;      @g21 rrepFlg(s) = FALSE&#10;    then&#10;      @a14 netDestAddr ≔ netDestAddr ∪   {pkt ↦ BROADCAST}&#10;  end&#10;&#10;  event create_floodPkt // (ctl)  create a packet&#10;  extends create_floodPkt&#10;    where&#10;      @g19 type(pkt) ≠ RREP ∧ type(pkt) ≠ RREQ&#10;      @g20 pkt ∉ dom(netDestAddr)&#10;      @g21 rrepFlg(s) = FALSE&#10;    then&#10;      @a14 netDestAddr ≔ netDestAddr ∪   {pkt ↦ BROADCAST}&#10;  end&#10;&#10;  event start_fldRREP // (ctl) start flooding&#10;  extends start_flooding&#10;    where&#10;      @g13 x ∈ dom(rrepLists)&#10;      @g14 rrepFlg(x) = FALSE&#10;    then&#10;      @a16 rrepFlg(x) ≔ TRUE&#10;  end&#10;&#10;  event reset_fldRREP extends reset_flooding&#10;    where&#10;      @g13 rrepFlg(x) = TRUE&#10;    then&#10;      @a16 rrepFlg(x) ≔ FALSE&#10;  end&#10;&#10;  event create_rrep // (ctl)  create a packet&#10;  extends create_floodPkt&#10;    any rreq&#10;    where&#10;      @g19 type(pkt) = RREP&#10;      @g20 s ↦ rreq ∈ rrepLists&#10;      @g21 pkt ∉ dom(netDestAddr)&#10;      @g22 fDes = initialSrcAddr(rreq)&#10;      @g23 rrepFlg(s) = TRUE&#10;    then&#10;      @a14 rrepLists ≔ rrepLists ∖ {s↦ rreq}&#10;      @a15 netDestAddr ≔ netDestAddr ∪   {pkt ↦ BROADCAST}&#10;  end&#10;&#10;  event start_tx_dataPkt_bct // (ctl) starting transmiting a packet to WiMedium&#10;  extends start_tx_dataPkt&#10;    where&#10;      @g17 ran({x}◁dom(fwdNextND)) = ∅&#10;  end&#10;&#10;  event start_tx_dataPkt_fwd // (ctl) starting transmiting a data packet from buffer to lower layers (sentDown)&#10;  extends start_tx_dataPkt&#10;    any s nxt&#10;    where&#10;      @g17 ran({x}◁dom(fwdNextND)) ≠ ∅ ∧ s ∈ran({x}◁dom(fwdNextND))&#10;      @g18 nxt = fwdNextND(x↦s)&#10;    then&#10;      @a13 netDestAddr ≔ netDestAddr  {pkt ↦ nxt}&#10;  end&#10;&#10;  event start_tx_rrep // (ctl) starting transmiting a flood packet from buffer to lower layers (sentDown)&#10;  extends start_tx_floodPkt&#10;    any s nxt&#10;    where&#10;      @g12 type(pkt) = RREP&#10;      @g13 x ∈ dom(rrepSeqNo)∧ lsno = rrepSeqNo(x) + 1&#10;      @g17 x↦s ∈ dom(bwdNextND) ∧ nxt = bwdNextND(x↦s)&#10;      @g18 pkt ∈ dom(netDestAddr)&#10;      @g19 pkt ∈ dom(finalDestAddr) ∧ s = finalDestAddr(pkt)&#10;    then&#10;      @a12 rrepSeqNo ≔  rrepSeqNo{x↦lsno} // update the current sequence number of node x&#10;      @a13 netDestAddr ≔ netDestAddr  {pkt ↦ nxt}&#10;  end&#10;&#10;  event start_tx_rreq // (ctl) starting transmiting a route request&#10;  extends start_tx_rreq&#10;  end&#10;&#10;  event start_tx_floodPkt // (ctl) starting transmiting a flood packet from buffer to lower layers (sentDown)&#10;  extends start_tx_floodPkt&#10;    any nxt&#10;    where&#10;      @g12 type(pkt) ≠ RREP ∧ type(pkt) ≠ RREQ&#10;      @g13 nxt ∈ ND&#10;    then&#10;      @a13 netDestAddr ≔ netDestAddr  {pkt ↦ nxt}&#10;  end&#10;&#10;  event send_down // (shared) set parameter from controller to channel&#10;  extends send_down&#10;    any nxt&#10;    where&#10;      @g13 pkt ∈ dom(netDestAddr) ∧ nxt=netDestAddr(pkt)&#10;      @g14 pkt ∉ dom(envDestAddr) ∧ nxt ∈ ND ∪ {BROADCAST}&#10;    then&#10;      @a12 envDestAddr ≔ envDestAddr ∪ {pkt ↦ nxt}&#10;  end&#10;&#10;  event find_neighbour // (env) channel finds neighbour&#10;  extends find_neighbour&#10;    any nxt&#10;    where&#10;      @g7 pkt ∈ dom(netDestAddr) ∧ nxt=netDestAddr(pkt)&#10;      @g8 nxt = BROADCAST&#10;  end&#10;&#10;  event assign_forwarder // (env) channel assigns specific forwarder - preparing for unicast for later refinement&#10;  extends assign_forwarder&#10;    any nxt&#10;    where&#10;      @g12 pkt ∈ dom(netDestAddr) ∧ nxt=netDestAddr(pkt)&#10;      @g13 nxt ≠ BROADCAST&#10;      @g14 nb = nxt&#10;  end&#10;&#10;  event lose_all_neighbours extends lose_all_neighbours&#10;  end&#10;&#10;  event lose_specifc_neighbours extends lose_specifc_neighbours&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  extends send_up&#10;    any nxt&#10;    where&#10;      @g15 pkt ↦ nxt ∈ envDestAddr&#10;    then&#10;      @a22 envDestAddr ≔ envDestAddr ∖ {pkt↦nxt }&#10;  end&#10;&#10;  event receive_rreqPkt // (ctl) each neighbour node receives a  flood pacekt from channel&#10;  extends receive_floodPkt&#10;    where&#10;      @g18 type(pkt) = RREQ&#10;  end&#10;&#10;  event receive_dup_rreqPkt // (ctl) each neighbour node including sink receives a duplicated flood packet from channel&#10;  extends receive_dup_floodPkt&#10;    where&#10;      @g15 type(pkt) = RREQ&#10;  end&#10;&#10;  event receive_rrepPkt // (ctl) each neighbour node receives a  flood pacekt from channel&#10;  extends receive_floodPkt&#10;    where&#10;      @g18 type(pkt) = RREP&#10;  end&#10;&#10;  event receive_dup_rrepPkt // (ctl) each neighbour node including sink receives a duplicated flood packet from channel&#10;  extends receive_dup_floodPkt&#10;    where&#10;      @g15 type(pkt) = RREP&#10;  end&#10;&#10;  event receive_floodPkt // (ctl) each neighbour node receives a  flood pacekt from channel&#10;  extends receive_floodPkt&#10;    where&#10;      @g18 type(pkt) ≠ RREQ ∧type(pkt) ≠ RREP&#10;  end&#10;&#10;  event receive_dup_floodPkt // (ctl) each neighbour node including sink receives a duplicated flood packet from channel&#10;  extends receive_dup_floodPkt&#10;    where&#10;      @g15 type(pkt) ≠ RREQ ∧type(pkt) ≠ RREP&#10;  end&#10;&#10;  event receive_dataPkt // (ctl) each neighbour node receives a data pacekt from channel&#10;  extends receive_dataPkt&#10;  end&#10;&#10;  event receive_dup_dataPkt // (ctl) each neighbour node including sink receives a duplicated data packet from channel&#10;  extends receive_dup_dataPkt&#10;  end&#10;&#10;  event dest_recv_dataPkt extends dest_recv_dataPkt&#10;  end&#10;&#10;  event dest_recv_rreqPkt // (ctl) sink receives a flood packet&#10;  extends dest_recv_fldpkt&#10;    where&#10;      @g18 type(pkt) = RREQ&#10;      @g19 des↦pkt ∉ rrepLists&#10;    then&#10;      @a6 rrepLists ≔ rrepLists ∪ {des↦pkt}&#10;  end&#10;&#10;  event dest_recv_rrepPkt // (ctl) sink receives a flood packet&#10;  extends dest_recv_fldpkt&#10;    where&#10;      @g18 type(pkt) = RREP&#10;  end&#10;&#10;  event dest_recv_fldpkt // (ctl) sink receives a flood packet&#10;  extends dest_recv_fldpkt&#10;    where&#10;      @g20 type(pkt) ≠ RREQ ∧type(pkt) ≠ RREP&#10;  end&#10;&#10;  event activating extends activating&#10;  end&#10;&#10;  event no_activating extends no_activating&#10;  end&#10;&#10;  event reset_activatingStatus extends reset_activatingStatus&#10;  end&#10;&#10;  event add_bwdRouteEntry // (ctl) add new entry into the route table&#10;  extends add_routeEntry&#10;    where&#10;      @g10 type(pkt) = RREQ&#10;      @g12 pkt ∈ ran(sentUp)&#10;  end&#10;&#10;  event add_fwdrouteEntry // (ctl) add new entry into the route table&#10;  extends add_routeEntry2&#10;    where&#10;      @g10 y ↦ s   ∉ fwdNeighbourTbl&#10;      @g11 type(pkt) = RREP&#10;      @g12 pkt ∈ ran(sentUp)&#10;    then&#10;      @a6 fwdNeighbourTbl ≔ fwdNeighbourTbl  ∪ {y  ↦ s}&#10;      @a7 fwdNextND ≔ fwdNextND  ∪  {y ↦ s ↦ x}&#10;      @a8 fwdSeqNo ≔ fwdSeqNo  ∪  {y ↦ s ↦ sNo}&#10;      @a9 fwdHopCnt ≔ fwdHopCnt  ∪  {y ↦ s ↦ hCnt}&#10;  end&#10;&#10;  event lose_pkt extends lose_pkt&#10;  end&#10;&#10;  event finish_tx_pkt // (ctl) removes packet from network for transit tx&#10;  extends finish_tx_pkt&#10;  end&#10;&#10;  event final_tx_pkt // (ctl) remove data packet from network indicating completion of tx&#10;  extends final_tx_pkt&#10;  end&#10;&#10;  event clear_pkt extends clear_pkt&#10;    where&#10;      @g7 pkt ∈ dom(netDestAddr)&#10;    then&#10;      @a6 netDestAddr ≔  {pkt} ⩤ netDestAddr&#10;  end&#10;&#10;  event add_routeEntry3 // (ctl) add new entry into the route table&#10;  extends add_routeEntry3&#10;    where&#10;      @g10 type(pkt) ≠ RREQ ∧ type(pkt) ≠ RREP&#10;  end&#10;&#10;  event start_flooding extends start_flooding&#10;  end&#10;&#10;  event reset_flooding extends reset_flooding&#10;  end&#10;end&#10;" version="5">
