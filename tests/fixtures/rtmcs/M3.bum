<org.eventb.core.guard name="_xTZ5WyPBEeWw7avYyJIc7Q" org.eventb.core.comment="all neighbours receive transmitted packet pkt" org.eventb.core.label="g1" org.eventb.core.predicate="{pkt} ◁ctlNeighbours = ∅"/>
<org.eventb.core.guard name="_xTZ5XCPBEeWw7avYyJIc7Q" org.eventb.core.label="g2" org.eventb.core.predicate="f ∈ ND ∧  f ↦pkt∈ sentUp"/>
<org.eventb.core.guard name="_xTZ5XSPBEeWw7avYyJIc7Q" org.eventb.core.comment="in WiMedium and still transited in another nodes" org.eventb.core.label="g3" org.eventb.core.predicate="pkt ∈  ran(sentUp) ∧ pkt ∉ ran(sentDown) ∧ pkt ∈ ran(ndBuff)"/>
<org.eventb.core.action name="_xTZ5XiPBEeWw7avYyJIc7Q" org.eventb.core.assignment="sentUp ≔  sentUp   ∖ {f↦pkt}" org.eventb.core.label="a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xTHljCPBEeWw7avYyJIc7e" org.eventb.core.comment="(ctl) the transmitted packet is removed from middleware indicating completion of transmission mechanism" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="final_tx_pkt">
