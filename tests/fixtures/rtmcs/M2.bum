<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1438245976791" org.eventb.texttools.text_representation="machine M2 refines M1  sees C2&#10;&#10;variables destBuff // nodes' receiving buffer&#10;          finalDestAddr // (ctl) final dest address&#10;          ndBuff // nodes' waiting buffer --------------------- var of M2&#10;          WiMedium // wireless medium&#10;          sensingNDs // (ctl)sensing nodes&#10;          sensedPkts // (ctl)sensed packets&#10;          floodedPkts // (ctl)flooded packets&#10;          floodTbl // for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // record recLostPkts packet at each node&#10;          floodFlg // flood flag&#10;          envSensedFlg // (env) sensing period--------------------- var of M3&#10;          envData // (env) environmental/conditional data&#10;          ctlSensedFlg // (ctl)sensing period&#10;          senseBuff // (ctl) sense ndBuff&#10;          recvedData // (ctl) received data&#10;          emergencyAlert // (ctl) actuating status&#10;          pktData // (ctl) data attached in transmitted packet&#10;          vPktData // (env) virtual packet at channel&#10;&#10;&#10;invariants&#10;  @inv2_1 envSensedFlg ∈ND ∖Destination → BOOL&#10;  @inv2_2 envData ∈ ND ∖Destination → ℤ&#10;  @inv2_3 ctlSensedFlg ∈ ND ∖Destination →BOOL&#10;  @inv2_4 senseBuff ∈ ND ∖Destination  → ℙ(ℤ)&#10;  @inv2_5 recvedData ∈ Destination → ℙ(ℤ)&#10;  @inv2_6 emergencyAlert ∈ Actuators → BOOL&#10;  @inv2_7 pktData ∈  PKT  ⇸ ℤ&#10;  @inv2_8 vPktData ∈  PKT   ⇸ ℤ&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @int2_1 envSensedFlg ≔ (ND ∖Destination) × {FALSE}&#10;      @int2_2 envData ≔ (ND ∖Destination) × {0}&#10;      @int2_3 ctlSensedFlg ≔ (ND ∖Destination) × {FALSE}&#10;      @int2_4 senseBuff ≔  (ND ∖Destination) × {∅}&#10;      @int2_5 recvedData ≔ Destination × {∅}&#10;      @int2_6 emergencyAlert ≔  Actuators × {FALSE}&#10;      @int2_7 pktData ≔ ∅&#10;      @int2_8 vPktData ≔ ∅&#10;  end&#10;&#10;  event start_sensing&#10;    any x sd&#10;    where&#10;      @g1 x ∈ ND ∖Destination&#10;      @g2 envSensedFlg(x) = FALSE&#10;      @g3 sd ∈ randomFn&#10;    then&#10;      @a1 envSensedFlg(x) ≔ TRUE&#10;      @a2 envData(x) ≔ sd&#10;  end&#10;&#10;  event sensing&#10;    any x sf sd&#10;    where&#10;      @g1 x ∈ ND ∖Destination&#10;      @g2 sf = envSensedFlg(x)&#10;      @g3 envSensedFlg(x) = TRUE&#10;      @g4 ctlSensedFlg(x) = FALSE&#10;      @g5 sd = envData(x)&#10;    then&#10;      @a1 ctlSensedFlg(x) ≔ sf&#10;      @a2 senseBuff(x) ≔  senseBuff(x) ∪ {sd}&#10;  end&#10;&#10;  event finish_sensing extends clear_sensingNDs&#10;    where&#10;      @g2 x ∈ dom(envSensedFlg)&#10;      @g3 envSensedFlg(x) = TRUE&#10;      @g4 ctlSensedFlg(x) = TRUE&#10;    then&#10;      @a2 ctlSensedFlg(x) ≔ FALSE&#10;      @a3 envSensedFlg(x) ≔ FALSE // @a3 sensingNDs ≔ ∅&#10;  end&#10;&#10;  event create_dataPkt // (ctl)  create a  data packet&#10;  extends create_dataPkt&#10;    any data&#10;    where&#10;      @g10 ctlSensedFlg(s) = TRUE&#10;      @g11 s ∈ dom(senseBuff) ∧ senseBuff ≠ ∅ ∧ data ∈ senseBuff(s)&#10;      @g12 pkt  ∉ dom(pktData)&#10;    then&#10;      @a6 senseBuff(s) ≔  senseBuff(s) ∖{data}&#10;      @a7 pktData ≔ pktData  ∪ {pkt ↦ data}&#10;  end&#10;&#10;  event start_flooding // (ctl) start flooding&#10;  extends start_flooding&#10;  end&#10;&#10;  event reset_flooding extends reset_flooding&#10;  end&#10;&#10;  event create_floodPkt // (ctl)  create a packet&#10;  extends create_floodPkt&#10;    where&#10;      @g11 pkt ∉ dom(pktData)&#10;    then&#10;      @a5 pktData ≔ pktData ∪ {pkt ↦0}&#10;  end&#10;&#10;  event lose_pkt extends lose_pkt&#10;  end&#10;&#10;  event start_tx // (ctl) starting transmiting a packet to WiMedium&#10;  extends start_tx&#10;  end&#10;&#10;  event assign_vPktData&#10;    any pkt data&#10;    where&#10;      @g1 pkt ∉ dom(vPktData)&#10;      @g2 pkt ∈ dom(pktData) ∧ data = pktData(pkt)&#10;    then&#10;      @a1 vPktData ≔ vPktData ∪ {pkt   ↦ data}&#10;      @a2 pktData ≔  {pkt} ⩤ pktData&#10;  end&#10;&#10;  event indicate_neighbours // (env) channel sends the neighbour information&#10;  extends indicate_neighbours&#10;    any data&#10;    where&#10;      @g13 pkt ∈ dom(vPktData) ∧ data = vPktData(pkt)&#10;      @g20 pkt ∉ dom(pktData)&#10;    then&#10;      @a14 vPktData ≔  {pkt} ⩤ vPktData&#10;      @a9 pktData ≔ pktData ∪ {pkt   ↦ data}&#10;  end&#10;&#10;  event receive_pkt extends receive_pkt&#10;  end&#10;&#10;  event receive_dup_pkt extends receive_dup_pkt&#10;  end&#10;&#10;  event dest_recv_dataPkt // (ctl) Destination receives a packet&#10;  extends dest_recv_pkt&#10;    any data&#10;    where&#10;      @g9 des ∈ dom(recvedData)&#10;      @g10 pkt ∈ dom(pktData) ∧ data = pktData(pkt)&#10;      @g11 type(pkt) = DATA&#10;    then&#10;      @a4 recvedData(des) ≔ recvedData(des) ∪ {data}&#10;  end&#10;&#10;  event dest_recv_fldpkt // (ctl) Destination receives a packet&#10;  extends dest_recv_pkt&#10;    where&#10;      @g9 type(pkt)∈ CONTROL&#10;  end&#10;&#10;  event activating&#10;    any act data&#10;    where&#10;      @g1 act ∈ Actuators&#10;      @g2 act ∈ dom(recvedData)&#10;      @g3 data ∈recvedData(act)&#10;      @g4 data ≥ safetyThreshold&#10;      @g5 emergencyAlert(act) = FALSE&#10;    then&#10;      @a1 recvedData(act) ≔ recvedData(act) ∖ {data}&#10;      @a2 emergencyAlert(act) ≔ TRUE&#10;  end&#10;&#10;  event no_activating&#10;    any act data&#10;    where&#10;      @g1 act ∈ Actuators&#10;      @g2 act ∈ dom(recvedData)&#10;      @g3 data ∈ recvedData(act)&#10;      @g4 data &lt; safetyThreshold&#10;    then&#10;      @a1 recvedData(act) ≔ recvedData(act) ∖ {data}&#10;  end&#10;&#10;  event reset_activatingStatus&#10;    any act&#10;    where&#10;      @g1 act ∈ dom(emergencyAlert)&#10;      @g2 emergencyAlert(act) = TRUE&#10;    then&#10;      @a1 emergencyAlert(act) ≔  FALSE&#10;  end&#10;&#10;  event finish_tx_pkt // (ctl) removes packet from network for transit tx&#10;  extends finish_tx_pkt&#10;  end&#10;&#10;  event final_tx_pkt // (ctl) remove data packet from network indicating completion of tx&#10;  extends final_tx_pkt&#10;  end&#10;&#10;  event clear_pkt extends clear_pkt&#10;    where&#10;      @g3 pkt ∈ dom(pktData)&#10;    then&#10;      @a2 pktData ≔  {pkt} ⩤ pktData&#10;  end&#10;end&#10;" version="5">
