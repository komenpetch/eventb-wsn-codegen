<org.eventb.core.guard name="_BBkTNSP1EeWw7avYyJIc7Q" org.eventb.core.label="g4" org.eventb.core.predicate="pkt ∈ ran(sentUp ∪ sentDown)∖destBuff(des)"/>
<org.eventb.core.guard name="_BBkTNiP1EeWw7avYyJIc7Q" org.eventb.core.label="g5" org.eventb.core.predicate="s = initialSrcAddr(pkt)"/>
