<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNba\" org.eventb.core.comment="(ctl) updating receiving information into the neighbour table" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="update_nbr">
