<org.eventb.core.guard name="_cAZUkJdtEeS7UZUzQZNbaA" org.eventb.core.label="g4" org.eventb.core.predicate="live = liveliness(x↦y) ∧ live = 0"/>
<org.eventb.core.guard name="_cAZUkZdtEeS7UZUzQZNbaA" org.eventb.core.label="g5" org.eventb.core.predicate="y ↦ x ∈ dom(sentEst)"/>
