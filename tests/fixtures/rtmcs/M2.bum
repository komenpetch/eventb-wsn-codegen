</org.eventb.core.event>
<org.eventb.core.event name="_xTHljCPBEeWw7avYyJIc7U" org.eventb.core.comment="initiating flooding a control packet" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="start_flooding">
