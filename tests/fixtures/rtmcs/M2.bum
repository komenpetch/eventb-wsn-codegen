<org.eventb.core.guard name="_KiN34iPSEeWw7avYyJIc7Q" org.eventb.core.label="g11" org.eventb.core.predicate="s ∈ dom(senseBuff) ∧ senseBuff ≠ ∅ ∧ data ∈ senseBuff(s)"/>
<org.eventb.core.guard name="_KiT-gCPSEeWw7avYyJIc7Q" org.eventb.core.label="g12" org.eventb.core.predicate="pkt  ∉ dom(pktData)"/>
