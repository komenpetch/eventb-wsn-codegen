<org.eventb.core.guard name="_JrKrqpZuEeSDW82aTOSJOQ" org.eventb.core.label="g2" org.eventb.core.predicate="pkt ∉  ran(ndBuff ∪ WiMedium)"/>
<org.eventb.core.guard name="_MPzLgJZuEeSDW82aTOSJOQ" org.eventb.core.comment="has not been created yet" org.eventb.core.label="g3" org.eventb.core.predicate="pkt ∉ sensedPkts ∪  floodedPkts"/>
<org.eventb.core.guard name="_JrKrq5ZuEeSDW82aTOSJOQ" org.eventb.core.label="g4" org.eventb.core.predicate="s = initialSrcAddr(pkt)"/>
<org.eventb.core.guard name="_vPJpUpZ5EeSDW82aTOSJOQ" org.eventb.core.label="g5" org.eventb.core.predicate="s ∈ dom(floodTbl)  ∧ pkt ∉ floodTbl(s)"/>
<org.eventb.core.guard name="_KuQLQJdVEeS7UZUzQZNbaA" org.eventb.core.label="g6" org.eventb.core.predicate="type(pkt) ∈ CONTROL"/>
<org.eventb.core.guard name="_gyMmwJdZEeS7UZUzQZNbaA" org.eventb.core.label="g7" org.eventb.core.predicate="floodFlg(s) = TRUE"/>
<org.eventb.core.action name="_JrKrrJZuEeSDW82aTOSJOQ" org.eventb.core.assignment="floodedPkts ≔ floodedPkts ∪ {pkt}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_JrKrrZZuEeSDW82aTOSJOQ" org.eventb.core.assignment="ndBuff ≔ ndBuff  ∪ {s ↦ pkt}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_JrKrrpZuEeSDW82aTOSJOQ" org.eventb.core.assignment="floodTbl(s) ≔  floodTbl(s) ∪ {pkt}" org.eventb.core.label="a3"/>
</org.eventb.core.event>
<org.eventb.core.event name="_cTPD0JZ3EeSDW82aTOSJOQ" org.eventb.core.comment="starting transmiting a packet to wireless medium" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="start_tx">
