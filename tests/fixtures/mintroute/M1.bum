<org.eventb.core.action name="_JrKroZZuEeSDW82aTOSJOQ" org.eventb.core.assignment="sensingNDs ≔ sensingNDs ∪ {s}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_JrKropZuEeSDW82aTOSJOQ" org.eventb.core.assignment="sensedPkts ≔ sensedPkts ∪ {pkt}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_JrKro5ZuEeSDW82aTOSJOQ" org.eventb.core.assignment="ndBuff ≔ ndBuff  ∪ {s ↦ pkt}" org.eventb.core.label="a3"/>
<org.eventb.core.action name="_vPJpUZZ5EeSDW82aTOSJOQ" org.eventb.core.assignment="floodTbl(s) ≔  floodTbl(s) ∪ {pkt}" org.eventb.core.label="a4"/>
</org.eventb.core.event>
<org.eventb.core.event name="_OoCuIJhDEeSr0O1Xox1Ztw" org.eventb.core.comment="clearing a sensed node" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="clear_sensingNDs">
