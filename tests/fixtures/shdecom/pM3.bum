n&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  extends send_up&#10;  end&#10;&#10;  event receive extends receive&#10;  end&#10;&#10;  event clear_recvdBuff extends clear_recvdBuff&#10;  end&#10;&#10;  event fwdr_receive_pkt extends fwdr_receive_pkt&#10;  end&#10;&#10;  event dest_recv_pkt extends dest_recv_pkt&#10;  end&#10;&#10;  event finish_tx_pkt extends finish_tx_pkt&#10;  end&#10;&#10;  event final_tx_pkt extends final_tx_pkt&#10;  end&#10;end&#10;" version="5">
