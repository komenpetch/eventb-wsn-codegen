</org.eventb.core.event>
<org.eventb.core.event name="_xAzmGCPEEeWw7avYyJIc7Q" org.eventb.core.comment="activating each node to sense data" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="start_sensing">
