0;       @User_defined_guard_g1 data = CTL_VAL&#10;        @User_defined_guard_g2 type(pkt) ∈ CONTROL&#10;    then&#10;      @MPacket_creating_pkt_a1 createdPkts≔ createdPkts ∪ {pkt}&#10;      @MPacket_creating_pkt_a2 pktFwdr ≔ pktFwdr ∪ {pkt ↦ x}&#10;      @MPacket_creating_pkt_a3 pktData ≔ pktData ∪ {pkt ↦ data}&#10;      @MNDbuffMgt_record_ndBuff_a1 ndBuff ≔ ndBuff  ∪ {x ↦ pkt}&#10;  end&#10;&#10;  event start_tx extends start_tx&#10;  end&#10;&#10;  event send_down extends send_down&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  extends send_up&#10;  end&#10;&#10;  event receive extends receive&#10;  end&#10;&#10;  event clear_recvdBuff extends clear_recvdBuff&#10;  end&#10;&#10;  event fwdr_receive_pkt extends fwdr_receive_pkt&#10;  end&#10;&#10;  event dest_recv_pkt extends dest_recv_pkt&#10;  end&#10;&#10;  event finish_tx_pkt extends finish_tx_pkt&#10;  end&#10;&#10;  event final_tx_pkt extends final_tx_pkt&#10;  end&#10;end&#10;" version="5">
