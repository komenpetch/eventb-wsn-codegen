<org.eventb.core.guard name="_IwcAIyPxEeWw7avYyJIc7Q" org.eventb.core.label="g2" org.eventb.core.predicate="x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs"/>
<org.eventb.core.guard name="_IwcnMCPxEeWw7avYyJIc7Q" org.eventb.core.comment="@g4 y ↦ s   ∉ dest // in case these new pairs don't appear in the neighbour table" org.eventb.core.label="g3" org.eventb.core.predicate="pkt ∈ dom(initialSrcAddr) ∧ s = initialSrcAddr(pkt)"/>
<org.eventb.core.guard name="_IwcnMSPxEeWw7avYyJIc7Q" org.eventb.core.label="g5" org.eventb.core.predicate="pkt ↦x ∈ pktFwdr"/>
