<org.eventb.core.action name="_xA5stCPEEeWw7avYyJIc7Q" org.eventb.core.assignment="senseBuff(x) ≔  senseBuff(x) ∪ {sd}" org.eventb.core.label="a2"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xA5stSPEEeWw7avYyJIc7Q" org.eventb.core.comment="finishing sensing data process" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="finish_sensing">
