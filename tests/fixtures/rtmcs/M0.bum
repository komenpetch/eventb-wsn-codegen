<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1436179318229" org.eventb.texttools.text_representation="machine M0 sees C0&#10;&#10;variables middleware // middleware&#10;          destBuff // nodes' receiving buffer&#10;          xmittedPkts // (ctl) created packets&#10;&#9;&#9;  finalDestAddr //(ctl) final dest address&#10;          lostPkts //losted packets&#10;&#10;&#10;invariants&#10;  @int0_1 xmittedPkts ⊆ PKT // (ctl) created packets&#10;  @inv0_2 middleware ⊆ PKT&#10;  @inv0_3 destBuff ∈ ND→ ℙ(PKT)&#10;  @inv0_4  finalDestAddr ∈ xmittedPkts ⇸ ND&#10;  @inv0_5 lostPkts ⊆ PKT&#10;&#10;&#10;events&#10;  event INITIALISATION&#10;    then&#10;      @int0_1 xmittedPkts ≔ ∅&#10;      @int0_2 middleware ≔ ∅&#10;      @int0_3 destBuff ≔ ND × {∅}&#10;      @int0_4 finalDestAddr ≔ ∅&#10;      @int0_5 lostPkts ≔ ∅&#10;  end&#10;&#10;  event create_pkt // (ctl)  create a packet&#10;    any s fDes pkt&#10;    where&#10;      @g1 pkt ∈ PKT ∖ (xmittedPkts  ∪  middleware) // has not been created yet&#10;      @g4 s = initialSrcAddr(pkt)&#10;      @g5 fDes ∈ ND&#10;      @g6 pkt ↦ fDes ∉ finalDestAddr&#10;      @g7 fDes ≠ s&#10;    then&#10;      @a1 xmittedPkts ≔ xmittedPkts ∪ {pkt}&#10;      @a2 finalDestAddr ≔ finalDestAddr ∪ {pkt  ↦ fDes}&#10;      @a3 middleware ≔  middleware ∪  {pkt}&#10;  end&#10;&#10;  event dest_recv_pkt // (ctl) sink receives a packet&#10;    any s des pkt&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∈ dom(finalDestAddr) ∧ des = finalDestAddr(pkt)&#10;      @g3 des ∈dom(destBuff)&#10;      @g4 pkt ∈ middleware∖destBuff(des)&#10;      @g5 s = initialSrcAddr(pkt)&#10;&#10;    then&#10;      @a1 destBuff(des) ≔ destBuff(des) ∪ {pkt}&#10;  end&#10;&#10;    event net_losing&#10;  any pkt&#10;  where&#10;     @g1 pkt ∈ middleware ∖ lostPkts&#10;  then&#10;     @a1 middleware ≔  middleware ∖  {pkt}&#10;     @a2 lostPkts ≔ lostPkts ∪ {pkt}&#10;  end&#10;&#10;&#10;&#10;  event final_tx_pkt // (ctl) remove data packet from network indicating completion of tx&#10;    any pkt sk&#10;    where&#10;      @g1 pkt ∈ PKT&#10;      @g2 pkt ∈ middleware&#10;      @g3 pkt ∈ dom(finalDestAddr) ∧sk = finalDestAddr(pkt)&#10;      @g5 pkt ∈destBuff(sk)&#10;    then&#10;      @a1 middleware ≔  middleware ∖  {pkt}&#10;  end&#10;&#10;  event clear_pkt&#10;  any pkt&#10;  where&#10;      @g1 middleware = ∅&#10;      @g2 pkt ∈ dom(finalDestAddr)&#10;  then&#10;     @a1 finalDestAddr ≔  {pkt} ⩤ finalDestAddr&#10;  end&#10;end&#10;" version="5">
