<org.eventb.core.variable name="_niA6XAk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="(ctl) data attached in transmitted packet" org.eventb.core.identifier="pktData"/>
<org.eventb.core.variable name="_niA6XQk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="created packets" org.eventb.core.identifier="createdPkts"/>
<org.eventb.core.variable name="_niA6Xgk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="nodes' recvBuff" org.eventb.core.identifier="ndBuff"/>
<org.eventb.core.variable name="_niA6Xwk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="transmitted packet to channel" org.eventb.core.identifier="sentDown"/>
<org.eventb.core.variable name="_niA6YAk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="transmitted packet up to channel" org.eventb.core.identifier="sentUp"/>
