<org.eventb.core.event name="_xPSgwpdYEeS7UZUzQZNbaD" org.eventb.core.comment="(env) disconnecting a link" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="disconnect_link">
