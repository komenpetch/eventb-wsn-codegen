<org.eventb.core.guard name="_IwZj4iPxEeWw7avYyJIc7Q" org.eventb.core.label="g7" org.eventb.core.predicate="hCnt ∈ ℕ ∧ pkt∈dom(pktNbHops) ∧ hCnt = pktNbHops(pkt) + 1 ∧ y ↦ x ↦ hCnt ∉ bwdHopCnt"/>
<org.eventb.core.guard name="_IwaK8CPxEeWw7avYyJIc7Q" org.eventb.core.label="g8" org.eventb.core.predicate="ctlNeighbours = ∅"/>
