<org.eventb.core.action name="_BBkTQCP1EeWw7avYyJIc7Q" org.eventb.core.assignment="floodTbl(des) ≔  floodTbl(des) ∪ {pkt}" org.eventb.core.label="a3"/>
</org.eventb.core.event>
<org.eventb.core.event name="_xTHljCPBEeWw7avYyJIc7a" org.eventb.core.comment="(ctl) alerting emergency: sensed data is above safety threshold" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="actuating">
