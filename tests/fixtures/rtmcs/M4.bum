<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd;org.eventb.codegen.ui.cgConfig" org.eventb.texttools.text_lastmodified="1438250312479" org.eventb.texttools.text_representation="machine M4 refines M3  sees C4&#10;&#10;variables destBuff // (ctl) nodes' receiving buffer&#10;          finalDestAddr // (ctl) final destination address&#10;          ndBuff // (ctl) nodes' waiting buffer&#10;          sensingNDs // (ctl) sensing nodes&#10;          sensedPkts // (ctl) sensed packets&#10;          floodedPkts // (ctl) flooded packets&#10;          floodTbl // (ctl) historical received packets used for detect duplicated packets&#10;          ctlNeighbours // (ctl) neighbour lists&#10;          recLostPkts // (ctl) record recLostPkts packet at each node&#10;          floodFlg // (ctl) flood flag&#10;          envSensedFlg // (env) sensing period&#10;          envData // (env) environmental/conditional data&#10;          ctlSensedFlg // (ctl)sensing period&#10;          senseBuff // (ctl) sense buffer&#10;          recvedData // (ctl) received data at destination&#10;          emergencyAlert // (ctl) actuating status&#10;          pktData // (ctl) data attached in transmitted packet&#10;          sentDown // (ctl) transmitted packet to channel&#10;          sentUp // (ctl) transmitted packet up to channel&#10;          channel // (env) channel&#10;          envNeighbours // (env) neighbour list&#10;          wsnLinks // (env) dynamic WSN links&#10;          crashedLinks // (env) crashed WSN Links&#10;          dataSeqNo // (ctl) local nodes' current data sequence number at application layer&#10;          floodSeqNo // (ctl) local nodes' current  broadcast sequence number at application layer&#10;          nbHops // (ctl) neighbour's hop count&#10;          pktSrc // (ctl) src address attached in transmitted packet&#10;          pktSeqNo // (ctl) sequence number attached in transmitted packet&#10;          pktFwdr // (ctl) fowarder attached in transmitted packet&#10;          pktNbHops // (ctl) hop count attached in transmitted packet&#10;          vPktSeqNo // (env) virtual packet at channel&#10;          vPktSrc // (env) virtual packet at channel&#10;          vPktFwdr // (env) virtual packet at channel&#10;          vPktData // (env) virtual packet at channel&#10;          vPktNbHops // (env) virtual packet at chennel&#10;          bwdRouteTbl // (ctl)  backwards route table to a source&#10;          bwdNextND // (ctl) backwards route table : field next node&#10;          bwdSeqNo // (ctl) backwards route table : field sequence number&#10;          bwdHopCnt // (ctl) backwards route table : field hop count&#10;          netSeqNo // (ctl) link sequence number in a packet&#10;          linkSeqNo // (ctl) link sequence number of each node&#10;          updateNbrs // (ctl) for update neighbours in the neighbour table&#10;&#10;&#10;invariants&#10;  @inv4_1 bwdRouteTbl ∈ ND  ↔ ND&#10;  @inv4_2 bwdNextND ∈ bwdRouteTbl → ND&#10;  @inv4_3 bwdSeqNo ∈ bwdRouteTbl → ℕ&#10;  @inv4_4 bwdHopCnt ∈ bwdRouteTbl → ℕ&#10;  @inv4_5 netSeqNo ∈ PKT → ℕ&#10;  @inv4_6 linkSeqNo ∈ ND → ℕ&#10;  @inv4_7 updateNbrs ∈ ND ↔ ND // forwarder &lt;-&gt; neighbours&#10;&#10;events&#10;  event INITIALISATION extends INITIALISATION&#10;    then&#10;      @int4_1 bwdRouteTbl ≔ ∅&#10;      @int4_2 bwdSeqNo ≔ ∅&#10;      @int4_3 bwdNextND ≔ ∅&#10;      @int4_4 bwdHopCnt ≔ ∅&#10;      @int4_5 netSeqNo ≔ PKT × {0}&#10;      @int4_6 linkSeqNo ≔  ND × {0}&#10;      @int4_7 updateNbrs ≔ ∅&#10;  end&#10;&#10;  event set_link // (env) channel sets a topology&#10;  extends set_link&#10;  end&#10;&#10;  event disconnect_link // (env) disconnecting a link&#10;  extends disconnect_link&#10;  end&#10;&#10;  event recover_link // (env) recovering a link&#10;  extends recover_link&#10;  end&#10;&#10;  event start_sensing // (env) activating each node to sense data&#10;  extends start_sensing&#10;  end&#10;&#10;  event sensing // (shd) each node sense a data from environment&#10;  extends sensing&#10;  end&#10;&#10;  event finish_sensing // (shd) finishing sensing data process&#10;  extends finish_sensing&#10;  end&#10;&#10;  event create_dataPkt // (ctl) creating a data packet&#10;  extends create_dataPkt&#10;  end&#10;&#10;  event start_flooding // (ctl) initiating flooding a control packet&#10;  extends start_flooding&#10;  end&#10;&#10;  event reset_flooding // (ctl) resetting flooding flag&#10;  extends reset_flooding&#10;  end&#10;&#10;  event start_fldRREQ // (ctl) starting flooding RREQ&#10;  extends start_flooding&#10;  end&#10;&#10;  event reset_fldRREQ // (ctl) finishing flooding RREQ&#10;  extends reset_flooding&#10;  end&#10;&#10;  event create_controlPkt // (ctl) creating a control packet&#10;  extends create_controlPkt&#10;  end&#10;&#10;  event start_tx_dataPkt // (ctl) starting transmiting a data packet to a channel&#10;  extends start_tx&#10;    where&#10;      @g3 type(pkt) = DATA&#10;  end&#10;&#10;  event start_tx_rreq // (ctl) starting transmiting a route request packet to a channel&#10;  extends start_tx&#10;    any lsno&#10;    where&#10;      @g3 type(pkt) = RREQ&#10;      @g4 x ∈ dom(linkSeqNo)∧ lsno = linkSeqNo(x) + 1 // calculate the link sequence number from the recent number&#10;    then&#10;      @a3 linkSeqNo ≔  linkSeqNo{x↦lsno} // update the current sequence number of node x&#10;      @a4 netSeqNo(pkt) ≔ lsno // update the current sequence number into a flood packet&#10;  end&#10;&#10;  event start_tx_controlPkt // (ctl) starting transmiting other control packets from buffer to a channel&#10;  extends start_tx&#10;    any lsno&#10;    where&#10;      @g3 type(pkt) ≠ RREQ&#10;      @g4 lsno ∈ ℕ&#10;    then&#10;      @a3 netSeqNo(pkt) ≔ lsno&#10;  end&#10;&#10;  event send_down // (shd) sending a packet down to a channel&#10;  extends send_down&#10;  end&#10;&#10;  event find_neighbour // (env) channel finds the neighbour list of the forwarder&#10;  extends find_neighbour&#10;  end&#10;&#10;  event assign_forwarder // (env) channel assigns specific fowarder - preparing for unicast for later refinement&#10;  extends assign_forwarder&#10;  end&#10;&#10;  event lose_all_neighbours // env) channel loses all neighbour&#10;  extends lose_all_neighbours&#10;  end&#10;&#10;  event lose_specifc_neighbours // (env) channel loses a specific neighbour&#10;  extends lose_specifc_neighbours&#10;  end&#10;&#10;  event send_up // (env) channel sends the neighbour information&#10;  extends send_up&#10;  end&#10;&#10;  event receive_dataPkt // (ctl) each neighbour node receives a data pacekt from channel&#10;  extends receive_pkt&#10;    where&#10;      @g8 type(pkt) = DATA&#10;  end&#10;&#10;  event receive_dup_dataPkt // (ctl) each neighbour node including sink receives a duplicated data packet from channel&#10;  extends receive_dup_pkt&#10;    where&#10;      @g4 type(pkt) = DATA&#10;  end&#10;&#10;  event receive_controlPkt // (ctl) each neighbour node receives a  control pacekt from a channel&#10;  extends receive_pkt&#10;    where&#10;      @g8 type(pkt) ∈ CONTROL&#10;      @g9 f ∈ ND ∧ nb ∈ ND&#10;      @g10 f ↦ nb ∉ updateNbrs // nb has not considered to update in the neighbour table yet&#10;    then&#10;      @a4 updateNbrs ≔ updateNbrs ∪ {f ↦nb} // put nb into updateNbrs for update it into the neighbour table later&#10;  end&#10;&#10;  event receive_dup_controlPkt // (ctl) each neighbour node including sink receives a duplicated control packet from channel&#10;  extends receive_dup_pkt&#10;    where&#10;      @g4 type(pkt) ≠ DATA&#10;      @g5 f ∈ ND ∧ nb ∈ ND&#10;      @g6 f ↦ nb ∉ updateNbrs // nb has not considered to update in the neighbour table yet&#10;  end&#10;&#10;  event dest_recv_dataPkt // (ctl) destination receives a data packet from a channel&#10;  extends dest_recv_dataPkt&#10;  end&#10;&#10;  event dest_recv_controlPkt // (ctl) destination receives a control packet from a channel&#10;  extends dest_recv_controlPkt&#10;    where&#10;      @g13 type(pkt) ≠ DATA&#10;      @g14 f ∈ ND ∧ des ∈ ND&#10;      @g15 f ↦ des ∉ updateNbrs&#10;    then&#10;      @a5 updateNbrs ≔ updateNbrs ∪ {f↦des}&#10;  end&#10;&#10;  event add_routeEntry // (ctl) add new entry into the route table&#10;    any x y s pkt sNo hCnt&#10;    where&#10;      @g1 updateNbrs ≠ ∅ // there is some nodes that have to update thier neighbour table&#10;      @g2 x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs&#10;      @g3 pkt ∈ dom(initialSrcAddr) ∧ s = initialSrcAddr(pkt)&#10;      @g4 y ↦ s   ∉ bwdRouteTbl // in case these new pairs don't appear in the neighbour table&#10;      @g5 pkt ↦x ∈ pktFwdr&#10;      @g6 sNo = netSeqNo(pkt) ∧ y ↦ x ↦ sNo ∉ bwdSeqNo&#10;      @g7 hCnt ∈ ℕ ∧ pkt∈dom(pktNbHops) ∧ hCnt = pktNbHops(pkt) + 1 ∧ y ↦ x ↦ hCnt ∉ bwdHopCnt&#10;      @g8 ctlNeighbours = ∅&#10;      @g9 type(pkt) = RREQ&#10;    then&#10;      @a1 bwdRouteTbl ≔ bwdRouteTbl  ∪ {y  ↦ s}&#10;      @a2 bwdNextND ≔ bwdNextND  ∪  {y ↦ s ↦ x}&#10;      @a3 bwdSeqNo ≔ bwdSeqNo  ∪  {y ↦ s ↦ sNo}&#10;      @a4 bwdHopCnt ≔ bwdHopCnt  ∪  {y ↦ s ↦ hCnt}&#10;      @a5 updateNbrs ≔ updateNbrs ∖ {x ↦ y}&#10;  end&#10;&#10;  event add_routeEntry2 // (ctl) add new entry into the route table&#10;    any x y s pkt sNo hCnt&#10;    where&#10;      @g1 updateNbrs ≠ ∅ // there is some nodes that have to update thier neighbour table&#10;      @g2 x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs&#10;      @g3 pkt ∈ dom(initialSrcAddr) ∧ s = initialSrcAddr(pkt) // @g4 y ↦ s   ∉ dest // in case these new pairs don't appear in the neighbour table&#10;      @g5 pkt ↦x ∈ pktFwdr&#10;      @g6 sNo = netSeqNo(pkt) ∧ y ↦ x ↦ sNo ∉ bwdSeqNo&#10;      @g7 hCnt ∈ ℕ  ∧pkt∈dom(pktNbHops) ∧ hCnt = pktNbHops(pkt) + 1 ∧ y ↦ x ↦ hCnt ∉ bwdHopCnt&#10;      @g8 ctlNeighbours = ∅&#10;      @g9 type(pkt) ≠ DATA ∧ type(pkt) ≠ RREQ&#10;    then&#10;      @a1 updateNbrs ≔ updateNbrs ∖ {x ↦ y}&#10;  end&#10;&#10;  event add_routeEntry3 // (ctl) add new entry into the route table&#10;    any x y s pkt sNo hCnt&#10;    where&#10;      @g1 updateNbrs ≠ ∅ // there is some nodes that have to update thier neighbour table&#10;      @g2 x ∈ ND ∧ y ∈ ND ∧ x ↦ y ∈ updateNbrs&#10;      @g3 pkt ∈ dom(initialSrcAddr) ∧ s = initialSrcAddr(pkt) // @g4 y ↦ s   ∉ dest // in case these new pairs don't appear in the neighbour table&#10;      @g5 pkt ↦x ∈ pktFwdr&#10;      @g6 sNo = netSeqNo(pkt) ∧ y ↦ x ↦ sNo ∉ bwdSeqNo&#10;      @g7 hCnt ∈ ℕ  ∧pkt∈dom(pktNbHops) ∧ hCnt = pktNbHops(pkt) + 1 ∧ y ↦ x ↦ hCnt ∉ bwdHopCnt&#10;      @g8 ctlNeighbours = ∅&#10;      @g9 type(pkt) ≠ DATA ∧ type(pkt) ≠ RREQ&#10;    then&#10;      @a1 updateNbrs ≔ updateNbrs ∖ {x ↦ y}&#10;  end&#10;&#10;  event actuating // (ctl) alerting emergency: sensed data is above safety threshold&#10;  extends actuating&#10;  end&#10;&#10;  event no_activating // (ctl) not alerting emergency sensed data is below safety threshold&#10;  extends no_activating&#10;  end&#10;&#10;  event reset_activatingStatus // (ctl) resetting emergency alert status&#10;  extends reset_activatingStatus&#10;  end&#10;&#10;  event finish_tx_pkt // (ctl) finishing packet transmission&#10;  extends finish_tx_pkt&#10;  end&#10;&#10;  event final_tx_pkt // (ctl) the transmitted packet is removed from middleware indicating completion of transmission mechanism&#10;  extends final_tx_pkt&#10;  end&#10;&#10;  event lose_pkt // (ctl) each node records a lost packet&#10;  extends lose_pkt&#10;  end&#10;&#10;  event clear_pkt // (ctl) clearing packet objects&#10;  extends clear_pkt&#10;  end&#10;end&#10;" version="5">
