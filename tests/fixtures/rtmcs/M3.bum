<org.eventb.core.guard name="_BBkTOSP1EeWw7avYyJIc7Q" org.eventb.core.comment="neighbour who is a sink&#10;@g9 des ∈ dom(recvedData)" org.eventb.core.label="g8" org.eventb.core.predicate="des ∈ ( ran({pkt} ◁ ctlNeighbours) )"/>
