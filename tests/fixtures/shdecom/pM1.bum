<org.eventb.core.invariant name="_niHA8Ak_EeWZ6ayKi1-Bfw" org.eventb.core.label="MPacket_inv_2" org.eventb.core.predicate="pktData ∈  PKT  ⇸ ℤ"/>
<org.eventb.core.invariant name="_niHA8Qk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MPacket_inv_3" org.eventb.core.predicate="createdPkts ⊆ PKT"/>
<org.eventb.core.invariant name="_niHA8gk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MNDBuffer_inv_1" org.eventb.core.predicate="ndBuff ∈ ND ↔PKT"/>
<org.eventb.core.invariant name="_niHA8wk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_inv_1" org.eventb.core.predicate="sentUp  ∈ ND ↔PKT"/>
<org.eventb.core.invariant name="_niHA9Ak_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_inv_2" org.eventb.core.predicate="sentDown  ∈ ND ↔PKT"/>
<org.eventb.core.invariant name="_niHA9Qk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_inv_3" org.eventb.core.predicate="ctlNeighbours ∈ PKT ↔ ND"/>
<org.eventb.core.invariant name="_niHA9gk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MDestBuffer_inv_1" org.eventb.core.predicate="destBuff ∈ Dests ↔PKT"/>
<org.eventb.core.invariant name="_niHA9wk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MReceive_inv_1" org.eventb.core.predicate="recvBuff ∈ ND ↔PKT"/>
<org.eventb.core.invariant name="_niHA-Ak_EeWZ6ayKi1-Bfw" org.eventb.core.label="MReceive_inv_2" org.eventb.core.predicate="clrRecvBuffFlg ∈ ND ↔PKT"/>
<org.eventb.core.event name="_niHA-Qk_EeWZ6ayKi1-Bfw" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="creatingPkt">
<org.eventb.core.parameter name="_niHA-gk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="x"/>
<org.eventb.core.parameter name="_niHA-wk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="des"/>
<org.eventb.core.parameter name="_niHA_Ak_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="pkt"/>
<org.eventb.core.parameter name="_niHA_Qk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="data"/>
<org.eventb.core.guard name="_niHA_gk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MPacket_creating_pkt_g1" org.eventb.core.predicate="x ∈ ND ∖Dests ∧ pkt ∈ PKT ∧ data ∈ ℤ"/>
<org.eventb.core.guard name="_niHA_wk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MPacket_creating_pkt_g2" org.eventb.core.predicate="x = initialSrcAddr(pkt) ∧  des = ran({pkt} ◁ finalDestAddr)"/>
<org.eventb.core.guard name="_niHBAAk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MPacket_creating_pkt_g3" org.eventb.core.predicate="pkt ∉ dom(pktFwdr)"/>
<org.eventb.core.guard name="_niHBAQk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MPacket_creating_pkt_g4" org.eventb.core.predicate="pkt  ∉ dom(pktData)"/>
<org.eventb.core.guard name="_niHBAgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MNDbuffMgt_record_ndBuff_g1" org.eventb.core.predicate="x  ↦ pkt ∉ ndBuff"/>
<org.eventb.core.action name="_niHBAwk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="createdPkts≔ createdPkts ∪ {pkt}" org.eventb.core.label="MPacket_creating_pkt_a1"/>
<org.eventb.core.action name="_niHBBAk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="pktFwdr ≔ pktFwdr ∪ {pkt ↦ x}" org.eventb.core.label="MPacket_creating_pkt_a2"/>
<org.eventb.core.action name="_niHBBQk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="pktData ≔ pktData ∪ {pkt ↦ data}" org.eventb.core.label="MPacket_creating_pkt_a3"/>
<org.eventb.core.action name="_niHBBgk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="ndBuff ≔ ndBuff  ∪ {x ↦ pkt}" org.eventb.core.label="MNDbuffMgt_record_ndBuff_a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_niHBBwk_EeWZ6ayKi1-Bfw" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="start_tx">
<org.eventb.core.parameter name="_niHBCAk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="x"/>
<org.eventb.core.parameter name="_niHBCQk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="pkt"/>
<org.eventb.core.guard name="_niHBCgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_start_tx_g1" org.eventb.core.predicate="x ∈ ND ∧ pkt ∈ PKT"/>
<org.eventb.core.guard name="_niHBCwk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="but has not tranmitted to WiMedium" org.eventb.core.label="MSend_start_tx_g2" org.eventb.core.predicate="x ↦ pkt ∉ sentDown"/>
<org.eventb.core.guard name="_niHBDAk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="but has not tranmitted to WiMedium" org.eventb.core.label="MSend_start_tx_g3" org.eventb.core.predicate="x ↦ pkt ∉ sentUp"/>
<org.eventb.core.guard name="_niHBDQk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MPacket_set_pktFwdr_g1" org.eventb.core.predicate="pkt ∈ dom(pktFwdr)"/>
<org.eventb.core.guard name="_niHBDgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MNDBuffer_remove_ndBuff_g1" org.eventb.core.predicate="x ↦ pkt ∈   ndBuff"/>
<org.eventb.core.action name="_niHBDwk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="sentDown ≔ sentDown  ∪  {x ↦ pkt}" org.eventb.core.label="MISend_start_tx_a1"/>
<org.eventb.core.action name="_niHBEAk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="pktFwdr ≔pktFwdr  {pkt↦x}" org.eventb.core.label="MPacket_set_pktFwdr_a2"/>
<org.eventb.core.action name="_niHBEQk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="ndBuff ≔ ndBuff ∖{x↦pkt}" org.eventb.core.label="MNDBuffer_remove_ndBuff_a1"/>
</org.eventb.core.event>
<org.eventb.core.event name="_niHBEgk_EeWZ6ayKi1-Bfw" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="send_down">
<org.eventb.core.parameter name="_niHBEwk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="x"/>
<org.eventb.core.parameter name="_niHBFAk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="pkt"/>
<org.eventb.core.guard name="_niHBFQk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_send_down_g1" org.eventb.core.predicate="x ∈ ND ∧ pkt ∈ PKT"/>
<org.eventb.core.guard name="_niHBFgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_send_down_g2" org.eventb.core.predicate="x ↦ pkt ∈ sentDown"/>
</org.eventb.core.event>
<org.eventb.core.event name="_niNHkAk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="(env) channel sends the neighbour information" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="send_up">
<org.eventb.core.parameter name="_niNHkQk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="x"/>
<org.eventb.core.parameter name="_niNHkgk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="pkt"/>
<org.eventb.core.parameter name="_niNHkwk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="nbrs"/>
<org.eventb.core.guard name="_niNHlAk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_sent_up_g1" org.eventb.core.predicate="x ∈ ND ∧ pkt ∈ PKT"/>
<org.eventb.core.guard name="_niNHlQk_EeWZ6ayKi1-Bfw" org.eventb.core.comment="ready to put current pkt from sentUp" org.eventb.core.label="MSend_sent_up_g2" org.eventb.core.predicate="x ↦ pkt  ∉ sentUp"/>
<org.eventb.core.guard name="_niNHlgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_sent_up_g3" org.eventb.core.predicate="x ↦ pkt   ∈ sentDown"/>
<org.eventb.core.guard name="_niNHlwk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_sent_up_g4" org.eventb.core.predicate="pkt ∉ dom(ctlNeighbours)"/>
<org.eventb.core.guard name="_niNHmAk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MSend_sent_up_g5" org.eventb.core.predicate="nbrs ∈ {n∣ n ∈ ℙ(ND)} ∧ nbrs ≠ ∅"/>
<org.eventb.core.action name="_niNHmQk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="ctlNeighbours ≔ ctlNeighbours ∪({pkt}× nbrs)" org.eventb.core.label="MSend_sent_up_a1"/>
<org.eventb.core.action name="_niNHmgk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="sentDown ≔ sentDown  ∖ {x ↦ pkt}" org.eventb.core.label="MSend_sent_up_a2"/>
<org.eventb.core.action name="_niNHmwk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="sentUp ≔ sentUp ∪ {x↦ pkt  }" org.eventb.core.label="MSend_sent_up_a3"/>
</org.eventb.core.event>
<org.eventb.core.event name="_niNHnAk_EeWZ6ayKi1-Bfw" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="receive">
<org.eventb.core.parameter name="_niNHnQk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="nb"/>
<org.eventb.core.parameter name="_niNHngk_EeWZ6ayKi1-Bfw" org.eventb.core.identifier="pkt"/>
