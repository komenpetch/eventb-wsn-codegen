<org.eventb.core.guard name="_xTZ5YyPBEeWw7avYyJIc7Q" org.eventb.core.label="g2" org.eventb.core.predicate="pkt ∉ ran(recLostPkts)"/>
<org.eventb.core.guard name="_xTZ5ZCPBEeWw7avYyJIc7Q" org.eventb.core.label="g3" org.eventb.core.predicate="pkt ∉ ran(ndBuff)"/>
<org.eventb.core.guard name="_xTZ5ZSPBEeWw7avYyJIc7Q" org.eventb.core.label="g4" org.eventb.core.predicate="f ↦ pkt ∈ sentUp ∧ f ↦ pkt ∉ sentDown"/>
<org.eventb.core.guard name="_xTZ5ZiPBEeWw7avYyJIc7Q" org.eventb.core.label="g5" org.eventb.core.predicate="f ↦ pkt ∉ recLostPkts"/>
<org.eventb.core.guard name="_xTZ5ZyPBEeWw7avYyJIc7Q" org.eventb.core.label="g6" org.eventb.core.predicate="ran({pkt} ◁ ctlNeighbours) = {FAILED_XMIT}"/>
<org.eventb.core.action name="_xTZ5aCPBEeWw7avYyJIc7Q" org.eventb.core.assignment="sentUp ≔ sentUp  ⩥ {pkt}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_xTZ5aSPBEeWw7avYyJIc7Q" org.eventb.core.assignment="recLostPkts ≔ recLostPkts  ∪ {f↦pkt}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_s9mQ0DYDEeWm6Z7alAd4hg" org.eventb.core.assignment="ctlNeighbours ≔ ctlNeighbours ∖ {pkt ↦ FAILED_XMIT}" org.eventb.core.label="a3"/>
</org.eventb.core.event>
