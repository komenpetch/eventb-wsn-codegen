<org.eventb.core.guard name="_yDCcVyQKEeWw7avYyJIc7Q" org.eventb.core.label="g0" org.eventb.core.predicate="pkt ∈ ran(sentUp ∪ sentDown)"/>
<org.eventb.core.guard name="_yDCcWCQKEeWw7avYyJIc7Q" org.eventb.core.label="g1" org.eventb.core.predicate="pkt  ↦ nb ∈ ctlNeighbours"/>
<org.eventb.core.guard name="_yDCcWSQKEeWw7avYyJIc7Q" org.eventb.core.comment="@g3 nb ∈ dom(recvNbrFlg) ∧ recvNbrFlg(nb) = FALSE" org.eventb.core.label="g2" org.eventb.core.predicate="nb ↦ pkt ∉   ndBuff"/>
<org.eventb.core.guard name="_yDCcWiQKEeWw7avYyJIc7Q" org.eventb.core.label="g3" org.eventb.core.predicate="nb ∉ dom(sentUp ∪ sentDown)"/>
<org.eventb.core.guard name="_yDCcWyQKEeWw7avYyJIc7Q" org.eventb.core.label="g4" org.eventb.core.predicate="s = initialSrcAddr(pkt) ∧ s ≠ nb"/>
<org.eventb.core.guard name="_yDCcXCQKEeWw7avYyJIc7Q" org.eventb.core.label="g5" org.eventb.core.predicate="pkt ∈ dom(finalDestAddr) ∧ nb ≠ finalDestAddr(pkt)"/>
<org.eventb.core.guard name="_yDCcXSQKEeWw7avYyJIc7Q" org.eventb.core.comment="not is duplicted packet&#10;@g7 type(pkt) = DATA" org.eventb.core.label="g6" org.eventb.core.predicate="nb ∈ dom(floodTbl)  ∧pkt ∉ floodTbl(nb)"/>
<org.eventb.core.guard name="_yDCcXyQKEeWw7avYyJIc7Q" org.eventb.core.label="g8" org.eventb.core.predicate="pkt ∈ dom(pktNbHops) ∧ nbh = pktNbHops(pkt) + 1"/>
<org.eventb.core.guard name="_yDCcYCQKEeWw7avYyJIc7Q" org.eventb.core.label="g9" org.eventb.core.predicate="pkt ↦ f ∈   pktFwdr"/>
<org.eventb.core.action name="_yDCcYSQKEeWw7avYyJIc7Q" org.eventb.core.assignment="ndBuff ≔ ndBuff ∪ {nb ↦pkt}" org.eventb.core.label="a1"/>
<org.eventb.core.action name="_yDCcYiQKEeWw7avYyJIc7Q" org.eventb.core.assignment="ctlNeighbours ≔ ctlNeighbours  ∖ {pkt ↦nb}" org.eventb.core.label="a2"/>
<org.eventb.core.action name="_yDCcYyQKEeWw7avYyJIc7Q" org.eventb.core.assignment="floodTbl(nb) ≔  floodTbl(nb) ∪ {pkt}" org.eventb.core.label="a3"/>
<org.eventb.core.action name="_yDCcZCQKEeWw7avYyJIc7Q" org.eventb.core.assignment="nbHops ≔  nbHops ∪  {nb ↦ {pkt ↦ nbh}}" org.eventb.core.label="a4"/>
</org.eventb.core.event>
<org.eventb.core.event name="_yDCcZSQKEeWw7avYyJIc7Q" org.eventb.core.comment="(ctl) each neighbour node discards a duplicated packet" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="receive_dup_pkt">
<org.eventb.core.refinesEvent name="_yDCcZiQKEeWw7avYyJIc7Q" org.eventb.core.target="receive_dup_pkt"/>
