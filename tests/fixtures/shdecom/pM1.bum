<org.eventb.core.guard name="_niNHsAk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MReceive_fwdr_receive_pkt_g2" org.eventb.core.predicate="nb ↦ pkt ∈ recvBuff"/>
<org.eventb.core.guard name="_niNHsQk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MReceive_fwdr_receive_pkt_g3" org.eventb.core.predicate="nb ↦ pkt ∉   clrRecvBuffFlg"/>
<org.eventb.core.guard name="_niNHsgk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MReceive_fwdr_receive_pkt_g4" org.eventb.core.predicate="nb ∉ Dests"/>
<org.eventb.core.guard name="_niNHswk_EeWZ6ayKi1-Bfw" org.eventb.core.label="MNDBuffer_record_ndBuff_g1" org.eventb.core.predicate="nb ↦ pkt ∉   ndBuff"/>
<org.eventb.core.action name="_niNHtAk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="clrRecvBuffFlg ≔ clrRecvBuffFlg ∪ {nb ↦pkt}" org.eventb.core.label="MReceive_fwdr_receive_pkt_a1"/>
<org.eventb.core.action name="_niNHtQk_EeWZ6ayKi1-Bfw" org.eventb.core.assignment="ndBuff ≔ ndBuff ∪ {nb ↦pkt}" org.eventb.core.label="MNDBuffer_record_ndBuff_a1"/>
